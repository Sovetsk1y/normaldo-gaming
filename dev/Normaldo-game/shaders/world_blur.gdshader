shader_type canvas_item;

// ── Мир не в фокусе ──────────────────────────────────────────────────────────
// Экранный слой, размывающий уже нарисованный кадр. Включается на время
// действия ПИВА — и только его: банан роняет так же, но он не про опьянение, и
// мутить от него экран значило бы сказать про него неправду.
//
// Зачем. У пива до сих пор было ровно два признака: фиолетовый оттенок героя и
// покачивание головы. Оба — на самом герое, размером с ладонь, и в куче летящих
// предметов их не видно вовсе; на слух эффект есть, на глаз его нет. Расфокус
// берёт ВЕСЬ кадр и читается сразу, ещё до того, как игрок поймёт, что именно
// подобрал.
//
// Почему экранный слой, а не материал на узлах — ровно та же причина, что у
// обесцвечивания (`world_gray.gdshader`): размыть `modulate` нельзя в принципе,
// а вешать материал на каждый предмет, героя, буквы и боссов значит помнить про
// это в каждом следующем предмете. Слой берёт кадр целиком.
uniform sampler2D screen_tex : hint_screen_texture, repeat_disable, filter_linear;

// Сила, 0…1. Ей же управляется и радиус: расфокус обязан НАРАСТАТЬ и СПАДАТЬ, а
// не включаться щелчком, иначе читается как подмена кадра, а не как состояние.
uniform float amount : hint_range(0.0, 1.0) = 0.0;

// Радиус на полной силе, в пикселях экрана. Больше — «в глазах плывёт»,
// меньше — незаметно; 5 px на кадре 960×430 это примерно ширина буквы.
uniform float radius_px : hint_range(0.0, 24.0) = 5.0;

// ── ЧЕТЫРЕ ОТСЧЁТА, А НЕ ТРИНАДЦАТЬ ──────────────────────────────────────────
// Первым заходом здесь стояла честная гауссова свёртка: крест и диагонали на
// радиусе плюс дальний крест на двойном, тринадцать выборок на пиксель. Она
// работала — и стоила ВДВОЕ ПО ВРЕМЕНИ КАДРА (замер: ×2.18 на отрисовке
// процессором, dev/shot_beer.gd). Проседание кадра во время эффекта — это не
// «атмосфера опьянения», это игра, которая начинает лагать, когда игрок ещё и
// замедлен; так эффект превращается в наказание дважды.
//
// Четыре диагональные выборки дают то же самое дешевле, и вот почему. Выборка
// идёт с БИЛИНЕЙНОЙ фильтрацией, а точка ровно между четырьмя текселями
// возвращает их среднее — одна выборка приносит четыре пикселя. Четыре такие
// точки по диагоналям накрывают шестнадцать соседей, и после смешивания с
// центром спад получается ровным, без «двойной обводки», которой боялись.
//
// Это тот же приём, что и в размытиях мобильных движков (Kawase): качество
// берут не числом выборок, а тем, ГДЕ их поставить.
void fragment() {
	vec2 r = SCREEN_PIXEL_SIZE * radius_px * amount;
	vec3 c = texture(screen_tex, SCREEN_UV).rgb;

	vec3 s = texture(screen_tex, SCREEN_UV + vec2( r.x,  r.y)).rgb;
	s     += texture(screen_tex, SCREEN_UV + vec2( r.x, -r.y)).rgb;
	s     += texture(screen_tex, SCREEN_UV + vec2(-r.x,  r.y)).rgb;
	s     += texture(screen_tex, SCREEN_UV + vec2(-r.x, -r.y)).rgb;
	// Центр весом в кольцо целиком: без него контуры не размываются, а
	// раздваиваются — четыре копии вокруг пустого места.
	s      = (s + c * 4.0) / 8.0;

	// Подмешиваем по силе, а не отдаём размытие целиком: при amount = 0 на
	// экране обязан быть ИСХОДНЫЙ кадр пиксель в пиксель. Иначе слой, забытый
	// видимым, тихо мылит игру всегда.
	COLOR = vec4(mix(c, s, amount), 1.0);
}
