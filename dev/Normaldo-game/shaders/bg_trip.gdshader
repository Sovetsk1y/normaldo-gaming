shader_type canvas_item;

// ── Порча фона ───────────────────────────────────────────────────────────────
// Два эффекта на один слой: ИНВЕРСИЯ ЦВЕТА (гриб) и ЗЕРКАЛО ПО ГОРИЗОНТАЛИ
// (компас). Оба — экранные, то есть берут уже нарисованный фон и переписывают
// его перед тем, как поверх лягут предметы.
//
// Почему экранный слой, а не трансформация узлов. Зеркалить фон поворотом
// `scale.x = -1` нельзя: сам узел Background ездит на тюинах при переходах между
// экранами меню (см. hud `_SCENE_PAN_NODES`), и две руки, пишущие в одну
// `position.x`, дерутся. А инверсию цвета трансформацией не сделать вовсе.
//
// Слой стоит ПОСЛЕДНИМ ребёнком фона, поэтому забирает весь фон целиком — и
// плитку, и город, и фонари с трубами, и те, что появятся уже во время эффекта.
// Предметы и герой рисуются ПОЗЖЕ и в него не попадают: испортить надо мир, а
// не игрока.

uniform sampler2D screen_tex : hint_screen_texture, repeat_disable, filter_nearest;
uniform float invert : hint_range(0.0, 1.0) = 0.0;
uniform float mirror : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec2 uv = SCREEN_UV;
	// mix вместо if: ветка в шейдере на каждый пиксель дороже, чем смешение,
	// а промежуточные значения тут и не нужны — уровни ставятся 0 или 1.
	uv.x = mix(uv.x, 1.0 - uv.x, mirror);
	vec3 c = texture(screen_tex, uv).rgb;
	COLOR = vec4(mix(c, vec3(1.0) - c, invert), 1.0);
}
