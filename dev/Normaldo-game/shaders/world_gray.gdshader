shader_type canvas_item;

// ── Мир в чёрно-белом ────────────────────────────────────────────────────────
// Один экранный слой, обесцвечивающий уже нарисованный кадр. Включается на
// время замедления времени (песочные часы и венец мага «Остановка времени»).
//
// Зачем вообще. Замедление — самый сильный эффект в забеге, но заметить его
// трудно: предметы просто едут медленнее, а насколько медленнее — не с чем
// сравнить, кадр-то один. Цвет уходит мгновенно и возвращается мгновенно, и
// именно он говорит «сейчас другое время», а не «у тебя лагает».
//
// Почему экранный слой, а не `modulate` по узлам. Обесцветить `modulate`
// нельзя вовсе — он умножает, а не смешивает с яркостью; пришлось бы вешать
// материал на каждый предмет, героя, буквы и босса, то есть на всё, что
// появится в будущем тоже. Экранный слой берёт кадр целиком и не знает, из чего
// он собран.
//
// Веса яркости — Rec. 709, те же, что берёт любой редактор под «обесцветить».
// Ровное среднее (0.333) даёт грязный результат: красная пицца и синяя вывеска
// клуба сходятся в один серый, и картинка разваливается на пятна.
uniform sampler2D screen_tex : hint_screen_texture, repeat_disable, filter_nearest;

// Сила эффекта, 0…1. Не «включено/выключено»: цвет уводится и возвращается
// тюином за долю секунды — резкий скачок читается как подмена кадра.
uniform float amount : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec3 c = texture(screen_tex, SCREEN_UV).rgb;
	float y = dot(c, vec3(0.2126, 0.7152, 0.0722));
	COLOR = vec4(mix(c, vec3(y), amount), 1.0);
}
