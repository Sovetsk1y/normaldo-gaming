extends Node2D

# ── Метка рывка ───────────────────────────────────────────────────────────────
# Кольцо, СЖИМАЮЩЕЕСЯ к точке за время заряда босса клуба. Оно и есть весь
# телеграф рывка: точка запомнена, и через `life` секунд в неё прилетит.
#
# Сжимающееся, а не разбегающееся, — намеренно. Разбегающееся у этого босса уже
# занято звонком (`club_boss_ring.gd`), и второе такое же читалось бы как «он
# опять кому-то звонит». Сжимающееся однозначно значит «сюда прилетит», а его
# радиус — «и вот когда»: кольцо схлопывается ровно к моменту удара, и таймер
# рисовать не нужно.
#
# Рисуется кодом, а не спрайтом: это две окружности, и заводить под них ассет
# значило бы завести ещё и его импорт с размерами.

const R0 : float = 108.0   # с чего начинает
const R1 : float = 26.0    # во что схлопывается

var life  : float = 0.6
var color : Color = Color(1.0, 0.30, 0.30)

var _t : float = 0.0

func _ready() -> void:
	z_index = 38   # под боссом (40), над предметами
	add_to_group("club_fx")

func _process(delta: float) -> void:
	_t += delta
	if _t >= life:
		queue_free()
		return
	queue_redraw()

func _draw() -> void:
	var k : float = clampf(_t / maxf(0.001, life), 0.0, 1.0)
	var r : float = lerpf(R0, R1, k)
	# Ближе к удару — ярче: к концу заряда метка обязана быть заметнее всего.
	var a : float = 0.35 + 0.5 * k
	draw_arc(Vector2.ZERO, r, 0.0, TAU, 28,
		Color(color.r, color.g, color.b, a), 3.0, true)
	# Неподвижная внутренняя мишень: по ней видно САМУ точку, когда внешнее
	# кольцо ещё далеко.
	draw_arc(Vector2.ZERO, R1 * 0.55, 0.0, TAU, 20,
		Color(color.r, color.g, color.b, a * 0.8), 2.0, true)
