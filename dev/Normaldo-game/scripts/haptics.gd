extends RefCounted

# ── Вибрация ─────────────────────────────────────────────────────────────────
# Один вход для всей игры. До этого `Input.vibrate_handheld()` звался из двух
# мест напрямую — из пачки пиццы и из бумбокса, — и обе длительности были
# выписаны числом на месте вызова. Это ровно тот случай, который в этом проекте
# уже стрелял (теги резистов, раскладка предметов, иконки перков): знание
# размазано по файлам и расходится молча.
#
# ── Почему это важнее, чем кажется ──────────────────────────────────────────
# Вибрацию можно ВЫКЛЮЧИТЬ в настройках. Выключатель, который знают не все
# вызовы, — это не выключатель, а обещание: где-то телефон всё равно дёрнется, и
# игрок будет прав, назвав это поломкой. Поэтому прямых `vibrate_handheld` в
# игре больше нет ни одного, и проверяет это тест.
#
# ── Почему статика, а не автозагрузка ───────────────────────────────────────
# Та же причина, что у `ItemFlow`: статику можно `preload`-ить где угодно, в том
# числе в скриптах, которые компилируются РАНЬШЕ автозагрузок (`--script` в
# тестах). Настройку она при этом читает у живого `SaveData` по пути в дереве, а
# не через имя автолоада, — по той же причине.
#
# ── Почему НЕТ `class_name` ─────────────────────────────────────────────────
# Глобальные имена живут в кэше классов проекта, а кэш наполняется только
# импортом. Скрипт, сославшийся на свежее `class_name` до импорта, не
# компилируется вовсе. `preload` этой ямы не знает.
#
# См. /Концепция/Экран настроек.md

# ── Словарь силы ─────────────────────────────────────────────────────────────
# Четыре ступени, и каждая отвечает за свой класс событий. Числа подобраны так,
# чтобы РАЗНИЦА читалась пальцем: 30 против 80 ощущается, 30 против 45 — нет.
#
# Больше ступеней заводить не за чем. Вибромотор телефона умеет ровно одно —
# гудеть столько-то миллисекунд, — и «тонкая настройка» на нём означала бы
# набор чисел, которые никто не различит.
const TAP   : int = 30    # мелкий отклик: тап по мешку, тап в мини-игре
const HIT   : int = 80    # по тебе попали / ты попал
const HEAVY : int = 180   # тяжёлый удар: кулак босса, взрыв, разбитая цель
const BOSS  : int = 320   # событие боя целиком: выход босса, его смерть

# Тест смотрит СЮДА, а не в телефон: на десктопе `vibrate_handheld` — пустышка,
# и «позвали ли мы вибрацию» иначе не проверить никак.
static var last_ms    : int = 0   # длительность последнего сработавшего гудка
static var count      : int = 0   # сколько раз гудели
static var suppressed : int = 0   # сколько раз промолчали из-за настройки

static func buzz(ms: int = HIT) -> void:
	if ms <= 0:
		return
	if not enabled():
		suppressed += 1
		return
	last_ms = ms
	count  += 1
	Input.vibrate_handheld(ms)

# Настройка читается У ЖИВОГО `SaveData` по пути, а не по имени автолоада:
# скрипт может быть скомпилирован раньше, чем автозагрузки поднялись.
#
# Нет `SaveData` — считаем, что вибрация ВКЛЮЧЕНА. Это не «на всякий случай»:
# единственный случай, когда его нет, — тест или очень ранний кадр загрузки, и
# молчать там значило бы прятать от теста ровно то, что он пришёл проверить.
static func enabled() -> bool:
	var loop := Engine.get_main_loop()
	if loop == null or not (loop is SceneTree):
		return true
	var sd : Node = (loop as SceneTree).root.get_node_or_null("SaveData")
	if sd == null:
		return true
	return bool(sd.get("vibration_on"))

# Для тестов: обнулить счётчики перед замером.
static func reset_probe() -> void:
	last_ms    = 0
	count      = 0
	suppressed = 0
