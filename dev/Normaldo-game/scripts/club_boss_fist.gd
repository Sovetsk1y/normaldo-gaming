extends Area2D

# ── Кулаки хозяина клуба ──────────────────────────────────────────────────────
# Ударная зона самого босса. Живёт она РОВНО ОДИН ТАКТ — тот, где он надевает
# кастеты и гонится (см. club_boss.gd → «Акт 3»). Всё остальное время он звонит,
# а не дерётся, и зоны у него нет: два акта подряд он стоит у правого края, и
# постоянный хитбокс там был бы просто стеной, в которую нельзя войти.
#
# До этого зоны не было вовсе, и последний акт получался пустым: босс ехал на
# игрока, доезжал — и проходил сквозь него без всякого урона.
#
# Отдельным узлом, а не зоной на спрайте: спрайт босса отражается по X, когда
# тот меняет направление, и форма удара переворачивалась бы вместе с рисунком.
#
# ── Откат вместо смерти ──────────────────────────────────────────────────────
# Обычный предмет после попадания ломается: `Normaldo._kill_item()` зовёт
# `on_hit()` и ждёт, что зона исчезнет. Боссу исчезать нельзя — он ещё гонится.
# Поэтому `on_hit()` тут не убивает, а ГАСИТ зону на COOLDOWN секунд.
#
# Это же и кадры неуязвимости. Без них зона, приклеившаяся к голове, снимала бы
# весь жир за долю секунды: игрок не успевал бы даже понять, обо что он умер.

signal punched          # босса «отбросило» — хозяин отыгрывает это отскоком

const COOLDOWN : float = 0.9

var damage : int = 1

var _cool : float = 0.0

func _ready() -> void:
	collision_layer = 2
	collision_mask  = 0
	add_to_group("obstacle")
	add_to_group("club_fx")

func setup(radius: float) -> void:
	var cs     := CollisionShape2D.new()
	var circle := CircleShape2D.new()
	circle.radius = radius
	cs.shape      = circle
	add_child(cs)

func _process(delta: float) -> void:
	if _cool <= 0.0:
		return
	_cool -= delta
	if _cool <= 0.0:
		set_deferred("monitorable", true)

# Попали — гасим зону на откат, а не убираем её.
func on_hit() -> void:
	if _cool > 0.0:
		return
	_cool = COOLDOWN
	set_deferred("monitorable", false)
	punched.emit()
