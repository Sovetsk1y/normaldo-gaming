class_name KnockFall
extends RefCounted

# ── Падение сбитого предмета ─────────────────────────────────────────────────
# Предмет, с которым столкнулись, не исчезает, а ПАДАЕТ: отлетает назад, кувыркается
# и уходит вниз за край. Это единственная понятная развязка столкновения — предмет,
# пропадающий в точке удара, читается как пропажа кадра, а не как последствие.
#
# Кирпич общий НАМЕРЕННО. Падение уже было написано по отдельности в `item.gd` и
# `hazard_item.gd`, и числа там совпадали случайно; стоило добавить падение
# третьему предмету, и он падал бы со своей гравитацией и своим отскоком —
# то есть выглядел бы сделанным из другого материала.
#
# Кто НЕ падает и почему:
#   • боссы и их части (нога ниндзя, кулак и вызванные хозяина клуба, крокодил) —
#     их не сбивают, с ними дерутся;
#   • снаряды (сюрикен, пуля крокодила) — они и так летят, падать им некуда;
#   • огонь — это зона, а не предмет;
#   • сейф и машина копов — у них СВОЯ развязка (вскрытие и авария), и обе
#     кончаются падением; общее падение поверх них было бы вторым концом.

# Гравитация. 900 — то же число, что стояло в обоих старых местах.
const GRAVITY    : float = 900.0
# Отскок назад: доля скорости предмета. Не ноль, чтобы сбитое не падало отвесно,
# как будто наткнулось на стену.
const VEL_X_K    : float = 0.12
# Подброс вверх — небольшой и случайный: одинаковая дуга у пяти сбитых подряд
# читается как анимация, а не как удар.
const VEL_Y_MIN  : float = -60.0
const VEL_Y_MAX  : float = -10.0
const SPIN_MAX   : float = 3.0
# Насколько ниже экрана предмет считается ушедшим.
const KILL_BELOW : float = 200.0

static func launch_velocity(speed: float) -> Vector2:
	return Vector2(-speed * VEL_X_K, randf_range(VEL_Y_MIN, VEL_Y_MAX))

static func launch_spin() -> float:
	return randf_range(-SPIN_MAX, SPIN_MAX)

# Шаг падения. Возвращает НОВУЮ скорость — GDScript не отдаёт ссылку на поле,
# поэтому вызывающий присваивает её себе сам:
#
#     _fall_vel = KnockFall.step(self, _spr, _fall_vel, _fall_spin, delta)
#
static func step(node: Node2D, spr: Node2D, vel: Vector2, spin: float,
		delta: float) -> Vector2:
	vel.y += GRAVITY * delta
	node.position += vel * delta
	if spr != null and is_instance_valid(spr):
		spr.rotation += spin * delta
	return vel

# Ушёл ли предмет вниз за край.
static func is_gone(node: Node2D) -> bool:
	return node.position.y > node.get_viewport_rect().size.y + KILL_BELOW
