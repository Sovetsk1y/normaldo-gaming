static func by_id(aid: String) -> Dictionary:
	for a in ALL:
		if String(a["id"]) == aid:
			return a
	return {}

static func in_category(key: String) -> Array:
	var out : Array = []
	for a in ALL:
		if String(a["cat"]) == key:
			out.append(a)
	return out

static func points(a: Dictionary) -> int:
	return int(TIER_POINTS[int(a["tier"])])

static func total_points() -> int:
	var n := 0
	for a in ALL:
		n += points(a)
	return n

