extends Node

# ── Покачивание живых ─────────────────────────────────────────────────────────
# Бомж, бандит, коп, шаман, девочка — это ЛЮДИ, и в потоке они летели как доски:
# ни один не шевелился. Рядом с ними ползёт змея, машет крыльями птица и пляшет
# огонь костра — на этом фоне неподвижная фигура читается не как человек, а как
# картонка с человеком.
#
# Покачивание — самый дешёвый способ это починить: лёгкий наклон туда-сюда, и
# фигура оживает, ничего не меняя ни в хитбоксе, ни в поведении.
#
# Кирпич общий НАМЕРЕННО. Своё покачивание уже было у бомжа, и заведись такое же
# у бандита и копа по отдельности — они бы качались с разной амплитудой и
# разной скоростью, то есть выглядели бы не одной породой, а тремя.
#
# ФАЗА У КАЖДОГО СВОЯ. Без неё волна бомжей качается синхронно, как строй на
# параде, — а это ровно обратное тому, зачем покачивание вводилось.

# Амплитуда в радианах: 0.05 — это ±3°. Больше уже не «дышит», а «шатается»,
# и фигура начинает читаться пьяной (для бомжа это ещё ладно, для копа нет).
const AMP   : float = 0.05
const SPEED : float = 6.0

# Случайная фаза на узел. Берётся один раз при рождении и живёт в самом узле:
# отдельный счётчик в каждом скрипте — это тот же общий код, переписанный
# столько раз, сколько у нас людей.
static func random_phase() -> float:
	return randf() * TAU

# Позвать каждый кадр. `t` — накопленное время жизни узла, `phase` — его
# собственная фаза.
static func apply(spr: Node2D, t: float, phase: float = 0.0) -> void:
	if spr == null or not is_instance_valid(spr):
		return
	spr.rotation = sin(t * SPEED + phase) * AMP
