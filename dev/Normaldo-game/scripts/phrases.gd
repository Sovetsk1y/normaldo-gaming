class_name Phrases
extends RefCounted

# ── Выкрики Нормальдо ─────────────────────────────────────────────────────────
# Короткие реплики, вылетающие над головой в двух случаях: когда сработал резист
# и когда прилетело по жиру. Оба момента и без того озвучены — вспышка, звук,
# счётчик, — но все три сообщения говорят «что произошло». Реплика говорит
# ДРУГОЕ: как к этому относится сам Нормальдо. Без неё удары и резисты одинаковы
# весь забег, а с ней каждый читается как отдельное событие.
#
# Списки лежат ЗДЕСЬ, а не в normaldo.gd, ровно по одной причине: их будут
# править не программируя. Добавить строку в таблицу должно быть можно, не
# заходя ни в какую логику, и не боясь, что от этого что-то отвалится.
#
# ⚠️ Набор ниже — РАБОЧАЯ ЗАГЛУШКА, написанная в тон игре. Авторские списки
# заменяют его целиком: правится только содержимое двух массивов, всё остальное
# (выбор, показ, цвета) от их длины и содержания не зависит.
#
# См. /Концепция/Эффекты и бонусы.md → «Выкрики»

# Резист сработал: удар был, а урона нет. Тон — торжество.
const RESIST : Array = [
	"НЕ СЕГОДНЯ",
	"МИМО КАССЫ",
	"ЧЕШУЯ!",
	"А ВОТ И НЕТ",
	"ДЕРЖУ УДАР",
	"ЩЕКОТНО",
	"ПЛОХАЯ ИДЕЯ",
	"ОТСКОК!",
	"НЕ ПРОКАТИЛО",
	"Я ЖЕ ГОВОРИЛ",
]

# Прилетело: жир снят. Тон — досада, но не нытьё.
const HIT : Array = [
	"АУ!",
	"НУ ВОТ",
	"ЭТО БЫЛО ЛИШНЕЕ",
	"МОЙ ЖИР!",
	"НЕЧЕСТНО",
	"ОЙ-ОЙ",
	"КТО ЭТО ПОСТАВИЛ",
	"Я ЭТО ЗАПОМНЮ",
	"БОЛЬНО ЖЕ",
	"ДА ЛАДНО",
]

# Последняя показанная реплика в каждой таблице. Подряд одна и та же читается как
# «игра сломалась и повторяет», а на списке из десятка строк случайный выбор
# повторяется чаще, чем кажется: шанс совпадения у соседних показов — каждый
# десятый, то есть несколько раз за забег.
static var _last : Dictionary = {}

# Случайная реплика из таблицы, но НЕ та же, что в прошлый раз.
static func pick(key: String, pool: Array) -> String:
	if pool.is_empty():
		return ""
	if pool.size() == 1:
		return String(pool[0])
	var prev : String = String(_last.get(key, ""))
	var idx : int = randi() % pool.size()
	if String(pool[idx]) == prev:
		idx = (idx + 1 + randi() % (pool.size() - 1)) % pool.size()
	_last[key] = String(pool[idx])
	return String(pool[idx])

static func resist() -> String:
	return pick("resist", RESIST)

static func hit() -> String:
	return pick("hit", HIT)
