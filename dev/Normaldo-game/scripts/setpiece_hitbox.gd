extends Area2D

# ── Ударная зона сет-писа ─────────────────────────────────────────────────────
# Своего поведения у неё нет: она не летит, не анимируется и не решает, где ей
# быть, — её каждый кадр возит за собой хозяин (см. bum_barrel.gd). Всё, что она
# умеет, — БИТЬ и СЛОМАТЬСЯ.
#
# Отдельным узлом, а не хитбоксом на спрайте, ровно по одной причине: спрайты
# сет-писа масштабируются и вращаются — бочка заваливается набок, — и форма удара
# ездила бы вместе с рисунком, переворачиваясь вместе с ним.
#
# Ломается при этом ВСЯ СЦЕНА, а не одна зона. Спелл, попавший в бомжа, обязан
# что-то сделать: зона, которая молча переживает попадание, читается как «спелл
# не сработал». Поэтому она только сообщает о попадании, а решает хозяин.

signal broken

var damage : int = 1

func on_hit() -> void:
	broken.emit()
