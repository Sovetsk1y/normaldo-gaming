extends RefCounted

# ── Тряска экрана ────────────────────────────────────────────────────────────
# Три босса — крокодил, ниндзя и хозяин клуба — держали эту функцию у себя, и
# все три тела совпадали ПОБАЙТОВО. Тот же случай, что был у тегов резистов и у
# раскладки предметов: одно знание в трёх файлах расходится молча, и заметить
# это можно только глазами, сравнив три боя подряд.
#
# ── Почему сюда же попала вибрация ──────────────────────────────────────────
# Тряска и вибрация — это ОДНО событие, показанное двумя органами чувств:
# «сейчас ударило». Разведи их по разным спискам вызовов — и списки разойдутся:
# добавили боссу новый удар, потрясли экран, а телефон промолчал. Живя в одной
# функции, они не расходятся вовсе: каждая тряска в игре ощущается, и добавить
# тряску без отклика физически негде.
#
# Сила выводится ИЗ АМПЛИТУДЫ, а не задаётся отдельным аргументом. Амплитуда уже
# сказана в каждом вызове, и она ровно про то же самое — насколько сильно
# ударило. Второй аргумент про то же самое означал бы два числа, которые надо
# держать согласованными руками.
#
# См. scripts/haptics.gd, /Концепция/Экран настроек.md

const HAPTICS := preload("res://scripts/haptics.gd")

# Пороги амплитуды. Ступеней ровно столько, сколько различает вибромотор
# телефона (см. словарь силы в haptics.gd), — дробить мельче нечем.
const AMP_HEAVY : float = 10.0   # выход босса, тяжёлый удар, смерть
const AMP_HIT   : float = 6.0    # обычный удар

static func strength(amp: float) -> int:
	if amp >= AMP_HEAVY:
		return HAPTICS.HEAVY
	if amp >= AMP_HIT:
		return HAPTICS.HIT
	return HAPTICS.TAP

# `root` — узел, который трясём (у боссов это корень сцены забега). Пустой или
# уже освобождённый — молча выходим: бой мог кончиться между вызовом и кадром.
static func play(root: Node2D, amp: float, count: int) -> void:
	if root == null or not is_instance_valid(root):
		return
	var tw := root.create_tween()
	var a  := amp
	for _i in count:
		tw.tween_property(root, "position",
			Vector2(randf_range(-a, a), randf_range(-a * 0.65, a * 0.65)), 0.033)
		a *= 0.80
	tw.tween_property(root, "position", Vector2.ZERO, 0.05)
	HAPTICS.buzz(strength(amp))
