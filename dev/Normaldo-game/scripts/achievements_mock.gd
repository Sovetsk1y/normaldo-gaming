class_name AchievementsMock
extends RefCounted

# ── Фальшивый прогресс достижений ────────────────────────────────────────────
# ВРЕМЕННЫЙ ФАЙЛ. Экран достижений собран раньше машинерии счётчиков, и числа на
# нём берутся отсюда. Когда появится настоящий `AchievementManager`, экран
# переключится на него тремя строками, а этот файл удаляется целиком — он для
# того и вынесен отдельно, чтобы не выковыривать моки из экрана по кусочкам.
#
# ── Кубик бросается на СЧЁТЧИК, а не на достижение ───────────────────────────
# Сначала было наоборот, и экран сразу показал, почему так нельзя: «Пройди всю
# кампанию» стояло взятым, а «Пройди эпизод 3» под ним — нет. Достижения одной
# лестницы независимыми не бывают, и мок, который этого не знает, выдаёт
# картинку, которую нельзя обсуждать: непонятно, кривой список или кривой мок.
#
# Поэтому значение выбирается ОДНО НА СЧЁТЧИК, а «взято» из него уже следует:
# `counter >= goal`. Так же это будет работать и с настоящими счётчиками —
# то есть мок врёт про числа, но не про устройство.
#
# ── Почему прогресс ДЕТЕРМИНИРОВАННЫЙ ────────────────────────────────────────
# Числа считаются от имени счётчика, а не рандомом. Экран показывают, обсуждают
# и снимают кадрами, и список, меняющийся при каждом открытии, обсуждать нельзя:
# «вот тут полоска некрасивая» — а на следующем заходе там уже другое. Заодно
# кадры `dev/shot_awards.gd` воспроизводимы и сравнимы между собой.
#
# ── Почему прогресс НЕРОВНЫЙ ─────────────────────────────────────────────────
# Проще всего было бы выдать всем половину, но такой экран врёт про самого себя:
# он не покажет ни как выглядит взятое рядом с невзятым, ни как читается длинная
# лестница, у которой взяты две ступени из четырёх, ни что происходит со
# скрытым. Поэтому раскладка перекошена по весу: бронза почти вся взята,
# платина почти вся нет — примерно так и выглядит живой игрок через месяц.
#
# См. /Концепция/Достижения.md

# Вероятность взять ПЕРВУЮ ступень счётчика, по весу этой ступени.
const TAKEN_BY_TIER : Array = [0.0, 0.88, 0.62, 0.30, 0.10]
# Во сколько раз труднее каждая следующая ступень той же лестницы.
const STEP_FALLOFF : float = 0.55

# Значение на счётчик, считается один раз. Ключ — имя счётчика.
static var _values : Dictionary = {}

# Числовое зерно из строки. FNV-1a: короткий, устойчивый и одинаковый на всех
# платформах, в отличие от `hash()`, про который такого обещания нет.
static func _seed(s: String) -> int:
	var h : int = 2166136261
	for b in s.to_utf8_buffer():
		h = (h ^ int(b)) * 16777619
		h = h & 0xFFFFFFFF
	return h

static func _rnd(key: String, salt: String) -> float:
	return float(_seed(key + "/" + salt) % 100000) / 100000.0

# Все достижения, висящие на одном счётчике, по возрастанию порога. Это и есть
# ступени: лестница из спеки — их человекочитаемое имя, а счётчик — устройство.
static func _rungs(stat: String) -> Array:
	var out : Array = []
	for a in Achievements.ALL:
		if String(a["stat"]) == stat:
			out.append(a)
	out.sort_custom(func(x, y): return int(x["goal"]) < int(y["goal"]))
	return out

# ── Значение счётчика ────────────────────────────────────────────────────────
# Одно число на счётчик, из него следует всё остальное.
#
# Сколько ступеней взято, решает один бросок: ступень проходится, если бросок
# меньше её вероятности, а вероятности по лестнице УБЫВАЮТ. Отсюда само собой
# получается главное свойство — взятые ступени всегда идут подряд с начала.
# Лестница, у которой взята третья ступень при непройденной второй, читается как
# поломка, и никаким кубиком её быть не должно.
static func value(stat: String) -> int:
	if _values.has(stat):
		return int(_values[stat])
	var rungs : Array = _rungs(stat)
	if rungs.is_empty():
		_values[stat] = 0
		return 0

	var r : float = _rnd(stat, "value")
	var p : float = 1.0
	var taken : int = 0
	for i in rungs.size():
		var tier : int = int(rungs[i]["tier"])
		# Скрытые берутся вдвое реже: их смысл в том, чтобы большинство
		# оставалось закрытым.
		var pi : float = float(TAKEN_BY_TIER[tier]) * pow(STEP_FALLOFF, float(i))
		if bool(rungs[i].get("hidden", false)):
			pi *= 0.5
		# Убывание вероятностей — не предположение, а требование: вес по
		# лестнице обычно растёт, но «обычно» здесь мало.
		p = minf(p, pi)
		if r >= p:
			break
		taken = i + 1

	var v : int = 0
	if taken == 0:
		# Ничего не взято — но игрок мог уже начать. Треть таких счётчиков
		# нетронуты: полоска в ноль читается иначе, чем полоска на четверть, и
		# увидеть надо обе.
		var f : float = _rnd(stat, "part")
		if f >= 0.34:
			v = int(float(int(rungs[0]["goal"])) * (f - 0.34) / 0.66 * 0.92)
	else:
		var last : int = int(rungs[taken - 1]["goal"])
		if taken < rungs.size():
			# Между взятой ступенью и следующей — живой игрок не замирает ровно
			# на пороге.
			var nxt : int = int(rungs[taken]["goal"])
			v = last + int(float(nxt - last) * _rnd(stat, "over") * 0.8)
		else:
			v = last + int(float(last) * _rnd(stat, "over") * 0.4)
	_values[stat] = v
	return v

# ── Счётчики, зависящие друг от друга ────────────────────────────────────────
# Не всякие два счётчика независимы, и врать об этом экрану нельзя: первый же
# кадр показал «пройди всю кампанию» взятым при третьем эпизоде на 2 из 3.
# Формально дыры нет — это разные счётчики, — а читается как поломка.
#
# Правила ниже поднимают зависимый счётчик до того, что следует из ведущего.
# Правило читается как «ведущий дошёл до порога — значит зависимый не меньше
# своего значения». В настоящей игре это будет обеспечено самими событиями;
# здесь — руками, потому что событий ещё нет.
const DERIVED : Array = [
	# кампания пройдена ровно тогда, когда пройден третий эпизод
	{ "from": "episodes_done",   "at": 3, "to": "campaign_done",   "min": 1 },
	# до босса дошёл всякий, кто закрыл хоть один эпизод
	{ "from": "episodes_done",   "at": 1, "to": "boss_reached",    "min": 1 },
	{ "from": "episodes_done",   "at": 1, "to": "bosses_beaten",   "min": 1 },
	# скин, дошедший до десятого уровня, поднимает и «лучший уровень»
	{ "from": "skins_at_10",     "at": 1, "to": "skin_lvl_max",    "min": 10 },
	# время в бесконечном набирается только в бесконечных забегах
	{ "from": "endless_best",    "at": 1, "to": "endless_runs",    "min": 1 },
	# в СУПЕР ХАРДЕ нельзя продержаться, до него не дойдя
	{ "from": "hardcore_best",   "at": 1, "to": "hardcore_reached", "min": 1 },
	# спелл применяли все, у кого есть попадания спеллом
	{ "from": "spell_hits:viking",     "at": 1, "to": "spell_casts", "min": 100 },
	{ "from": "spell_hits:spider_man", "at": 1, "to": "spell_casts", "min": 100 },
]

# Потолки: зависимый не может обогнать ведущего.
const CAPPED : Array = [
	# эпизодов без урона не бывает больше, чем пройденных эпизодов
	{ "of": "nodmg_episodes", "by": "episodes_done" },
]

static var _derived : Dictionary = {}

static func stat_value(stat: String) -> int:
	if _derived.has(stat):
		return int(_derived[stat])
	var v : int = value(stat)
	for r in DERIVED:
		if String(r["to"]) == stat and value(String(r["from"])) >= int(r["at"]):
			v = maxi(v, int(r["min"]))
	for c in CAPPED:
		if String(c["of"]) == stat:
			v = mini(v, value(String(c["by"])))
	_derived[stat] = v
	return v

static func counter(a: Dictionary) -> int:
	return stat_value(String(a["stat"]))

static func is_done(a: Dictionary) -> bool:
	return counter(a) >= int(a["goal"])


# Доля выполнения 0..1 — ровно то, что уйдёт в Game Center percentComplete.
static func progress(a: Dictionary) -> float:
	var goal : int = maxi(1, int(a["goal"]))
	return clampf(float(counter(a)) / float(goal), 0.0, 1.0)

# ── Сводка ───────────────────────────────────────────────────────────────────
# Считается по той же таблице, что и строки: расхождение шапки со списком —
# первое, что бросается в глаза на таком экране.
static func summary() -> Dictionary:
	var done := 0
	var pts := 0
	var pts_all := 0
	for a in Achievements.ALL:
		var p : int = Achievements.points(a)
		pts_all += p
		if is_done(a):
			done += 1
			pts += p
	return {
		"done":       done,
		"total":      Achievements.ALL.size(),
		"points":     pts,
		"points_all": pts_all,
	}

static func category_done(key: String) -> int:
	var n := 0
	for a in Achievements.in_category(key):
		if is_done(a):
			n += 1
	return n
