class_name ItemFlow
extends RefCounted

# ── Направление потока ────────────────────────────────────────────────────────
# Предметы всю игру летели ВЛЕВО, и каждый из двадцати трёх скриптов писал это
# сам: `position.x -= speed * delta`, а следом своя отсечка `position.x < -200`.
# Двадцать три копии одного знания — ровно то, что в этом проекте уже стреляло
# (теги резистов, картинки статусов, раскладка предметов): расходятся молча.
#
# Понадобилось это, когда компас перестал переворачивать управление и стал
# ЗЕРКАЛИТЬ ПОТОК. Требование там такое: развернуть не только новые предметы, но
# и те, что уже летят. С общим знаком это выходит САМО — считать никого не надо,
# все двадцать три читают одно число. С двадцатью тремя копиями пришлось бы
# обходить дерево и звать каждому свой метод, а предметы, которые про это не
# знают, продолжали бы лететь по-старому.
#
# ── Почему статика, а не автозагрузка ────────────────────────────────────────
# Зовётся из `_process` каждого летящего предмета — то есть десятки раз за кадр.
# Статика обходится без поиска узла в дереве. И, что важнее, статику можно
# `preload`-ить в тестах: скрипт SceneTree компилируется РАНЬШЕ, чем автозагрузки
# попадают в область видимости, и автозагрузку оттуда не достать.
#
# См. /Концепция/Предметы.md, scripts/compass_item.gd

const LEFT  : int = -1   # как всегда: справа налево
const RIGHT : int = 1    # компас: слева направо

# Знак ОБЩИЙ на весь поток. Забег его сбрасывает (см. `reset`), иначе компас,
# сработавший в прошлом забеге, встретил бы игрока в начале следующего.
static var dir : int = LEFT

static func reset() -> void:
	dir = LEFT

static func mirrored() -> bool:
	return dir == RIGHT

# Сдвиг за кадр. Один вызов вместо `position.x -= speed * delta`.
static func advance(n: Node2D, speed: float, delta: float) -> void:
	n.position.x += speed * delta * float(dir)

# Улетел ли предмет за край. Сторона зависит от направления: при зеркале
# отсечка «левее −200» не сработает никогда, и предметы копились бы за правым
# краем до конца забега.
static func gone(n: Node2D, margin: float = 200.0) -> bool:
	if dir == RIGHT:
		return n.position.x > n.get_viewport_rect().size.x + margin
	return n.position.x < -margin

# Откуда предмет вылетает. `off` — отступ за краем экрана, тот же, что и был.
static func spawn_x(vp_w: float, off: float) -> float:
	return -off if dir == RIGHT else vp_w + off
