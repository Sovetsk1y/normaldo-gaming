extends Node

# ── ЯЗЫК ИГРЫ ────────────────────────────────────────────────────────────────
# Два языка: русский и английский. Русский — исходный.
#
# ── РУССКИЙ ТЕКСТ В КОДЕ И ЕСТЬ КЛЮЧ ПЕРЕВОДА ───────────────────────────────
# В игре полторы тысячи надписей, и все они написаны по-русски прямо в местах,
# где собирается интерфейс. Заводить под каждую отдельный ключ («MENU_PLAY»)
# значило бы переписать полторы тысячи мест и получить код, по которому больше
# нельзя прочитать, что окажется на экране.
#
# Поэтому ключом служит сама русская строка, а таблица переводит её в
# английскую (`scripts/loc_en.gd`). Ни одно место сборки интерфейса при этом не
# правится вовсе: Godot переводит текст у Label и Button САМ, читая его через
# TranslationServer при отрисовке (`Control.auto_translate`).
#
# Цена этого — надпись, поправленную в коде, надо поправить и в таблице, иначе
# перевод молча отвалится к русскому. За этим следит dev/smoke_i18n.gd: он
# сверяет таблицу с исходниками и падает на разошедшихся строках.
#
# ── ЧЕГО ПЕРЕВОД НЕ БЕРЁТ САМ ───────────────────────────────────────────────
# Два случая, и оба надо звать руками через `tr()`:
#   1. текст, нарисованный вручную (`draw_string` в fat_gauge.gd и
#      skill_badges.gd) — он не проходит через Control;
#   2. строки, собранные подстановкой: «УРОВЕНЬ %d · %s» после `%` превращается
#      в «УРОВЕНЬ 2 · ДВОР», и такого ключа в таблице нет. Переводить надо
#      ЗАГОТОВКУ, до подстановки.
#
# ── ЗАПАСНАЯ ЛОКАЛЬ — РУССКАЯ ───────────────────────────────────────────────
# `internationalization/locale/fallback` в project.godot стоит «ru», и это не
# вкусовщина. По умолчанию там «en», а русской таблицы у нас нет вовсе (она и
# не нужна — ключ и есть русский текст). Сервер, не найдя таблицы на ru, уходил
# в запасную и отдавал АНГЛИЙСКИЙ русским игрокам. Ровно это и происходило,
# пока настройка не была выставлена.

signal changed

const SUPPORTED : Array = ["ru", "en"]

# Как язык называется на самом себе. Список языков, подписанный на чужом языке,
# читает тот, кто этого языка и не знает.
const NAMES : Dictionary = {
	"ru": "Русский",
	"en": "English",
}

const EN := preload("res://scripts/loc_en.gd")

var _en_loaded : bool = false

func _ready() -> void:
	# После SaveData: он объявлен выше в списке автозагрузок и к этому моменту
	# уже прочитал сохранение, так что выбранный язык виден.
	apply()

# ── КАКОЙ ЯЗЫК ПОКАЗЫВАТЬ ───────────────────────────────────────────────────
# Явный выбор игрока (SaveData.language) сильнее всего и держится навсегда.
# Пока выбора не было — берём у телефона.
func current() -> String:
	var saved := String(SaveData.language)
	if SUPPORTED.has(saved):
		return saved
	return device_default()

# ЯЗЫК ТЕЛЕФОНА. Русский — только если телефон русский; во всех остальных
# случаях английский. Обратное правило («русский по умолчанию») означало бы, что
# игрок из любой другой страны видит незнакомый алфавит и не понимает даже, где
# переключить.
#
# Сравнивается НАЧАЛО кода: система отдаёт «ru_RU», «ru-RU», «en_US», «be_BY».
func device_default() -> String:
	var loc := OS.get_locale().to_lower().replace("-", "_")
	return "ru" if loc.begins_with("ru") else "en"

func set_language(code: String) -> void:
	if not SUPPORTED.has(code) or String(SaveData.language) == code:
		return
	SaveData.language = code
	SaveData._save()
	apply()
	# ── УВЕДОМЛЕНИЯ ПЕРЕСОБИРАЮТСЯ ЗАНОВО ──────────────────────────────────
	# Пуши не переводятся при показе: текст вшивается в них В МОМЕНТ ПОСТАНОВКИ
	# В ОЧЕРЕДЬ и уходит в систему как есть. Уже назначенные так и всплыли бы
	# на старом языке — через день, через неделю, когда игрок давно забыл, что
	# что-то переключал.
	var planner := get_tree().root.get_node_or_null("NotifPlanner")
	if planner != null:
		planner.call("replan_all")
	# ── И СЕРВЕР ТОЖЕ ДОЛЖЕН УЗНАТЬ ────────────────────────────────────────
	# Часть пушей приходит НЕ отсюда: обгон в таблице лидеров и итоги недели
	# собираются на сервере, и перевод в игре до них не достаёт. Язык сервер
	# берёт из регистрации токена — значит её надо повторить, иначе следующий
	# пуш придёт на прежнем языке.
	var notif := get_tree().root.get_node_or_null("Notifications")
	if notif != null and notif.has_method("resend_push_registration"):
		notif.call("resend_push_registration")
	changed.emit()

func apply() -> void:
	_load_en()
	TranslationServer.set_locale(current())

# Таблица заводится ОДИН РАЗ и остаётся в сервере: переключение языка потом —
# это смена локали, а не пересборка словаря.
func _load_en() -> void:
	if _en_loaded:
		return
	_en_loaded = true
	var t := Translation.new()
	t.locale = "en"
	for key in EN.STRINGS:
		t.add_message(String(key), String(EN.STRINGS[key]))
	TranslationServer.add_translation(t)
