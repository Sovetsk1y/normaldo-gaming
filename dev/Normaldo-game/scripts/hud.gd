	add_child(rst_bg)

	var rst_lbl := Label.new()
	rst_lbl.add_theme_font_override("font", UI_FONT)
	rst_lbl.add_theme_font_size_override("font_size", 9)
	rst_lbl.text                 = "СБРОС УР."
	rst_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	rst_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	rst_lbl.modulate             = Color(1.00, 0.45, 0.45)
	rst_lbl.size                 = Vector2(xp_btn_w, xp_btn_h)
	rst_lbl.position             = Vector2(xp_btn_x, xp_btn_y)
	rst_lbl.process_mode         = _pm
	add_child(rst_lbl)

	var rst_btn := Button.new()
	rst_btn.flat         = true
	rst_btn.focus_mode = Control.FOCUS_NONE
	rst_btn.size         = Vector2(xp_btn_w, xp_btn_h)
	rst_btn.position     = Vector2(xp_btn_x, xp_btn_y)
	rst_btn.process_mode = _pm
	rst_btn.pressed.connect(func():
		if _go_anim_busy:
			return
		_play_btn_sfx()
		SaveData.reset_skin_progress()
		_go_level_lbl.text = "ур.2"
		_update_xp_sub_label(0, 1)
		if _go_fill_rect and is_instance_valid(_go_fill_rect):
			_go_fill_rect.size.x    = 2.0
			_go_shimmer_rect.size.x = 2.0
