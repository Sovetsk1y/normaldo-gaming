		ubg.size         = Vector2(PW - 16.0, ROW_H + 18.0)
		ubg.position     = Vector2(px + 8.0, cy)
		ubg.mouse_filter = Control.MOUSE_FILTER_PASS
		popup_root.add_child(ubg)

		var ust := ColorRect.new()
		ust.color        = Color(rc.r, rc.g, rc.b, 0.70)
		ust.size         = Vector2(3.0, ROW_H + 18.0)
		ust.position     = Vector2(px + 8.0, cy)
		ust.mouse_filter = Control.MOUSE_FILTER_PASS
		popup_root.add_child(ust)

		var sstar := Label.new()
		sstar.add_theme_font_override("font", UI_FONT)
		sstar.add_theme_font_size_override("font_size", 11)
		_apply_menu_caption_fx(sstar)
		sstar.text               = "★"
		sstar.modulate           = Color(rc.r, rc.g, rc.b)
		sstar.size               = Vector2(20.0, ROW_H + 18.0)
		sstar.position           = Vector2(px + 14.0, cy)
