# Shared mover for the scene side of the camera pan. dy=-vp.y to pan UP (open);
# dy=+vp.y to pan DOWN (close). Handles three special cases:
#   • Normaldo — physics_process clamps his position back to the viewport rect
#     every frame, so we disable physics for the duration of the tween and
#     turn it back on at the end of the close-anim.
#   • Tv — has top_level=true and reasserts its position via `_locked_position`
#     every frame, so we tween THAT value instead of `position`.
#   • Background / Couch / Spawner — plain Node2D `position` tweens.
func _pan_scene_nodes(tw: Tween, dy: float, duration: float, trans: int, ease_kind: int, is_open: bool) -> void:
	var parent := get_parent()
	if parent == null:
		return
	for nm in _SCENE_PAN_NODES:
		var n := parent.get_node_or_null(nm) as Node2D
		if n == null:
			continue
		tw.tween_property(n, "position", n.position + Vector2(0.0, dy), duration)\
			.set_trans(trans).set_ease(ease_kind)

	var tv := parent.get_node_or_null("Tv")
	if tv != null:
		var locked = tv.get("_locked_position")
		if locked != null:
			tw.tween_property(tv, "_locked_position", (locked as Vector2) + Vector2(0.0, dy), duration)\
				.set_trans(trans).set_ease(ease_kind)

	var normaldo := parent.get_node_or_null("Normaldo")
	if normaldo != null:
		if is_open:
			# Suspend physics so the viewport clamp in _physics_process doesn't
			# fight our tween. Re-enabled at the end of the close pan.
			normaldo.set_physics_process(false)
		tw.tween_property(normaldo, "position", normaldo.position + Vector2(0.0, dy), duration)\
			.set_trans(trans).set_ease(ease_kind)
		if not is_open:
			# Use a sequential follow-up tween: wait `duration`, then resume.
			var resume_tw := create_tween()
			resume_tw.tween_interval(duration)
			resume_tw.tween_callback(func():
				if is_instance_valid(normaldo):
					normaldo.set_physics_process(true))

