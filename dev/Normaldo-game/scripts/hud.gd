	add_child(rst_btn)

func _xp_progress_at(xp: int, level: int) -> float:
	if level >= 10:
		var over := xp - SaveData.LEVEL_XP[9]
		return float(over % SaveData.MASTERY_XP_PER_TOKEN) / float(SaveData.MASTERY_XP_PER_TOKEN)
	var from_xp = SaveData.LEVEL_XP[level - 1]
	var to_xp   = SaveData.LEVEL_XP[level]
	return clampf(float(xp - from_xp) / float(to_xp - from_xp), 0.0, 1.0)

func _update_xp_sub_label(xp: int, level: int) -> void:
	if not _go_xp_sub_lbl or not is_instance_valid(_go_xp_sub_lbl):
		return
	if level >= 10:
		var over     := xp - SaveData.LEVEL_XP[9]
		var in_cycle := over % SaveData.MASTERY_XP_PER_TOKEN
		_go_xp_sub_lbl.text = "%d / %d XP" % [in_cycle, SaveData.MASTERY_XP_PER_TOKEN]
	else:
		var from_xp : int = SaveData.LEVEL_XP[level - 1]
		var to_xp   : int = SaveData.LEVEL_XP[level]
		# clamp: при рассинхроне уровня и опыта (дев-сброс, правка сейва) разница
		# уходила в минус, и на экране печаталось «-6789 / 8400 XP».
		var have : int = clampi(xp - from_xp, 0, to_xp - from_xp)
		_go_xp_sub_lbl.text = "%d / %d XP" % [have, to_xp - from_xp]

# Sprays N dollar icons from the "+%d $" row toward the "Мой баланс" label
# and bumps the visible balance value each time one lands — mirrors the
# pizza→XP fly so the cash earned in the run feels deposited, not granted.
func _spawn_dollar_fly_to_balance(amount: int) -> void:
	if amount <= 0:
		return
	var icons : int = clampi(amount / 8 + 4, 4, 14)
	# Per-icon balance delta — distributed so the final tick lands on the
	# exact target value even if the per-icon math doesn't divide evenly.
	var per_icon : int = maxi(1, amount / icons)
	var distributed : int = 0
	for i in icons:
		var delta : int
		if i == icons - 1:
			delta = amount - distributed
		else:
			delta = per_icon
		distributed += delta
		var fly := _make_icon(DOLLAR_TEXTURE, 14.0)
		fly.position     = _go_dollar_spawn_pos + Vector2(randf_range(-12, 12), randf_range(-6, 6))
		fly.process_mode = Node.PROCESS_MODE_ALWAYS
		fly.z_index      = 10
		add_child(fly)
		var delay : float = float(i) * 0.06
		var tw    := create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		tw.tween_interval(delay)
		tw.tween_property(fly, "position", _go_balance_anchor, 0.40)\
			.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN)
		tw.parallel().tween_property(fly, "modulate:a", 0.0, 0.18).set_delay(0.28)
		var captured_delta := delta
		tw.tween_callback(func():
			_go_balance_value += captured_delta
			if is_instance_valid(_go_balance_lbl):
				_go_balance_lbl.text = "%d $" % _go_balance_value
				var pulse := create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
				pulse.tween_property(_go_balance_lbl, "scale", Vector2(1.10, 1.10), 0.08)
				pulse.tween_property(_go_balance_lbl, "scale", Vector2.ONE,          0.12)
		)
		tw.tween_callback(fly.queue_free)

func _spawn_pizza_fly() -> void:
	var count := mini(5, 3)
	for i in count:
		var fly := _make_icon(PIZZA_TEXTURE, 16.0)
		fly.position     = _go_pizza_spawn_pos + Vector2(randf_range(-20, 20), randf_range(-8, 8))
		fly.process_mode = Node.PROCESS_MODE_ALWAYS
		fly.z_index      = 10
		add_child(fly)
		var target := _go_bar_screen_pos + Vector2(_go_bar_w * 0.4, 6.0)
		var delay  := float(i) * 0.08
		var tw     := create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		tw.tween_interval(delay)
		tw.tween_property(fly, "position", target, 0.42).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN)
		tw.parallel().tween_property(fly, "modulate:a", 0.0, 0.18).set_delay(0.30)
		tw.tween_callback(fly.queue_free)

# Анимации экрана смерти асинхронные, а «ЕЩЁ РАЗ» и «ВЫХОД» под ними
# перезагружают сцену. reload_current_scene() вынимает сцену из дерева СРАЗУ, а
# удаляет только на следующем кадре: корутина, проснувшаяся в этом окне, видит
# валидный, но уже отцепленный HUD — и create_tween() возвращает ей null.
# is_instance_valid() тут не спасает, проверять надо дерево.
func _go_anim_alive() -> bool:
	return is_inside_tree()

func _fill_xp_segment(from_p: float, to_p: float) -> void:
	if not _go_fill_rect or not is_instance_valid(_go_fill_rect):
		return
	_go_fill_rect.size.x    = maxf(2.0, from_p * _go_bar_w)
	_go_shimmer_rect.size.x = maxf(2.0, from_p * _go_bar_w)
	var duration := clampf((to_p - from_p) * 2.2, 0.20, 2.8)
	var tw := create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw.tween_property(_go_fill_rect,    "size:x", maxf(2.0, to_p * _go_bar_w), duration) \
		.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tw.parallel().tween_property(_go_shimmer_rect, "size:x", maxf(2.0, to_p * _go_bar_w), duration)
	var pulse_tw := create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_loops(99)
	pulse_tw.tween_property(_go_fill_rect, "color", Color(0.48, 0.82, 1.0), 0.22)
	pulse_tw.tween_property(_go_fill_rect, "color", Color(0.18, 0.52, 0.95), 0.22)
	await tw.finished
	pulse_tw.kill()
	if _go_fill_rect and is_instance_valid(_go_fill_rect):
		_go_fill_rect.color = Color(0.22, 0.58, 1.0)

func _flash_level_up_bar(new_level: int, reward_d: int, reward_t: int) -> void:
	if not _go_fill_rect or not is_instance_valid(_go_fill_rect):
		return
	var tw_fill := create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw_fill.tween_property(_go_fill_rect,    "size:x", _go_bar_w, 0.18)
	tw_fill.parallel().tween_property(_go_shimmer_rect, "size:x", _go_bar_w, 0.18)
	await tw_fill.finished
	if not _go_anim_alive():
		return
	var tw_flash := create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw_flash.tween_property(_go_fill_rect, "color", Color(1.0, 0.85, 0.20), 0.12)
	tw_flash.tween_property(_go_fill_rect, "color", Color(0.22, 0.58, 1.0), 0.30)
	if _go_level_lbl and is_instance_valid(_go_level_lbl):
		_go_level_lbl.text = "★" if new_level >= 10 else "ур.%d" % mini(new_level + 1, 10)
	# Level-up dollar reward → bump the running "Мой баланс" so the final
	# value still matches SaveData.dollars by the end of the animation.
	if reward_d > 0 and is_instance_valid(_go_balance_lbl):
		_go_balance_value += reward_d
		_go_balance_lbl.text = "%d $" % _go_balance_value
	_spawn_fireworks()
	await _show_level_reward_popup(new_level, reward_d, reward_t)

func _spawn_fireworks() -> void:
	var vp := get_viewport().get_visible_rect().size
	var bursts := [
		[0.07, 0.38, 0.00, Color(1.00, 0.92, 0.28), Color(1.00, 0.55, 0.10)],
		[0.93, 0.38, 0.00, Color(0.28, 0.90, 0.40), Color(0.10, 0.60, 0.28)],
		[0.04, 0.62, 0.38, Color(0.28, 0.62, 1.00), Color(0.80, 0.30, 1.00)],
		[0.96, 0.62, 0.38, Color(1.00, 0.30, 0.35), Color(1.00, 0.78, 0.15)],
		[0.09, 0.50, 0.72, Color(1.00, 0.92, 0.28), Color(0.28, 1.00, 0.55)],
		[0.91, 0.50, 0.72, Color(0.28, 0.85, 0.28), Color(0.28, 0.62, 1.00)],
	]
	for cfg in bursts:
		var bx : float = cfg[0]; var by : float = cfg[1]; var delay: float = cfg[2]
		var c1 : Color = cfg[3]; var c2 : Color  = cfg[4]
		get_tree().create_timer(delay, true).timeout.connect(func():
			if not is_instance_valid(self):
				return
			var p                    := CPUParticles2D.new()
			p.one_shot                = true
			p.emitting                = true
			p.amount                  = 32
			p.lifetime                = 1.5
			p.explosiveness           = 0.90
			p.spread                  = 180.0
			p.gravity                 = Vector2(0, 90)
			p.initial_velocity_min    = 80.0
			p.initial_velocity_max    = 250.0
			p.scale_amount_min        = 4.0
			p.scale_amount_max        = 11.0
			p.process_mode            = Node.PROCESS_MODE_ALWAYS
			var g                    := Gradient.new()
			g.set_color(0, Color(c1.r, c1.g, c1.b, 1.0))
			g.set_color(1, Color(c2.r, c2.g, c2.b, 0.0))
			p.color_ramp              = g
			p.position                = Vector2(vp.x * bx, vp.y * by)
			add_child(p)
			p.finished.connect(p.queue_free)
		)

func _show_level_reward_popup(new_level: int, reward_d: int, reward_t: int) -> void:
	var vp         := get_viewport().get_visible_rect().size
	var popup_w    := 240.0
	# Что именно открыл уровень — берём из лестницы АКТИВНОГО скина. Раньше тут
	# было «2 → ЖИР, 5 → УБЕР ЖИР» хардкодом: на всех остальных уровнях, где
	# скин получает резист или венец, попап молчал.
	var skin_id : String     = SaveData.active_skin
	var rw      : Dictionary = SkinProgression.reward_for(skin_id, new_level)
	var kind    : String     = String(rw.get("kind", ""))
	var has_unlock   : bool  = kind == "fat" or kind == "immunity" or kind == "perk"
	var unlock_title : String = ""
	var unlock_desc  : String = ""
	var unlock_tex   : Texture2D = null
	var unlock_fat   : int    = -1   # >= 0 → в карточке аватарка этого состояния
	var unlock_star  : String = ""
	var unlock_col   : Color  = Color(0.55, 1.00, 0.65)
	var unlock_bg    : Color  = Color(0.10, 0.26, 0.12, 0.92)
	match kind:
		"fat":
			unlock_fat   = int(rw.get("fat", 3))
			unlock_title = "+ %s" % _FAT_NAMES[clampi(unlock_fat, 0, 3)]
			unlock_desc  = "Новое состояние и +1 жизнь"
		"immunity":
			var tag : String = String(rw.get("item", ""))
			unlock_title = "+ РЕЗИСТ"
			unlock_desc  = "%s разбивается без вреда" % SkinProgression.item_name(tag).to_upper()
			unlock_tex   = _RESIST_TEX.get(tag)
			unlock_col   = Color(1.00, 0.62, 0.55)
			unlock_bg    = Color(0.28, 0.10, 0.10, 0.92)
		"perk":
			unlock_title = String(rw.get("label", ""))
			unlock_desc  = String(rw.get("desc", ""))
			unlock_star  = "★"
			unlock_col   = Color(1.00, 0.85, 0.30)
			unlock_bg    = Color(0.26, 0.20, 0.05, 0.92)

	const UNLOCK_H : float = 56.0
	var popup_h := 62.0
	if reward_d > 0:   popup_h += 32.0
	if reward_t > 0:   popup_h += 32.0
	if has_unlock:     popup_h += UNLOCK_H + 4.0
	popup_h += 52.0  # button row + padding

	# Dim overlay — added first so it renders behind popup
	var dim := ColorRect.new()
	dim.color        = Color(0.0, 0.0, 0.0, 0.0)
	dim.size         = vp
	dim.mouse_filter = Control.MOUSE_FILTER_STOP
	dim.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(dim)

	var popup := Node2D.new()
	popup.position     = Vector2(vp.x * 0.5, vp.y * 0.42)
	popup.scale        = Vector2(0.55, 0.55)
	popup.modulate.a   = 0.0
	popup.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(popup)

	var ox := -popup_w * 0.5
	var oy := -popup_h * 0.5

	var bg := ColorRect.new()
	bg.color    = Color(0.05, 0.04, 0.09, 0.97)
	bg.size     = Vector2(popup_w, popup_h)
	bg.position = Vector2(ox, oy)
	popup.add_child(bg)

	var stripe := ColorRect.new()
	stripe.color    = Color(1.0, 0.85, 0.20, 0.92)
	stripe.size     = Vector2(popup_w, 3.0)
	stripe.position = Vector2(ox, oy)
	popup.add_child(stripe)

	var lvl_str := "УРОВЕНЬ %d!" % new_level
	var hdr := Label.new()
	hdr.add_theme_font_override("font", UI_FONT)
	hdr.add_theme_font_size_override("font_size", 20)
	_apply_menu_caption_fx(hdr)
	hdr.text                 = lvl_str
	hdr.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	hdr.modulate             = Color(1.0, 0.92, 0.20)
	hdr.size                 = Vector2(popup_w, 40.0)
	hdr.position             = Vector2(ox, oy + 18.0)
	popup.add_child(hdr)

	var cur_y := oy + 62.0

	if reward_d > 0:
		var d_icon := _make_icon(DOLLAR_TEXTURE, 22.0)
		d_icon.position = Vector2(ox + 30.0, cur_y + 4.0)
		popup.add_child(d_icon)
		var d_lbl := Label.new()
		d_lbl.add_theme_font_override("font", UI_FONT)
		d_lbl.add_theme_font_size_override("font_size", 18)
		_apply_menu_caption_fx(d_lbl)
		d_lbl.text     = "+%d $" % reward_d
		d_lbl.modulate = Color(1.0, 0.88, 0.35)
		d_lbl.size     = Vector2(popup_w - 60.0, 28.0)
		d_lbl.position = Vector2(ox + 58.0, cur_y + 2.0)
		popup.add_child(d_lbl)
		cur_y += 32.0

	if reward_t > 0:
		var t_icon := _make_icon(TOKEN_TEXTURE, 22.0)
		t_icon.position = Vector2(ox + 30.0, cur_y + 4.0)
		popup.add_child(t_icon)
		var t_lbl := Label.new()
		t_lbl.add_theme_font_override("font", UI_FONT)
		t_lbl.add_theme_font_size_override("font_size", 18)
		_apply_menu_caption_fx(t_lbl)
		t_lbl.text     = "+%d жетон" % reward_t
		t_lbl.modulate = Color(1.0, 0.72, 0.25)
		t_lbl.size     = Vector2(popup_w - 60.0, 28.0)
		t_lbl.position = Vector2(ox + 58.0, cur_y + 2.0)
		popup.add_child(t_lbl)
		cur_y += 32.0

	if has_unlock:
		# Unlock card: tinted background, reward picture on the left, title
		# + short explanation on the right.
		var ul_bg := ColorRect.new()
		ul_bg.color    = unlock_bg
		ul_bg.size     = Vector2(popup_w - 20.0, UNLOCK_H)
		ul_bg.position = Vector2(ox + 10.0, cur_y)
		popup.add_child(ul_bg)

		var ul_stripe := ColorRect.new()
		ul_stripe.color    = Color(unlock_col.r, unlock_col.g, unlock_col.b, 0.80)
		ul_stripe.size     = Vector2(popup_w - 20.0, 2.0)
		ul_stripe.position = Vector2(ox + 10.0, cur_y)
		popup.add_child(ul_stripe)

		# Картинка награды: спрайт жира активного скина, предмет резиста или
		# звезда венца — чтобы попап показывал ровно то, что открылось.
		var fat_sz : float = UNLOCK_H - 12.0
		if unlock_fat >= 0:
			var fat_icon := _skin_head_icon(skin_id, unlock_fat, fat_sz)
			fat_icon.position = Vector2(ox + 18.0, cur_y + 6.0)
			popup.add_child(fat_icon)
		elif unlock_tex != null:
			var item_icon := TextureRect.new()
			item_icon.texture         = unlock_tex
			item_icon.expand_mode     = TextureRect.EXPAND_IGNORE_SIZE
			item_icon.stretch_mode    = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
			item_icon.texture_filter  = CanvasItem.TEXTURE_FILTER_NEAREST
			item_icon.size            = Vector2(fat_sz, fat_sz)
			item_icon.position        = Vector2(ox + 18.0, cur_y + 6.0)
			item_icon.mouse_filter    = Control.MOUSE_FILTER_IGNORE
			popup.add_child(item_icon)
		elif unlock_star != "":
			var star := Label.new()
			star.add_theme_font_override("font", UI_FONT)
			star.add_theme_font_size_override("font_size", 24)
			_apply_menu_caption_fx(star)
			star.text                 = unlock_star
			star.modulate             = unlock_col
			star.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			star.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
			star.size                 = Vector2(fat_sz, fat_sz)
			star.position             = Vector2(ox + 18.0, cur_y + 6.0)
			popup.add_child(star)

		var text_x : float = ox + 18.0 + fat_sz + 12.0
		var text_w : float = popup_w - 20.0 - (text_x - (ox + 10.0)) - 10.0

		var ul_title := Label.new()
		ul_title.add_theme_font_override("font", UI_FONT)
		ul_title.add_theme_font_size_override("font_size", 14)
		_apply_menu_caption_fx(ul_title)
		ul_title.text                 = unlock_title
		ul_title.modulate             = unlock_col
		ul_title.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
		ul_title.size                 = Vector2(text_w, 18.0)
		ul_title.position             = Vector2(text_x, cur_y + 6.0)
		popup.add_child(ul_title)

		var ul_desc := Label.new()
		ul_desc.add_theme_font_override("font", UI_FONT)
		ul_desc.add_theme_font_size_override("font_size", 10)
		_apply_menu_caption_fx(ul_desc)
		ul_desc.text                 = unlock_desc
		ul_desc.modulate             = Color(0.85, 0.95, 0.85, 0.95)
		ul_desc.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
		ul_desc.autowrap_mode        = TextServer.AUTOWRAP_WORD_SMART
		ul_desc.size                 = Vector2(text_w, UNLOCK_H - 26.0)
		ul_desc.position             = Vector2(text_x, cur_y + 24.0)
		popup.add_child(ul_desc)

		cur_y += UNLOCK_H + 4.0

	# "ЗАБРАТЬ!" button — wrapped in a visual Control so press-shrink
	# (`_menu_btn_press_anim`) scales the bg + label together around centre.
	cur_y += 10.0
	var btn_sz : Vector2 = Vector2(popup_w - 32.0, 36.0)
	var btn_pos: Vector2 = Vector2(ox + 16.0, cur_y)
	var btn_visual := Control.new()
	btn_visual.size         = btn_sz
	btn_visual.position     = btn_pos
	btn_visual.pivot_offset = btn_sz * 0.5
	btn_visual.mouse_filter = Control.MOUSE_FILTER_IGNORE
	btn_visual.process_mode = Node.PROCESS_MODE_ALWAYS
	popup.add_child(btn_visual)

	var btn_bg := ColorRect.new()
	btn_bg.color        = Color(0.08, 0.22, 0.10, 0.95)
	btn_bg.size         = btn_sz
	btn_bg.position     = Vector2.ZERO
	btn_bg.process_mode = Node.PROCESS_MODE_ALWAYS
	btn_visual.add_child(btn_bg)

	var btn_stripe := ColorRect.new()
	btn_stripe.color        = Color(0.55, 1.0, 0.65, 0.80)
	btn_stripe.size         = Vector2(btn_sz.x, 2.0)
	btn_stripe.position     = Vector2.ZERO
	btn_stripe.process_mode = Node.PROCESS_MODE_ALWAYS
	btn_visual.add_child(btn_stripe)

	var btn_lbl := Label.new()
	btn_lbl.add_theme_font_override("font", UI_FONT)
	btn_lbl.add_theme_font_size_override("font_size", 15)
	_apply_menu_caption_fx(btn_lbl)
	btn_lbl.text                 = "ЗАБРАТЬ!"
	btn_lbl.modulate             = Color(0.55, 1.0, 0.65)
	btn_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	btn_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	btn_lbl.size                 = btn_sz
	btn_lbl.position             = Vector2.ZERO
	btn_lbl.process_mode         = Node.PROCESS_MODE_ALWAYS
	btn_visual.add_child(btn_lbl)

	var collect_btn := Button.new()
	collect_btn.flat         = true
	collect_btn.focus_mode   = Control.FOCUS_NONE
	collect_btn.size         = btn_sz
	collect_btn.position     = btn_pos
	collect_btn.process_mode = Node.PROCESS_MODE_ALWAYS
	collect_btn.button_down.connect(_menu_btn_press_anim.bind(btn_visual, true))
	collect_btn.button_up.connect(_menu_btn_press_anim.bind(btn_visual, false))
	collect_btn.mouse_exited.connect(_menu_btn_press_anim.bind(btn_visual, false))
	popup.add_child(collect_btn)

	# Fade in dim + popup
	var tw_in := create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_parallel(true)
	tw_in.tween_property(dim,   "color:a",    0.68,           0.22)
	tw_in.tween_property(popup, "scale",      Vector2(1.0, 1.0), 0.26) \
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw_in.tween_property(popup, "modulate:a", 1.0,            0.18)
	await tw_in.finished

	# Wait for player to collect
	await collect_btn.pressed
	if not _go_anim_alive():
		return
	_play_btn_sfx()

	# Fade out
	var tw_out := create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS).set_parallel(true)
	tw_out.tween_property(popup, "modulate:a", 0.0, 0.22)
	tw_out.tween_property(dim,   "color:a",    0.0, 0.22)
	await tw_out.finished
	popup.queue_free()
	dim.queue_free()

func _run_xp_animation(xp_before: int, level_before: int, xp_gained: int) -> void:
	if _go_anim_busy:
		return
	_go_anim_busy = true

	# Reset bar to old state
	var old_p := _xp_progress_at(xp_before, level_before)
	if _go_fill_rect and is_instance_valid(_go_fill_rect):
		_go_fill_rect.size.x    = maxf(2.0, _go_bar_w * old_p)
		_go_shimmer_rect.size.x = maxf(2.0, _go_bar_w * old_p)
		_go_fill_rect.color     = Color(0.22, 0.58, 1.0)
	_update_xp_sub_label(xp_before, level_before)

	# Pizza fly-in
	_spawn_pizza_fly()
	await get_tree().create_timer(0.55, true).timeout

	# Walk through XP segments
	var cur_xp    := xp_before
	var cur_level := level_before
	var target_xp := xp_before + xp_gained

	while cur_xp < target_xp:
		var p_start := _xp_progress_at(cur_xp, cur_level)
		var next_level_xp := 0
		var will_level_up := false
		var next_level    := cur_level

		if cur_level < 10:
			next_level_xp = SaveData.LEVEL_XP[cur_level]
			if target_xp >= next_level_xp:
				will_level_up = true
				next_level    = cur_level + 1

		if will_level_up:
			await _fill_xp_segment(p_start, 1.0)
			cur_xp = next_level_xp
			_update_xp_sub_label(cur_xp, cur_level)
			# Деньги за уровень свои у каждого скина (skin_progression.gd) —
			# именно их начисляет SaveData.add_xp, и анимация баланса обязана
			# показывать ту же сумму, а не общую таблицу.
			var money : Vector2i = SkinProgression.money_for(SaveData.active_skin, next_level)
			var reward_d : int = money.x
			var reward_t : int = money.y
			await _flash_level_up_bar(next_level, reward_d, reward_t)
			cur_level = next_level
			if _go_fill_rect and is_instance_valid(_go_fill_rect):
				_go_fill_rect.size.x    = 2.0
				_go_shimmer_rect.size.x = 2.0
		else:
			var p_end := _xp_progress_at(target_xp, cur_level)
			await _fill_xp_segment(p_start, p_end)
			cur_xp = target_xp
			_update_xp_sub_label(cur_xp, cur_level)

	# Reveal rewards
	if _go_rewards_node and is_instance_valid(_go_rewards_node) and _go_anim_alive():
		var tw := create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		tw.tween_property(_go_rewards_node, "modulate:a", 1.0, 0.35)
	_go_anim_busy = false

func _restart() -> void:
	get_tree().paused = false
	get_tree().reload_current_scene()

# Tap "ЗАНОВО" on the death screen → stamp the auto-launch flag, then reload
# the scene. _ready picks the flag up and jumps straight into the run.
func _restart_into_new_run() -> void:
	HUD._restart_into_run = true
	HUD._restart_endless  = QuestManager._run_is_endless and QuestManager.is_endless_unlocked()
	get_tree().paused = false
	get_tree().reload_current_scene()

# Stops every active AudioStreamPlayer in the scene tree so the game-over
# screen comes up in silence — TV crash tail, eat/hit/fat SFX, item sounds,
# and the music node all get killed in one pass. UI sounds on the death
# screen still work because we don't touch the bus volumes.
func _silence_all_run_sfx() -> void:
	_stop_audio_recursive(get_tree().root)

func _stop_audio_recursive(node: Node) -> void:
	if node is AudioStreamPlayer:
		var p := node as AudioStreamPlayer
		if p.playing:
			p.stop()
	elif node is AudioStreamPlayer2D:
		var p2 := node as AudioStreamPlayer2D
		if p2.playing:
			p2.stop()
	for child in node.get_children():
		_stop_audio_recursive(child)

func _on_chest_press_down() -> void:
	_show_chest_tooltip()

func _on_chest_press_up() -> void:
	if _chest_tooltip and is_instance_valid(_chest_tooltip):
		_chest_tooltip.queue_free()
		_chest_tooltip = null

func _show_chest_tooltip() -> void:
	var is_mastery := SaveData.skin_level >= 10
	var next_lvl   := mini(SaveData.skin_level + 1, 10)
	# Подсказка сундука обещает ровно то, что лежит в лестнице активного скина:
	# раньше она называла деньги из общей таблицы и «FAT / UBER FAT» на 2-м и
	# 5-м уровнях, хотя жир открывает только 2-й, а 4/6/8 дают резисты.
	var skin_id : String     = SaveData.active_skin
	var money   : Vector2i   = SkinProgression.money_for(skin_id, next_lvl)
	var rw      : Dictionary = SkinProgression.reward_for(skin_id, next_lvl)
	var kind    : String     = String(rw.get("kind", ""))
	var next_d  : int = money.x if not is_mastery else 0
	var next_t  : int = money.y if not is_mastery else 1
	var has_unlock  := not is_mastery and (kind == "fat" or kind == "immunity" or kind == "perk")
	var unlock_text := ""
	var unlock_col  := Color(0.40, 1.00, 0.50)
	var unlock_bg   := Color(0.10, 0.26, 0.12, 0.85)
	match kind:
		"fat":
			unlock_text = "+ ЖИР «%s»  (+1 ЖИЗНЬ)" % _FAT_NAMES[clampi(int(rw.get("fat", 3)), 0, 3)]
		"immunity":
			unlock_text = "+ РЕЗИСТ: %s" % SkinProgression.item_name(String(rw.get("item", ""))).to_upper()
			unlock_col  = Color(1.00, 0.62, 0.55)
			unlock_bg   = Color(0.28, 0.10, 0.10, 0.85)
		"perk":
			unlock_text = "★ %s" % String(rw.get("label", ""))
			unlock_col  = Color(1.00, 0.85, 0.30)
			unlock_bg   = Color(0.26, 0.20, 0.05, 0.85)

	var vp    := get_viewport().get_visible_rect().size
	var tip_w := 180.0
	var tip_h := 28.0
	if is_mastery:
		tip_h += 26.0
	else:
		if next_d > 0: tip_h += 26.0
		if next_t > 0: tip_h += 26.0
		if has_unlock: tip_h += 24.0
	tip_h += 4.0

	var tip_x := clampf(_chest_anchor.x - tip_w * 0.5, 8.0, vp.x - tip_w - 8.0)
	var tip_y := _chest_anchor.y - 14.0 - tip_h - 8.0
	if tip_y < 8.0:
		tip_y = _chest_anchor.y + 14.0 + 8.0

	_chest_tooltip          = Node2D.new()
	_chest_tooltip.position = Vector2(tip_x, tip_y)
	_menu_overlay.add_child(_chest_tooltip)

	var bg := ColorRect.new()
	bg.color = Color(0.06, 0.05, 0.10, 0.97)
	bg.size  = Vector2(tip_w, tip_h)
	_chest_tooltip.add_child(bg)

	var tip_stripe := ColorRect.new()
	tip_stripe.color = Color(0.88, 0.65, 0.20, 0.90)
	tip_stripe.size  = Vector2(tip_w, 2.0)
	_chest_tooltip.add_child(tip_stripe)

	var hdr_text := "МАСТЕРСТВО:" if is_mastery else \
		"УРОВЕНЬ %d — НАГРАДЫ:" % next_lvl
	var hdr := Label.new()
	hdr.add_theme_font_override("font", UI_FONT)
	hdr.add_theme_font_size_override("font_size", 10)
	hdr.text                 = hdr_text
	hdr.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	hdr.modulate             = Color(0.90, 0.80, 0.40, 0.90)
	hdr.size                 = Vector2(tip_w, 22.0)
	hdr.position             = Vector2(0.0, 4.0)
	_chest_tooltip.add_child(hdr)

	var cur_y := 28.0

	if is_mastery:
		var m_lbl := Label.new()
		m_lbl.add_theme_font_override("font", UI_FONT)
		m_lbl.add_theme_font_size_override("font_size", 13)
		m_lbl.text                 = "+1 ЖЕТОН / 200 XP"
		m_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		m_lbl.modulate             = Color(1.0, 0.72, 0.25)
		m_lbl.size                 = Vector2(tip_w, 22.0)
		m_lbl.position             = Vector2(0.0, cur_y)
		_chest_tooltip.add_child(m_lbl)
	else:
		if next_d > 0:
			var d_icon := _make_icon(DOLLAR_TEXTURE, 16.0)
			d_icon.position = Vector2(34.0, cur_y + 3.0)
			_chest_tooltip.add_child(d_icon)
			var d_lbl := Label.new()
			d_lbl.add_theme_font_override("font", UI_FONT)
			d_lbl.add_theme_font_size_override("font_size", 14)
			d_lbl.text     = "+%d $" % next_d
			d_lbl.modulate = Color(1.0, 0.88, 0.35)
			d_lbl.size     = Vector2(tip_w - 54.0, 22.0)
			d_lbl.position = Vector2(54.0, cur_y)
			_chest_tooltip.add_child(d_lbl)
			cur_y += 26.0

		if next_t > 0:
			var t_dot := ColorRect.new()
			t_dot.color    = Color(1.0, 0.60, 0.10)
			t_dot.size     = Vector2(12.0, 12.0)
			t_dot.position = Vector2(36.0, cur_y + 5.0)
			_chest_tooltip.add_child(t_dot)
			var t_lbl := Label.new()
			t_lbl.add_theme_font_override("font", UI_FONT)
			t_lbl.add_theme_font_size_override("font_size", 14)
			t_lbl.text     = "+%d жетон" % next_t
			t_lbl.modulate = Color(1.0, 0.72, 0.25)
			t_lbl.size     = Vector2(tip_w - 54.0, 22.0)
			t_lbl.position = Vector2(54.0, cur_y)
			_chest_tooltip.add_child(t_lbl)
			cur_y += 26.0

		if has_unlock:
			var ul_bg := ColorRect.new()
			ul_bg.color    = unlock_bg
			ul_bg.size     = Vector2(tip_w - 16.0, 20.0)
			ul_bg.position = Vector2(8.0, cur_y)
			_chest_tooltip.add_child(ul_bg)
