	const BTN_W : float = 150.0
	const BTN_H : float = 38.0
	var ok_x := panel_x + panel_w * 0.5 + 6.0
	var ca_x := panel_x + panel_w * 0.5 - 6.0 - BTN_W
	var btn_y := panel_y + panel_h - BTN_H - 14.0

	# Cancel (press-shrink wrapper)
