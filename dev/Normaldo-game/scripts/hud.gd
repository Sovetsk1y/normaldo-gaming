func _build_go_rank_block(panel_x: float, panel_y: float, panel_w: float, pm: int, panel_h: float = 0.0) -> void:
	# Two compact one-liner rows anchored above the action buttons:
	# [podium] section name   #place  delta-triangle
	var rows_x : float = panel_x + 18.0
	var rows_w : float = panel_w - 36.0
	# Rows sit ~32 px above the button row, which is at panel_y + panel_h - 50.
	var rows_y : float = panel_y + panel_h - 50.0 - 8.0 - 38.0
	if panel_h <= 0.0:
		rows_y = panel_y + 270.0

	_build_go_rank_row(rows_x, rows_y, rows_w,
		"Рекорд забега",
		LeaderboardMock.get_player_rank(LeaderboardMock.Metric.BEST),
		LeaderboardMock.get_player_delta(LeaderboardMock.Metric.BEST),
		LeaderboardMock.get_player_is_new(LeaderboardMock.Metric.BEST), pm)
	_build_go_rank_row(rows_x, rows_y + 20.0, rows_w,
		"Гора пицц",
		LeaderboardMock.get_player_rank(LeaderboardMock.Metric.TOTAL),
		LeaderboardMock.get_player_delta(LeaderboardMock.Metric.TOTAL),
		LeaderboardMock.get_player_is_new(LeaderboardMock.Metric.TOTAL), pm)

	# Hit area spans both rows — tap anywhere to open the full leaderboard.
	var btn := Button.new()
	btn.flat         = true
	btn.focus_mode   = Control.FOCUS_NONE
	btn.size         = Vector2(rows_w, 38.0)
	btn.position     = Vector2(rows_x, rows_y)
	btn.process_mode = pm
	btn.pressed.connect(_play_btn_sfx)
	btn.pressed.connect(_on_death_rank_tapped)
	add_child(btn)

func _build_go_rank_row(row_x: float, y: float, row_w: float,
		metric_name: String, place: int, delta: int, is_new: bool, pm: int) -> void:
	const POD_SZ : float = 16.0
	var pod := TextureRect.new()
	pod.texture           = PODIUM_TEX
	pod.expand_mode       = TextureRect.EXPAND_IGNORE_SIZE
	pod.stretch_mode      = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	pod.texture_filter    = CanvasItem.TEXTURE_FILTER_NEAREST
	pod.size              = Vector2(POD_SZ, POD_SZ)
	pod.position          = Vector2(row_x, y + (18.0 - POD_SZ) * 0.5)
	pod.mouse_filter      = Control.MOUSE_FILTER_IGNORE
	pod.process_mode      = pm
	add_child(pod)

	var name_lbl := Label.new()
	name_lbl.add_theme_font_override("font", UI_FONT)
	name_lbl.add_theme_font_size_override("font_size", 9)
	_apply_menu_caption_fx(name_lbl)
	name_lbl.text                 = metric_name
	name_lbl.modulate             = Color(0.85, 0.90, 0.95)
	name_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	name_lbl.size                 = Vector2(row_w * 0.45, 18.0)
	name_lbl.position             = Vector2(row_x + POD_SZ + 6.0, y)
	name_lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	name_lbl.process_mode         = pm
	add_child(name_lbl)

	var place_lbl := Label.new()
	place_lbl.add_theme_font_override("font", UI_FONT)
	place_lbl.add_theme_font_size_override("font_size", 11)
	_apply_menu_caption_fx(place_lbl)
	place_lbl.text                 = "#%d" % place
	place_lbl.modulate             = Color(1.0, 0.88, 0.40)
	place_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	place_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	place_lbl.size                 = Vector2(60.0, 18.0)
	place_lbl.position             = Vector2(row_x + row_w - 96.0, y)
	place_lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	place_lbl.process_mode         = pm
	add_child(place_lbl)

	var delta_text := ""
	var delta_col  := Color(0.55, 0.95, 0.55)
	if is_new:
		delta_text = "NEW"
		delta_col  = Color(0.45, 1.0, 0.55)
	elif delta > 0:
		delta_text = "▲ %d" % delta
	elif delta < 0:
		delta_text = "▼ %d" % -delta
		delta_col  = Color(1.0, 0.55, 0.50)
	if delta_text == "":
		return
	var delta_lbl := Label.new()
	delta_lbl.add_theme_font_override("font", UI_FONT)
	delta_lbl.add_theme_font_size_override("font_size", 10)
	_apply_menu_caption_fx(delta_lbl)
	delta_lbl.text                 = delta_text
	delta_lbl.modulate             = delta_col
	delta_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	delta_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	delta_lbl.size                 = Vector2(40.0, 18.0)
	delta_lbl.position             = Vector2(row_x + row_w - 44.0, y)
	delta_lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	delta_lbl.process_mode         = pm
	add_child(delta_lbl)

# Death-screen action button — visual wrapper Control + Label + hit Button
# so the standard press-shrink FX (`_menu_btn_press_anim`) applies cleanly.
func _build_go_action_btn(pos: Vector2, sz: Vector2, caption: String,
		fg: Color, bg: Color, action: Callable, pm: int,
		border: Color = Color(0, 0, 0, 0), font_sz: int = 14) -> void:
	var visual := Control.new()
	visual.pivot_offset = sz * 0.5
	visual.mouse_filter = Control.MOUSE_FILTER_IGNORE
	visual.process_mode = pm
	UiKit.place(self, visual, pos, sz)

	var bg_rect := Panel.new()
	bg_rect.add_theme_stylebox_override("panel", UiKit.rounded(bg, 8,
		border if border.a > 0.0 else Color(fg.r, fg.g, fg.b, 0.80), 2))
	bg_rect.mouse_filter = Control.MOUSE_FILTER_PASS
	bg_rect.process_mode = pm
	UiKit.place(visual, bg_rect, Vector2.ZERO, sz)

	var lbl := Label.new()
	lbl.add_theme_font_override("font", UI_FONT)
	lbl.add_theme_font_size_override("font_size", font_sz)
	_apply_menu_caption_fx(lbl)
	lbl.text                 = caption
	lbl.modulate             = fg
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	lbl.process_mode         = pm
	lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	UiKit.place(visual, lbl, Vector2.ZERO, sz)

	var hit := Button.new()
	hit.flat         = true
	hit.focus_mode   = Control.FOCUS_NONE
	hit.process_mode = pm
	hit.pressed.connect(func():
		_play_btn_sfx()
		action.call()
	)
	hit.button_down.connect(_menu_btn_press_anim.bind(visual, true))
	hit.button_up.connect(_menu_btn_press_anim.bind(visual, false))
	hit.mouse_exited.connect(_menu_btn_press_anim.bind(visual, false))
	UiKit.place(self, hit, pos, sz)

