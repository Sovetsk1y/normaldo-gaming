	var star_lbl := Label.new()
	star_lbl.add_theme_font_override("font", UI_FONT)
	star_lbl.add_theme_font_size_override("font_size", 13)
	star_lbl.text                 = "★"
	star_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	star_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	star_lbl.modulate             = rc
	star_lbl.size                 = Vector2(STAR_SZ, PANEL_H)
	_oneshot_panel.add_child(star_lbl)

	var unique   := SkinSkills.get_unique(SaveData.active_skin)
	var lbl_text := unique.get("label", "УНИКАЛЬНО") as String
	var name_lbl := Label.new()
	name_lbl.add_theme_font_override("font", UI_FONT)
	name_lbl.add_theme_font_size_override("font_size", 8)
	name_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	name_lbl.modulate             = Color(rc.r, rc.g, rc.b, 0.90)
	name_lbl.size                 = Vector2(PANEL_W - STAR_SZ - 4.0, PANEL_H)
	name_lbl.position             = Vector2(STAR_SZ + 4.0, 0.0)
	name_lbl.text                 = lbl_text
	_oneshot_panel.add_child(name_lbl)
	_oneshot_name_lbl = name_lbl

	_oneshot_dim         = ColorRect.new()
	_oneshot_dim.color   = Color(0.0, 0.0, 0.0, 0.58)
	_oneshot_dim.size    = Vector2(PANEL_W, PANEL_H)
	_oneshot_dim.visible = false
	_oneshot_panel.add_child(_oneshot_dim)

	_oneshot_line1               = Line2D.new()
	_oneshot_line1.points        = [Vector2(3, 3), Vector2(PANEL_W - 3, PANEL_H - 3)]
	_oneshot_line1.width         = 2.0
	_oneshot_line1.default_color = Color(0.90, 0.22, 0.22, 0.92)
	_oneshot_line1.visible       = false
	_oneshot_panel.add_child(_oneshot_line1)

	_oneshot_line2               = Line2D.new()
	_oneshot_line2.points        = [Vector2(PANEL_W - 3, 3), Vector2(3, PANEL_H - 3)]
	_oneshot_line2.width         = 2.0
	_oneshot_line2.default_color = Color(0.90, 0.22, 0.22, 0.92)
	_oneshot_line2.visible       = false
	_oneshot_panel.add_child(_oneshot_line2)

func _on_unique_ability_changed(ready: bool) -> void:
	if not is_instance_valid(_oneshot_panel):
		return
	_oneshot_panel.visible = true
	if ready:
		_oneshot_bg.size.x     = _oneshot_star_sz + (130.0 - _oneshot_star_sz)
		if is_instance_valid(_oneshot_name_lbl):
			_oneshot_name_lbl.modulate.a = 0.90
		_oneshot_dim.visible   = false
		_oneshot_line1.visible = false
		_oneshot_line2.visible = false
	else:
		var sz := _oneshot_star_sz
		var ph := _oneshot_panel_h
		var tw := _oneshot_panel.create_tween()
		tw.tween_property(_oneshot_name_lbl, "modulate:a", 0.0, 0.18)
		tw.parallel().tween_property(_oneshot_bg, "size:x", sz, 0.28) \
			.set_ease(Tween.EASE_OUT)
		tw.tween_callback(func():
			_oneshot_dim.size    = Vector2(sz, ph)
			_oneshot_line1.points = PackedVector2Array([Vector2(2, 2), Vector2(sz - 2, ph - 2)])
			_oneshot_line2.points = PackedVector2Array([Vector2(sz - 2, 2), Vector2(2, ph - 2)])
			_oneshot_dim.visible   = true
			_oneshot_line1.visible = true
			_oneshot_line2.visible = true
		)

func _rebuild_skin_panels() -> void:
	const ROW_H := 22.0
	if is_instance_valid(_wizard_gauge_node):
		_wizard_gauge_node.queue_free()
		_wizard_gauge_node = null
		_wizard_bar_fill   = null
		_wizard_bonus_lbl  = null
		_wizard_max_lbl    = null
		_wizard_bonus_show = false
		if _wizard_pulse_tw and _wizard_pulse_tw.is_valid():
			_wizard_pulse_tw.kill()
			_wizard_pulse_tw = null
	if is_instance_valid(_oneshot_panel):
		_oneshot_panel.queue_free()
		_oneshot_panel    = null
		_oneshot_bg       = null
		_oneshot_name_lbl = null
		_oneshot_dim      = null
		_oneshot_line1    = null
		_oneshot_line2    = null
		_oneshot_star_sz  = 0.0
		_oneshot_panel_h  = 0.0
	# Old wizard/oneshot run panels are retired — the new model shows top-left
	# cooldown badges instead (see _build_skill_badges).

const _SKILL_BADGES_SCRIPT := preload("res://scripts/skill_badges.gd")
var _skill_badges_layer : Control = null

# Top-left cooldown circles for the active skin's skills (resists / active /
# passive). Rebuilt every run from scripts/skill_badges.gd.
func _build_skill_badges(normaldo: Node) -> void:
	if is_instance_valid(_skill_badges_layer):
		_skill_badges_layer.queue_free()
	var layer := Control.new()
	layer.set_script(_SKILL_BADGES_SCRIPT)
	layer.position     = _skill_badge_anchor
	layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(layer)
	layer.call("setup", normaldo)
	_skill_badges_layer = layer

# Левая стопка (пауза + ресурсы + жир) въезжает из-за края. Зовут отсюда трое:
# начало забега, победа над боссом и — в тестовом режиме — сам босс своим
# `tree_exited`. Последний и приносил падение: «ЕЩЁ РАЗ» на экране смерти
# перезагружает сцену, из дерева вынимают и крокодила, и интерфейс, крокодил
# уходит первым и дёргает этот обработчик у уже отцепленного HUD.
# Всё, что про отцепленное дерево, живёт в UiKit.slide_to().
# ИНТЕРФЕЙС ЗАБЕГА ОСТАЁТСЯ И НА БОССЕ. Левая стопка — пауза, ресурсы и полоса
# жира — уезжала за край на время боя: считалось, что бой надо показывать без
# помех. Убирались при этом ровно те вещи, которые в бою нужнее всего: сколько у
# меня жира (то есть жизней), сколько собрано и чем поставить паузу. Игрок
# оставался один на один с боссом и без единой цифры о себе.
#
# Въезд стопки остался — он играется один раз, на старте забега.
func _slide_in_hud() -> void:
	UiKit.slide_to(_left_container, "position:x", 0.0, 0.45,
		Tween.TRANS_BACK, Tween.EASE_OUT)

func _build_player_cell(vp: Vector2) -> void:
	const CELL_W : float = 230.0
	const CELL_H : float = 52.0
	const AV_SZ  : float = 44.0
	const PAD    : float = 8.0
	var x := 12.0
	var y := 12.0

	_player_cell_root = Node2D.new()
	_player_cell_root.position = Vector2(x, y)
	_menu_overlay.add_child(_player_cell_root)

	# Background
	var bg := ColorRect.new()
	bg.color = Color(0.08, 0.07, 0.10, 0.88)
	bg.size  = Vector2(CELL_W, CELL_H)
	_player_cell_root.add_child(bg)
	# Top stripe accent
	var stripe := ColorRect.new()
	stripe.color = Color(0.55, 0.85, 1.0, 0.75)
	stripe.size  = Vector2(CELL_W, 2.0)
	_player_cell_root.add_child(stripe)

	# Avatar
	var avatar_info := _current_avatar()
	var av_holder := _skin_head_icon(avatar_info.skin_id, int(avatar_info.fat), AV_SZ)
	av_holder.position = Vector2(PAD, (CELL_H - AV_SZ) * 0.5)
	_player_cell_root.add_child(av_holder)
	_player_avatar_rect = _head_icon_rect(av_holder)

	# АВАТАР НЕ ВЫБИРАЕТСЯ. Он показывает АКТИВНЫЙ СКИН — то есть уже сделанный
	# выбор, и второй выбор поверх первого превращал картинку в ложь: в таблице
	# лидеров стоит одна голова, а бегает другая. Кнопки здесь больше нет.

	# Nickname
	var name_x := PAD + AV_SZ + 10.0
	_player_name_lbl = Label.new()
	_player_name_lbl.add_theme_font_override("font", UI_FONT)
	_player_name_lbl.add_theme_font_size_override("font_size", 13)
	_player_name_lbl.text                 = SaveData.display_name if SaveData.display_name != "" else "—"
	_player_name_lbl.modulate             = Color(1.0, 0.95, 0.85)
	_player_name_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	_player_name_lbl.clip_text            = true
	_player_name_lbl.size                 = Vector2(CELL_W - name_x - 32.0, CELL_H)
	_player_name_lbl.position             = Vector2(name_x, 0)
	_player_name_lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	_player_cell_root.add_child(_player_name_lbl)

	# Edit pencil button
	const PEN_SZ : float = 18.0
	var pen_x := CELL_W - PEN_SZ - 10.0
	var pen_y := (CELL_H - PEN_SZ) * 0.5
	_draw_pencil_icon(_player_cell_root, Vector2(pen_x, pen_y), PEN_SZ,
		Color(0.55, 0.85, 1.0, 0.85))
	var pen_btn := Button.new()
	pen_btn.flat       = true
	pen_btn.focus_mode = Control.FOCUS_NONE
	pen_btn.size       = Vector2(PEN_SZ + 12.0, PEN_SZ + 12.0)
	pen_btn.position   = Vector2(pen_x - 6.0, pen_y - 6.0)
	pen_btn.pressed.connect(_show_rename_modal)
	_player_cell_root.add_child(pen_btn)

func _build_settings_gear(_vp: Vector2) -> void:
	# Sit immediately to the right of the player cell.
	const SZ      : float = 44.0
	const CELL_W  : float = 230.0
	const CELL_X  : float = 12.0
