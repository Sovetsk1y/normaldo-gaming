func _show_shop(restore_scroll: int = 0, from_slots: bool = false, skip_open_anim: bool = false) -> void:
	var vp    := get_viewport().get_visible_rect().size
	# Top-chrome height in viewport pixels (was 48.0). Kept for the scroll layout.
	const HDR_H      := 48.0
	const CARD_W     := 200.0
	const CARD_H     := 360.0
	const CARD_GAP   := 12.0
	# Canvas reference matches every other slide-down screen (430×192).
	const SK_CANVAS_W : float = 430.0
	const SK_CANVAS_H : float = 192.0
	const SK_SLIDE_TIME : float = 0.45
	var scale_x : float = vp.x / SK_CANVAS_W
	var scale_y : float = vp.y / SK_CANVAS_H

	# Slide-root — everything visible lives inside so the camera-pan entrance
	# can move the entire screen as one piece (skipped when we re-open from
	# the slot machines, where the slots controller manages its own swap).
	var overlay := Control.new()
	overlay.size         = vp
	overlay.position     = Vector2.ZERO
	overlay.mouse_filter = Control.MOUSE_FILTER_PASS
	add_child(overlay)

	# Full-screen pixel-art background (bg_shop.png, 430×192).
	var bg_tex := load("res://assets/ui/skins/bg_shop.png") as Texture2D
	if bg_tex != null:
		var bg := TextureRect.new()
		bg.texture             = bg_tex
		bg.stretch_mode        = TextureRect.STRETCH_SCALE
		bg.expand_mode         = TextureRect.EXPAND_IGNORE_SIZE
		bg.custom_minimum_size = Vector2.ZERO
		bg.size                = vp
		bg.position            = Vector2.ZERO
		bg.texture_filter      = CanvasItem.TEXTURE_FILTER_NEAREST
		bg.mouse_filter        = Control.MOUSE_FILTER_IGNORE
		overlay.add_child(bg)

	# ── Back arrow (top-left, press-shrink animation) ──────────────────────
	var back_size := Vector2(24.0 * scale_x, 15.0 * scale_y)
	var back_visual := Control.new()
	back_visual.size         = back_size
	back_visual.position     = Vector2(10.0 * scale_x, 6.0 * scale_y)
	back_visual.pivot_offset = back_size * 0.5
	back_visual.mouse_filter = Control.MOUSE_FILTER_IGNORE
	overlay.add_child(back_visual)

	var back_arrow_tex := load("res://assets/ui/quests/back_arrow.png") as Texture2D
	if back_arrow_tex != null:
		var back_icon := TextureRect.new()
		back_icon.texture             = back_arrow_tex
		back_icon.stretch_mode        = TextureRect.STRETCH_SCALE
		back_icon.expand_mode         = TextureRect.EXPAND_IGNORE_SIZE
		back_icon.custom_minimum_size = Vector2.ZERO
		back_icon.size                = back_size
		back_icon.position            = Vector2.ZERO
		back_icon.texture_filter      = CanvasItem.TEXTURE_FILTER_NEAREST
		back_icon.mouse_filter        = Control.MOUSE_FILTER_IGNORE
		back_visual.add_child(back_icon)

	# Close logic: if we opened with camera-pan from the main menu, slide back
	# DOWN before freeing. Otherwise (e.g. from slots) just close instantly.
	var close_callable := func():
		_play_btn_sfx()
		if not from_slots:
			var tw_out := create_tween()
			tw_out.tween_property(overlay, "position", Vector2(0.0, vp.y), SK_SLIDE_TIME)\
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
			tw_out.tween_callback(overlay.queue_free)
			_on_skins_close_anim_start(SK_SLIDE_TIME, Tween.TRANS_QUAD, Tween.EASE_IN)
		else:
			overlay.queue_free()

	var close_btn := Button.new()
	close_btn.flat       = true
	close_btn.focus_mode = Control.FOCUS_NONE
	close_btn.size       = back_size + Vector2(14.0, 14.0)
	close_btn.position   = back_visual.position - Vector2(7.0, 7.0)
	close_btn.pressed.connect(close_callable)
	close_btn.button_down.connect(_menu_btn_press_anim.bind(back_visual, true))
	close_btn.button_up.connect(_menu_btn_press_anim.bind(back_visual, false))
	close_btn.mouse_exited.connect(_menu_btn_press_anim.bind(back_visual, false))
	overlay.add_child(close_btn)

	# ── Title "СКИНЫ" (top-centre) ─────────────────────────────────────────
	var title_lbl := Label.new()
	title_lbl.add_theme_font_override("font", UI_FONT)
	title_lbl.add_theme_font_size_override("font_size", 16)
	_apply_menu_caption_fx(title_lbl)
	title_lbl.text                 = "СКИНЫ"
	title_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	title_lbl.size                 = Vector2(vp.x, 20.0 * scale_y)
	title_lbl.position             = Vector2(-30.0 * scale_x, 6.0 * scale_y)
	title_lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	overlay.add_child(title_lbl)

	# ── Top-right resources (dollar + token), same layout as quests ────────
	var icon_sz : float = 16.0 * scale_y
	var num_w   : float = 36.0 * scale_x
	var pair_gap: float = 2.0 * scale_x
	var pair_w  : float = icon_sz + 2.0 + num_w
	var total_w : float = pair_w * 2.0 + pair_gap
	var right_x : float = vp.x + 10.0 * scale_x   # RES_RIGHT_PAD = -10
	var start_x : float = right_x - total_w
	var top_y   : float = 7.0 * scale_y

	var dlr_icon := _make_icon(DOLLAR_TEXTURE, icon_sz)
	dlr_icon.position = Vector2(start_x, top_y)
	overlay.add_child(dlr_icon)
	var dlr_lbl := Label.new()
	dlr_lbl.add_theme_font_override("font", UI_FONT)
	dlr_lbl.add_theme_font_size_override("font_size", 14)
	_apply_menu_caption_fx(dlr_lbl)
	dlr_lbl.text                 = str(SaveData.dollars)
	dlr_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	dlr_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	dlr_lbl.size                 = Vector2(num_w, icon_sz + 4.0)
	dlr_lbl.position             = Vector2(start_x + icon_sz + 2.0, top_y - 2.0)
	overlay.add_child(dlr_lbl)

	var tkn_x : float = start_x + pair_w + pair_gap
	var tkn_icon := _make_icon(TOKEN_TEXTURE, icon_sz)
	tkn_icon.position = Vector2(tkn_x, top_y)
	overlay.add_child(tkn_icon)
	var tkn_lbl := Label.new()
	tkn_lbl.add_theme_font_override("font", UI_FONT)
	tkn_lbl.add_theme_font_size_override("font_size", 14)
	_apply_menu_caption_fx(tkn_lbl)
	tkn_lbl.text                 = str(SaveData.tokens)
	tkn_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	tkn_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	tkn_lbl.size                 = Vector2(num_w, icon_sz + 4.0)
	tkn_lbl.position             = Vector2(tkn_x + icon_sz + 2.0, top_y - 2.0)
	overlay.add_child(tkn_lbl)

	# Slide-up entrance (unless re-opened from slots / post-purchase rerender).
	if not from_slots and not skip_open_anim:
		overlay.position = Vector2(0.0, vp.y)
		var tw_in := create_tween()
		tw_in.tween_property(overlay, "position", Vector2.ZERO, SK_SLIDE_TIME)\
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
		_on_skins_open_anim_start(SK_SLIDE_TIME, Tween.TRANS_QUAD, Tween.EASE_IN)

	# ── Переключатель вида ─────────────────────────────────────────────────
	# Сетка отвечает на вопрос «что у меня есть» — вся коллекция разом. Карточки
	# отвечают на «каков он» — одна голова крупно, с жиром, уровнем и спеллом.
	# Это разные задачи, и одним экраном они не решаются: сетка, дорощенная до
	# подробностей, перестаёт помещаться, а карточки, ужатые до обзора,
	# перестают что-либо показывать.
	_build_skins_view_toggle(overlay, vp, scale_x, scale_y, from_slots)

	var grid_y := HDR_H + 6.0
	var grid_h := vp.y - grid_y - 6.0
	if _skins_card_view:
		_build_skins_cards(overlay, vp, grid_y, grid_h, from_slots)
		return

	# ── GRID of small cells (vertical scroll) ──────────────────────────────
	var scroll := ScrollContainer.new()
	scroll.size                   = Vector2(vp.x, grid_h)
	scroll.position               = Vector2(0.0, grid_y)
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.vertical_scroll_mode   = ScrollContainer.SCROLL_MODE_AUTO
	overlay.add_child(scroll)

	# Порядок КОЛЛЕКЦИИ, а не владения: как в реестре, от классики к легендарным.
	#
	# Раньше сетка шла «сначала свои, потом магазин», и покупка ПЕРЕСОБИРАЛА её:
	# карточка прыгала из хвоста в начало прямо из-под пальца, а на её место
	# приезжала чужая. Игрок терял то, что только что купил.
	#
	# Владение показывает сама карточка — словом на кнопке (КУПИТЬ / НАДЕТЬ /
	# АКТИВЕН) и уровнем на портрете. Гасить непокупленные целиком не стали:
	# коллекция должна выглядеть коллекцией, а не списком запретов.
	var skins : Array = []
	for sd in SkinRegistry.SKINS:
		if sd["id"] == "new_year":
			continue
		skins.append(sd)

	# Вся коллекция на одном экране: 13 скинов ложатся 5×3 и помещаются целиком.
	# Раньше карточка была 150×156, третий ряд обрезался, и треть коллекции
	# уезжала под скролл без всякой подсказки — при том что внутри карточки
	# между именем и кнопкой было воздуха больше, чем сам аватар.
	# См. /Концепция/Экран скинов.md
	const G_GAP  := 10.0
	const CELL_W := 150.0
	var cols : int = maxi(2, int((vp.x - 24.0 + G_GAP) / (CELL_W + G_GAP)))
	var n := skins.size()
	var rows : int = int(ceil(float(n) / float(cols)))
	# Высота карточки подбирается под число рядов, чтобы сетка влезла без
	# прокрутки; ниже CELL_H_MIN не ужимаем — там уже не помещается кнопка.
	const CELL_H_MIN := 104.0
	const CELL_H_MAX := 150.0
	var cell_h : float = clampf((grid_h - G_GAP * float(rows + 1)) / float(rows),
		CELL_H_MIN, CELL_H_MAX)
	var grid_total_w : float = cols * CELL_W + (cols - 1) * G_GAP
	var start_gx : float = (vp.x - grid_total_w) * 0.5
	var content_h : float = G_GAP + rows * (cell_h + G_GAP)

	var content := Control.new()
	content.custom_minimum_size = Vector2(vp.x, maxf(content_h, grid_h))
	content.mouse_filter        = Control.MOUSE_FILTER_PASS
	scroll.add_child(content)

	for i in n:
		var col := i % cols
		var row := i / cols
		var gx := start_gx + col * (CELL_W + G_GAP)
		var gy := G_GAP + row * (cell_h + G_GAP)
		_build_skin_grid_cell(content, Vector2(gx, gy), CELL_W, cell_h, skins[i], overlay, from_slots)

# Returns list of item textures relevant to a skill (for popup display).
func _skill_item_textures(sk: Dictionary) -> Array:
	var result : Array = []
	var tags   : Array = sk.get("tags",   [])
	var groups : Array = sk.get("groups", [])
	if not tags.is_empty():
		for t in tags:
			match t:
				"stone":  result.append(STONE_TEXTURE)
				"trash":  result.append(TRASH_TEXTURE)
				"glove":  result.append(GLOVE_TEXTURE)
				"snake":  result.append(SNAKE_TEXTURE)
				"banana": result.append(BANANA_TEXTURE)
				"beer":   result.append(BEER_TEXTURE)
				"fire":   result.append(FIRE_TEXTURE)
	else:
		for g in groups:
			match g:
				"slowing":  result.append_array([BEER_TEXTURE, BANANA_TEXTURE])
				"obstacle": result.append_array([STONE_TEXTURE, TRASH_TEXTURE, GLOVE_TEXTURE, SNAKE_TEXTURE, FIRE_TEXTURE])
				"dollar":   result.append(DOLLAR_TEXTURE)
	return result

# Returns short effect string for compact row display.
func _skill_short_effect(sk: Dictionary) -> String:
	match sk["type"]:
		SkinSkills.DODGE:
			return "%d%% уклон" % int(sk.get("chance", 0.0) * 100)
		SkinSkills.ADAPT:
			return "×0.5 длит."
		SkinSkills.COUNTER:
			var xp := sk.get("bonus_xp", 0) as int
			var dl := sk.get("bonus_dollars", 0) as int
			if xp > 0: return "+%d XP" % xp
			if dl > 0: return "+%d $"  % dl
			return "+бонус"
		SkinSkills.TRANSFORM:
			var chance := int(sk.get("chance", 0.0) * 100)
			match sk.get("into", ""):
				"pizza":     return "%d%%→пицца" % chance
				"dollar_x3": return "%d%%→×3$"   % chance
				"random":    return "%d%%→?"      % chance
			return "%d%% трансф." % chance
	return ""

# Returns full mechanic description for the detail popup.
func _tag_name_acc(tags: Array) -> String:
	if tags.size() == 1:
		match tags[0]:
			"stone":  return "камень"
			"trash":  return "урну"
			"glove":  return "перчатку"
			"snake":  return "змею"
			"banana": return "банановую кожуру"
			"beer":   return "пиво"
			"fire":   return "огонь"
			"dollar": return "доллар"
	return "предмет"

func _skill_mechanic_desc(sk: Dictionary) -> String:
	var tags := sk.get("tags", []) as Array
	var item := _tag_name_acc(tags)
	match sk["type"]:
		SkinSkills.DODGE:
			return "%d%% шанс пройти сквозь %s\nбез эффекта" % [int(sk.get("chance", 0.0) * 100), item]
		SkinSkills.ADAPT:
			return "Негативный эффект снижен на 50%"
		SkinSkills.COUNTER:
			var xp := sk.get("bonus_xp", 0) as int
			var dl := sk.get("bonus_dollars", 0) as int
			if xp > 0: return "Удар засчитывается, но даёт +%d XP" % xp
			if dl > 0: return "Удар засчитывается, но даёт +%d $"  % dl
			return "Удар засчитывается, но даёт случайный бонус"
		SkinSkills.TRANSFORM:
			var chance := int(sk.get("chance", 0.0) * 100)
			match sk.get("into", ""):
				"pizza":     return "%d%% шанс превратить %s в пиццу" % [chance, item]
				"dollar_x3": return "%d%% шанс: доллар → ×3 долларов"      % chance
				"random":    return "%d%% шанс превратить %s в случайный предмет" % [chance, item]
			return "%d%% шанс изменить %s при подборе" % [chance, item]
	return ""

