	else:
		croc.connect("tree_exited", _slide_in_hud)

# Fifth dev chip — campaign-only fast-forward. Each tap jumps to the next
# campaign phase; tapping past the final (pre-boss) phase summons the boss.
func _build_dev_phase_btn() -> void:
	var spawner := get_parent().get_node_or_null("Spawner")
	if not spawner or not is_instance_valid(spawner) or not spawner.campaign_mode:
		return
	var vp     := get_viewport().get_visible_rect().size
	const SZ   := 44.0
	const GAP  := 6.0
	_dev_phase_btn          = Node2D.new()
	_dev_phase_btn.position = Vector2(8.0, vp.y - SZ * 5.0 - 8.0 - GAP * 4.0)
	add_child(_dev_phase_btn)

	var bg := ColorRect.new()
	bg.color = Color(0.20, 0.14, 0.04, 0.92)
	bg.size  = Vector2(SZ, SZ)
	_dev_phase_btn.add_child(bg)

	var stripe := ColorRect.new()
	stripe.color = Color(1.00, 0.75, 0.20, 0.85)
	stripe.size  = Vector2(SZ, 2.0)
	_dev_phase_btn.add_child(stripe)

	# Forward-arrow glyph: ">>" built from two stacked triangles of color rects.
	var arrow_col := Color(1.00, 0.85, 0.35, 0.95)
	for offset in [0.0, 6.0]:
		for i in 5:
			var w : float = float(5 - i)
			var seg := ColorRect.new()
			seg.color    = arrow_col
			seg.size     = Vector2(w, 2.0)
			seg.position = Vector2((SZ - 14.0) * 0.5 + offset, 8.0 + i * 2.0)
			_dev_phase_btn.add_child(seg)

	_dev_phase_lbl = Label.new()
	_dev_phase_lbl.add_theme_font_override("font", UI_FONT)
	_dev_phase_lbl.add_theme_font_size_override("font_size", 9)
	_dev_phase_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_dev_phase_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	_dev_phase_lbl.modulate             = Color(1.00, 0.85, 0.45)
	_dev_phase_lbl.size                 = Vector2(SZ, 12.0)
	_dev_phase_lbl.position             = Vector2(0.0, SZ - 14.0)
	_dev_phase_btn.add_child(_dev_phase_lbl)
	_refresh_dev_phase_lbl(spawner)

	var btn := Button.new()
	btn.flat       = true
	btn.focus_mode = Control.FOCUS_NONE
	btn.size       = Vector2(SZ, SZ)
	btn.pressed.connect(_dev_skip_phase)
	_dev_phase_btn.add_child(btn)

func _refresh_dev_phase_lbl(spawner) -> void:
	if not is_instance_valid(_dev_phase_lbl) or not spawner:
		return
	var idx : int = spawner._phase
	var total : int = (spawner.CAMPAIGN_PHASES as Array).size()
	_dev_phase_lbl.text = "Ф%d/%d" % [idx + 1, total]

func _dev_skip_phase() -> void:
	_play_btn_sfx()
	var spawner := get_parent().get_node_or_null("Spawner")
	if not spawner or not is_instance_valid(spawner):
		return
	spawner.dev_skip_to_next_phase()
	# After the final phase the spawner fires boss_time itself — drop the chip
	# so the player can't keep mashing it after the boss arrives.
	if spawner.campaign_mode and spawner._phase >= spawner.CAMPAIGN_PHASES.size():
		if is_instance_valid(_dev_phase_btn):
			_dev_phase_btn.queue_free()
			_dev_phase_btn = null
		return
	_refresh_dev_phase_lbl(spawner)

func _draw_dev_collision_icon(parent: Node, pos: Vector2, sz: float) -> void:
	# Hollow rectangle outline + a diagonal cross — quick visual shorthand
	# for "collision shape". Built from ColorRects so it scales cleanly.
	var col := Color(0.40, 0.75, 1.00, 0.95)
	var t   := 2.0   # outline thickness
	# Outline (top / bottom / left / right)
	for r in [
		Rect2(0, 0, sz, t),
		Rect2(0, sz - t, sz, t),
		Rect2(0, 0, t, sz),
		Rect2(sz - t, 0, t, sz),
	]:
		var rect := ColorRect.new()
		rect.color    = col
		rect.size     = (r as Rect2).size
		rect.position = pos + (r as Rect2).position
		parent.add_child(rect)
	# Diagonal accent (a stepped row of small squares) — readable at 22 px.
	for i in 5:
		var d := ColorRect.new()
		d.color    = Color(col.r, col.g, col.b, 0.55)
		d.size     = Vector2(t, t)
		var step : float = (sz - t * 2.0) / 5.0
		d.position = pos + Vector2(t + i * step, t + i * step)
		parent.add_child(d)

func _toggle_dev_collisions() -> void:
	_play_btn_sfx()
	_dev_collisions_show = not _dev_collisions_show
	# debug_collisions_hint controls new CollisionShape2Ds (e.g. spawned
	# pizzas/stones). Existing ones won't pick it up automatically, so we
	# also flip `visible` on every shape currently in the tree.
	get_tree().debug_collisions_hint = _dev_collisions_show
	_apply_collision_visibility(get_parent(), _dev_collisions_show)
	_refresh_dev_collisions_visual()

func _apply_collision_visibility(node: Node, vis: bool) -> void:
	if node == null:
		return
	if node is CollisionShape2D:
		(node as CollisionShape2D).visible = vis
		(node as CollisionShape2D).queue_redraw()
	elif node is CollisionPolygon2D:
		(node as CollisionPolygon2D).visible = vis
		(node as CollisionPolygon2D).queue_redraw()
	for child in node.get_children():
		_apply_collision_visibility(child, vis)

func _refresh_dev_collisions_visual() -> void:
	if not is_instance_valid(_dev_collisions_btn):
		return
	if _dev_collisions_show:
		_dev_collisions_bg.color = Color(0.06, 0.22, 0.36, 0.88)
		_dev_collisions_lbl.text     = "COLL ON"
		_dev_collisions_lbl.modulate = Color(0.55, 0.90, 1.00)
	else:
		_dev_collisions_bg.color = Color(0.06, 0.06, 0.10, 0.72)
		_dev_collisions_lbl.text     = "COLL OFF"
		_dev_collisions_lbl.modulate = Color(0.55, 0.70, 0.95)

func _draw_dev_heart_icon(parent: Node, pos: Vector2, sz: float) -> void:
	# Compact pixel heart: two top lobes + diamond bottom, 5×5-ish coarse blocks.
	var blk := sz / 5.0
	var cells : Array = [
		Vector2(1, 0), Vector2(3, 0),
		Vector2(0, 1), Vector2(1, 1), Vector2(2, 1), Vector2(3, 1), Vector2(4, 1),
		Vector2(0, 2), Vector2(1, 2), Vector2(2, 2), Vector2(3, 2), Vector2(4, 2),
		Vector2(1, 3), Vector2(2, 3), Vector2(3, 3),
		Vector2(2, 4),
	]
	for c in cells:
		var rect := ColorRect.new()
		rect.color    = Color(1.0, 0.45, 0.45)
		rect.size     = Vector2(blk + 0.5, blk + 0.5)
		rect.position = pos + Vector2(c.x * blk, c.y * blk)
		parent.add_child(rect)

func _toggle_dev_immortal() -> void:
	_dev_immortal_on = not _dev_immortal_on
	_apply_dev_immortal_to_normaldo()
	_refresh_dev_immortal_visual()

func _apply_dev_immortal_to_normaldo() -> void:
	var normaldo := get_parent().get_node_or_null("Normaldo")
	if normaldo and normaldo.has_method("set_dev_immortal"):
		normaldo.set_dev_immortal(_dev_immortal_on)

func _refresh_dev_immortal_visual() -> void:
	if not is_instance_valid(_dev_immortal_bg):
		return
	if _dev_immortal_on:
		_dev_immortal_bg.color   = Color(0.10, 0.35, 0.14, 0.95)
		_dev_immortal_lbl.text   = "БЕСС: ON"
		_dev_immortal_lbl.modulate = Color(0.65, 1.0, 0.55)
	else:
		_dev_immortal_bg.color   = Color(0.06, 0.06, 0.10, 0.72)
		_dev_immortal_lbl.text   = "БЕСС: OFF"
		_dev_immortal_lbl.modulate = Color(0.55, 0.55, 0.60)

# «Дошёл до босса» — только отметка для заданий и аналитики. Кого именно
# поднимать, решает `_on_level_cleared`: боссы у уровней разные, а этот сигнал
# ничего о них не знает и подписан на него не только бой.
func _on_boss_time() -> void:
	QuestManager.notify_boss_reached()
	# Дев-кнопка «БОСС» зовёт этот метод напрямую, минуя уровни: там босс всегда
	# Нога Ниндзя, и уровень после него не меняется.
	if _boss_test_mode:
		_summon_boss("ninja")

# ── Конец уровня ─────────────────────────────────────────────────────────────
# Слово NORMALDO выложено. На уровне с боссом выходит босс, и следующий уровень
# начнётся после победы; на уровне без босса — сразу карточка следующего.
#
# Пятый уровень — последний: его босс кончает кампанию, а не ведёт дальше.
var _next_level : int = 0

func _on_level_cleared(boss: String, next_level: int) -> void:
	_next_level = next_level
	if boss != "":
		_summon_boss(boss)
		return
	_show_level_card(next_level)

const BOSS_SCENES : Dictionary = { "ninja": "scene", "croc": "croc", "club": "club" }

func _summon_boss(kind: String) -> void:
	var game_root := get_parent() as Node2D
	var normaldo  := get_parent().get_node_or_null("Normaldo") as Node2D
	var spawner   := get_parent().get_node_or_null("Spawner")
	if not normaldo or not game_root:
		return
	# Slide the HUD off-screen so the boss arena reads clean — no resource
	# chrome competing with the fight visuals.
	# Фон ЗАМИРАЕТ на боссе. Едущая стена за спиной у стоящего босса читается как
	# «мы всё ещё бежим», хотя бежать уже некуда: бой идёт на месте.
	var bg := game_root.get_node_or_null("Background")
	if bg and bg.has_method("stop_scrolling"):
		bg.stop_scrolling()
	var boss : Node = null
	match kind:
		"croc":
			var c := Node2D.new()
			c.set_script(LEATHERHEAD_SCRIPT)
			c.call("setup", normaldo, spawner, game_root, false)
			boss = c
		"club":
			var cb := Node2D.new()
			cb.set_script(CLUB_BOSS_SCRIPT)
			cb.call("setup", normaldo, spawner, game_root, false)
			boss = cb
		_:
			var nf := NINJA_FOOT_SCENE.instantiate()
			nf.setup(normaldo, spawner, game_root, _boss_test_mode)
			boss = nf
	game_root.add_child(boss)
	boss.connect("defeated", _on_boss_defeated)


func _on_boss_defeated() -> void:
	await _run_win_word()
	# Босс ПОСЛЕДНЕГО уровня кончает кампанию; босс любого другого — ведёт на
	# следующий уровень, и забег продолжается тем же забегом: жир, доллары и
	# счётчик пиццы переходят дальше. Уровень внутри эпизода, разорванный на
	# отдельные забеги, перестал бы быть уровнем.
	if _next_level > 0:
		_slide_in_hud()
		_show_level_card(_next_level)
		return
	# Boss defeat → endless mode unlock + the standard death-screen flow with
	# an extra "ENDLESS UNLOCKED" callout (set via _endless_unlock_pending).
	_run_outcome = "boss_defeated"
	var unlocked_before : bool = QuestManager.is_endless_unlocked()
	Analytics.event("boss_defeated", {
		"first_time":     not unlocked_before,
		"time_in_run":    int(_elapsed_time),
	})
	QuestManager.notify_boss_defeated()
	QuestManager.notify_campaign_complete()
	_endless_unlock_pending = (not unlocked_before) and QuestManager.is_endless_unlocked()
	_timer_running = false
	# Boss is dead — slide the HUD back in (mirrors the run-start slide).
	_slide_in_hud()
	var normaldo := get_parent().get_node_or_null("Normaldo")
	if normaldo and normaldo.has_method("disable_input"):
		normaldo.disable_input()
	await get_tree().create_timer(1.6).timeout
	# Route through the regular death flow so the player gets the same panel
	# (avatar + XP + balance + rank). The "ВЫЙГРАЛ" framing is conveyed by
	# the unlock badge.
	if is_instance_valid(normaldo) and normaldo.has_method("_die"):
		normaldo._die()
	else:
		# Safety net — if normaldo is gone (shouldn't happen), still surface
		# a game-over panel with what we have.
		_on_normaldo_died(0, Vector2.ZERO)

# ── WIN из долларов ──────────────────────────────────────────────────────────
# Босс повержен — через экран проплывает WIN, выложенное долларами во всю высоту.
# Тем же приёмом, что и буквы NORMALDO: сетка 5×7, три буквы подряд, полёт
# справа налево с потоком.
#
# Раньше на этом месте был салют — частицы по краям экрана. Салют ничего не даёт
# и ничем не отличается от такого же салюта в лудилке: универсальное «ура»,
# которое одинаково означает и выигранный бой, и совпавшие барабаны. WIN из
# долларов говорит то же самое СЛОВАМИ игры — и его можно СОБРАТЬ, так что
# уровень кончается тем самым, ради чего в него шли.
#
# Фон при этом снова едет: бой шёл на месте, а победа — это «побежали дальше».
# Слово не мешает никому: спавнер после конца уровня уже заморожен, и на экране
# кроме WIN ничего нет.
const WIN_WORD : String = "WIN"
# Своя скорость, а не скорость потока. На скорости уровня (около 200 px/c) слово
# едет через экран девять секунд: это уже не победный такт, а ожидание карточки.
# 330 даёт около пяти — ровно столько, чтобы пройти его насквозь и собрать.
const WIN_SPEED : float = 330.0

func _run_win_word() -> void:
	var spawner := get_parent().get_node_or_null("Spawner")
	if spawner == null or not spawner.has_method("lay_word"):
		return
	var bg := get_parent().get_node_or_null("Background")
	if bg and bg.has_method("start_scrolling"):
		bg.start_scrolling()
	# Слово надо СОБИРАТЬ, а значит двигаться. Управление на этот момент и так
	# включено, но зависит это от того, каким тактом кончился каждый из трёх
	# боссов: слово, которое нельзя собрать, — это тот же салют, только дольше.
	var nd := get_parent().get_node_or_null("Normaldo")
	if nd and nd.has_method("enable_input"):
		nd.enable_input()
	# Долларами, а не пиццей: пицца — это жизнь, и на победном такте она
	# читалась бы как «вот тебе аптечка», а не как «вот твой выигрыш».
	var hold : float = float(spawner.call("lay_word", WIN_WORD, false, WIN_SPEED))
	await get_tree().create_timer(hold).timeout

# ── Карточка уровня ──────────────────────────────────────────────────────────
# Между уровнями экран накрывается карточкой: «УРОВЕНЬ 3» и название локации.
#
# Она не украшение, а ШОВ. Полосы уровней — разные помещения, у них не сходится
# ни кладка, ни линия пола, и перетечь из одной в другую нельзя. Карточка на
# полторы секунды закрывает подмену, и до игрока доезжает уже новая стена.
#
# Заодно она отбивает ритм кампании: уровни подряд без единой паузы
# читались бы как один бесконечный, а игрок должен знать, сколько он прошёл.
const LEVEL_CARD_T : float = 1.7

func _show_level_card(next_level: int) -> void:
	var game_root := get_parent() as Node2D
	var normaldo  := get_parent().get_node_or_null("Normaldo")
	var spawner   := get_parent().get_node_or_null("Spawner")
	var bg        := game_root.get_node_or_null("Background") if game_root else null
	if normaldo and normaldo.has_method("disable_input"):
		normaldo.disable_input()
	if bg and bg.has_method("stop_scrolling"):
		bg.stop_scrolling()

	var vp := get_viewport().get_visible_rect().size
	var cl := CanvasLayer.new()
	cl.layer = 96
	add_child(cl)
	var dim := ColorRect.new()
	dim.color = Color(0.02, 0.02, 0.04, 0.0)
	dim.size  = vp
	cl.add_child(dim)

	var num := Label.new()
	num.add_theme_font_override("font", UI_FONT)
	num.add_theme_font_size_override("font_size", 44)
	# Номер ставится ПОСЛЕ перехода и берётся у спавнера, а не из аргумента: два
	# независимых источника номера расходятся при первой же правке, и карточка
	# начинает врать — «УРОВЕНЬ 3» над названием второго.
	num.text                 = ""
	num.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	num.size                 = Vector2(vp.x, 56.0)
	num.position             = Vector2(0.0, vp.y * 0.36)
	num.modulate             = Color(1.0, 0.92, 0.55, 0.0)
	cl.add_child(num)

	var nm := Label.new()
	nm.add_theme_font_override("font", UI_FONT)
	nm.add_theme_font_size_override("font_size", 22)
	nm.text                 = String(spawner.call("level_name")) if spawner else ""
	nm.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	nm.size                 = Vector2(vp.x, 30.0)
	nm.position             = Vector2(0.0, vp.y * 0.36 + 58.0)
	nm.modulate             = Color(0.75, 0.95, 1.0, 0.0)
	cl.add_child(nm)

	var tw := dim.create_tween()
	tw.tween_property(dim, "color:a", 0.85, 0.30)
	await tw.finished

	# Подмена ПОД карточкой: и полоса фона, и уровень спавнера меняются, пока
	# экран закрыт.
	if spawner:
		spawner.call("advance_level")
		nm.text  = String(spawner.call("level_name"))
		num.text = "УРОВЕНЬ %d" % (int(spawner.get("level")) + 1)
	else:
		num.text = "УРОВЕНЬ %d" % (next_level + 1)
	if bg and bg.has_method("set_level"):
		bg.call("set_level", next_level + 1)

	var tw2 := num.create_tween()
	tw2.tween_property(num, "modulate:a", 1.0, 0.22)
	tw2.parallel().tween_property(nm, "modulate:a", 1.0, 0.22)
	await get_tree().create_timer(LEVEL_CARD_T).timeout
	if not is_instance_valid(cl):
		return
	var out := dim.create_tween()
	out.tween_property(dim, "color:a", 0.0, 0.30)
	out.parallel().tween_property(num, "modulate:a", 0.0, 0.30)
	out.parallel().tween_property(nm, "modulate:a", 0.0, 0.30)
	out.tween_callback(cl.queue_free)
	if bg and bg.has_method("start_scrolling"):
		bg.call("start_scrolling")
	if normaldo and normaldo.has_method("enable_input"):
		normaldo.enable_input()

