# Returns the current enabled state for the master switch (`key == "_master"`)
# or a specific category (`key == "A".."H"`). Defaults to true for unknown
# categories so introducing a new category later doesn't silently start out
# disabled on installed clients.
func _notif_cat_enabled(key: String) -> bool:
	if key == "_master":
		return bool(SaveData.notif_enabled)
	return bool(SaveData.notif_categories.get(key, true))

# Flip a notif-prefs flag, persist, and emit data_changed so NotifPlanner
# replans on the spot.
func _toggle_notif_category(key: String) -> void:
	if key == "_master":
		SaveData.notif_enabled = not SaveData.notif_enabled
	else:
		SaveData.notif_categories[key] = not bool(SaveData.notif_categories.get(key, true))
	SaveData._save()
	SaveData.data_changed.emit()

