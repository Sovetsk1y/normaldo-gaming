		xp_bg.size         = Vector2(xp_btn_w, xp_btn_h)
		xp_bg.position     = Vector2(xp_btn_x, xp_btn_y)
		xp_bg.process_mode = _pm
		add_child(xp_bg)

		var xp_lbl2 := Label.new()
		xp_lbl2.add_theme_font_override("font", UI_FONT)
		xp_lbl2.add_theme_font_size_override("font_size", 10)
		xp_lbl2.text                 = "+%d XP" % xp_amt
		xp_lbl2.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		xp_lbl2.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
		xp_lbl2.modulate             = Color(0.50, 1.00, 0.50)
		xp_lbl2.size                 = Vector2(xp_btn_w, xp_btn_h)
		xp_lbl2.position             = Vector2(xp_btn_x, xp_btn_y)
		xp_lbl2.process_mode         = _pm
		add_child(xp_lbl2)

		var xp_btn := Button.new()
		xp_btn.flat         = true
		xp_btn.focus_mode = Control.FOCUS_NONE
		xp_btn.size         = Vector2(xp_btn_w, xp_btn_h)
		xp_btn.position     = Vector2(xp_btn_x, xp_btn_y)
		xp_btn.process_mode = _pm
		var capture_amt = xp_amt
		xp_btn.pressed.connect(func():
			if _go_anim_busy:
				return
			_play_btn_sfx()
			var xb := SaveData.skin_xp
			var lb := SaveData.skin_level
			SaveData.add_xp(capture_amt, "game_over_capture")
			_run_xp_animation(xb, lb, capture_amt)
		)
		add_child(xp_btn)
		xp_btn_y += xp_btn_h + 6.0

	# DEV reset skin progress button
	xp_btn_y += 4.0
	var rst_bg := ColorRect.new()
	rst_bg.color        = Color(0.22, 0.06, 0.06, 0.90)
	rst_bg.size         = Vector2(xp_btn_w, xp_btn_h)
	rst_bg.position     = Vector2(xp_btn_x, xp_btn_y)
