	UiKit.place(ok_visual, ok_bg, Vector2.ZERO, Vector2(BTN_W, BTN_H))
	var ok_lbl := Label.new()
	ok_lbl.add_theme_font_override("font", UI_FONT)
	ok_lbl.add_theme_font_size_override("font_size", 14)
	_apply_menu_caption_fx(ok_lbl)
	ok_lbl.text                 = "ВОССТАНОВИТЬ"
	ok_lbl.modulate             = Color(0.75, 0.95, 1.0)
	ok_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	ok_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	ok_lbl.size                 = Vector2(BTN_W, BTN_H)
	ok_lbl.position             = Vector2.ZERO
	ok_lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	ok_visual.add_child(ok_lbl)
	var ok_btn := Button.new()
	ok_btn.flat       = true
	ok_btn.focus_mode = Control.FOCUS_NONE
	ok_btn.size       = Vector2(BTN_W, BTN_H)
	ok_btn.position   = Vector2(ok_x, btn_y)
	ok_btn.pressed.connect(func():
		await _attempt_restore(line.text.strip_edges().to_upper(), error_lbl, root))
	ok_btn.button_down.connect(_menu_btn_press_anim.bind(ok_visual, true))
	ok_btn.button_up.connect(_menu_btn_press_anim.bind(ok_visual, false))
	ok_btn.mouse_exited.connect(_menu_btn_press_anim.bind(ok_visual, false))
	root.add_child(ok_btn)

func _attempt_restore(code: String, error_lbl: Label, modal_root: Node) -> void:
	if code.length() < 8:
		error_lbl.text = "Код слишком короткий"
		error_lbl.modulate = Color(1.0, 0.55, 0.45)
		return
	error_lbl.modulate = Color(0.85, 0.85, 0.85)
	error_lbl.text = "Восстанавливаю…"
	Logger.info("HUD", "_attempt_restore: code length=%d" % code.length())
	var resp = await LeaderboardClient.restore_account(code)
	Logger.info_dict("HUD", "restore_account result", resp)
	if resp.ok:
		error_lbl.modulate = Color(0.55, 1.0, 0.55)
		error_lbl.text = "Готово, перезагружаю…"
		await get_tree().create_timer(0.6).timeout
		get_tree().paused = false
		get_tree().reload_current_scene()
	else:
		error_lbl.modulate = Color(1.0, 0.55, 0.45)
		var msg := str(resp.get("error", ""))
		var ui_msg : String
		if msg.findn("not-found") >= 0 or msg.findn("code not found") >= 0:
			ui_msg = "Код не найден"
		elif msg.findn("invalid-argument") >= 0:
			ui_msg = "Код в неверном формате"
		else:
			ui_msg = "Не удалось восстановить"
		# Append raw server message for debugging
		var detail := msg
		if detail.length() > 80:
			detail = detail.substr(0, 80) + "…"
		error_lbl.text = "%s\n%s" % [ui_msg, detail]
		Logger.err("HUD", "restore failed: %s" % msg)
