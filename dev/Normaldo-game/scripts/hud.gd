# Detailed popup (opened by "?") — full mechanic text per skill.
func _show_skill_detail_popup(skin_data: Dictionary, parent_overlay: Control) -> void:
	var vp          := get_viewport().get_visible_rect().size
	var skin_id     := skin_data["id"] as String
	var name_ru     := skin_data.get("name_ru", skin_id) as String
	var rarity      := skin_data.get("rarity", 0) as int
	var rc           = SkinRegistry.RARITY_COLORS[rarity]
	var skills_list := SkinSkills.get_skills(skin_id)
	var unique_data := SkinSkills.get_unique(skin_id)

	var popup_root := Control.new()
	popup_root.size         = vp
	popup_root.mouse_filter = Control.MOUSE_FILTER_PASS
	parent_overlay.add_child(popup_root)

	var dim := ColorRect.new()
	dim.color        = Color(0.0, 0.0, 0.0, 0.55)
	dim.size         = vp
	dim.mouse_filter = Control.MOUSE_FILTER_PASS
	popup_root.add_child(dim)

	const PW       := 290.0
	const ROW_H    := 86.0   # title + 2-line desc + items strip (bigger icons)
	const UNIQ_H   := 96.0
	const ITEM_SZ  := 24.0   # large enough to read item silhouettes
	const ITEM_GAP := 5.0
	const HDR_H    := 40.0
	const CLOSE_H  := 30.0
	const CLOSE_PAD := 10.0
	var uniq_h  := UNIQ_H if not unique_data.is_empty() else 0.0
	# Total content height the scroll viewport would need to show everything
	# without scrolling. Used to keep small popups from looking empty.
	var content_h : float = skills_list.size() * ROW_H
	if not unique_data.is_empty():
		content_h += 4.0 + uniq_h
	var ph_ideal : float = HDR_H + content_h + 8.0 + CLOSE_H + CLOSE_PAD * 2.0
	var ph      : float = clampf(ph_ideal, 180.0, vp.y - 20.0)
	var px      : float = (vp.x - PW) * 0.5
	var py      : float = (vp.y - ph) * 0.5

	var panel := ColorRect.new()
	panel.color        = Color(0.04, 0.03, 0.10, 0.97)
	panel.size         = Vector2(PW, ph)
	panel.position     = Vector2(px, py)
	panel.mouse_filter = Control.MOUSE_FILTER_PASS
	popup_root.add_child(panel)

	var top_stripe := ColorRect.new()
	top_stripe.color        = Color(rc.r, rc.g, rc.b, 0.90)
	top_stripe.size         = Vector2(PW, 3.0)
	top_stripe.position     = Vector2(px, py)
	top_stripe.mouse_filter = Control.MOUSE_FILTER_PASS
	popup_root.add_child(top_stripe)

	var hdr := Label.new()
	hdr.add_theme_font_override("font", UI_FONT)
	hdr.add_theme_font_size_override("font_size", 13)
	_apply_menu_caption_fx(hdr)
	hdr.text                 = name_ru + "  —  МЕХАНИКА"
	hdr.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	hdr.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	hdr.modulate             = Color(rc.r, rc.g, rc.b)
	hdr.size                 = Vector2(PW, HDR_H - 6.0)
	hdr.position             = Vector2(px, py + 6.0)
	popup_root.add_child(hdr)

	# Scrollable body — sits between the header and the close button so even
	# skins with many skills + a long unique description are fully reachable.
	var body_top    : float = py + HDR_H
	var body_bottom : float = py + ph - CLOSE_H - CLOSE_PAD * 2.0
	var body_h      : float = maxf(60.0, body_bottom - body_top)

	if skills_list.is_empty():
		var no_sk := Label.new()
		no_sk.add_theme_font_override("font", UI_FONT)
		no_sk.add_theme_font_size_override("font_size", 10)
		_apply_menu_caption_fx(no_sk)
		no_sk.text                 = "Нет навыков — чистая проверка скилла"
		no_sk.modulate             = Color(1.0, 1.0, 1.0, 0.45)
		no_sk.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		no_sk.size                 = Vector2(PW, 28.0)
		no_sk.position             = Vector2(px, body_top + 8.0)
		popup_root.add_child(no_sk)
	else:
		var type_names  := { SkinSkills.DODGE:"УКЛОНЕНИЕ", SkinSkills.ADAPT:"АДАПТАЦИЯ",
							 SkinSkills.COUNTER:"КОНТР-УДАР", SkinSkills.TRANSFORM:"ТРАНСФОРМАЦИЯ" }
		var type_colors := { SkinSkills.DODGE:Color(0.20,0.60,1.00), SkinSkills.ADAPT:Color(1.00,0.78,0.15),
							 SkinSkills.COUNTER:Color(1.00,0.42,0.10), SkinSkills.TRANSFORM:Color(0.25,0.90,0.45) }

		var scroll := ScrollContainer.new()
		scroll.position               = Vector2(px, body_top)
		scroll.size                   = Vector2(PW, body_h)
		scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
		scroll.vertical_scroll_mode   = ScrollContainer.SCROLL_MODE_SHOW_NEVER
		scroll.mouse_filter           = Control.MOUSE_FILTER_PASS
		scroll.set("scroll_deadzone", 10)
		popup_root.add_child(scroll)

		var inner := Control.new()
		inner.custom_minimum_size = Vector2(PW, content_h + 4.0)
		inner.mouse_filter        = Control.MOUSE_FILTER_PASS
		scroll.add_child(inner)

		var sy : float = 0.0
		for sk in skills_list:
			var stype := sk["type"] as String
			var sclr  := type_colors.get(stype, Color(0.6,0.6,0.6)) as Color
			var sname := type_names.get(stype, stype) as String

			var rbg := ColorRect.new()
			rbg.color        = Color(sclr.r, sclr.g, sclr.b, 0.07)
			rbg.size         = Vector2(PW - 16.0, ROW_H - 3.0)
			rbg.position     = Vector2(8.0, sy + 1.0)
			rbg.mouse_filter = Control.MOUSE_FILTER_PASS
			inner.add_child(rbg)

			var lstripe := ColorRect.new()
			lstripe.color        = Color(sclr.r, sclr.g, sclr.b, 0.70)
			lstripe.size         = Vector2(3.0, ROW_H - 3.0)
			lstripe.position     = Vector2(8.0, sy + 1.0)
			lstripe.mouse_filter = Control.MOUSE_FILTER_PASS
			inner.add_child(lstripe)

			var tnm := Label.new()
			tnm.add_theme_font_override("font", UI_FONT)
			tnm.add_theme_font_size_override("font_size", 9)
			_apply_menu_caption_fx(tnm)
			tnm.text     = sname
			tnm.modulate = sclr
			tnm.size     = Vector2(PW - 28.0, 14.0)
			tnm.position = Vector2(16.0, sy + 5.0)
			inner.add_child(tnm)

			var slbl := Label.new()
			slbl.add_theme_font_override("font", UI_FONT)
			slbl.add_theme_font_size_override("font_size", 10)
			_apply_menu_caption_fx(slbl)
			slbl.text          = _skill_mechanic_desc(sk)
			slbl.modulate      = Color(1.0, 1.0, 1.0, 0.90)
			slbl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			slbl.size          = Vector2(PW - 28.0, 28.0)
			slbl.position      = Vector2(16.0, sy + 18.0)
			inner.add_child(slbl)

			var items := _skill_item_textures(sk)
			if not items.is_empty():
				var ix : float = 16.0
				var iy : float = sy + ROW_H - ITEM_SZ - 8.0
				for tex in items:
					if tex == null:
						continue
					var icon := TextureRect.new()
					icon.texture           = tex
					icon.expand_mode       = TextureRect.EXPAND_IGNORE_SIZE
					icon.stretch_mode      = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
					icon.size              = Vector2(ITEM_SZ, ITEM_SZ)
					icon.position          = Vector2(ix, iy)
					icon.mouse_filter      = Control.MOUSE_FILTER_IGNORE
					inner.add_child(icon)
					ix += ITEM_SZ + ITEM_GAP
					if ix > PW - 24.0:
						break

			sy += ROW_H

		if not unique_data.is_empty():
			sy += 4.0
			var ubg := ColorRect.new()
			ubg.color        = Color(rc.r*0.12, rc.g*0.12, rc.b*0.12, 0.95)
			ubg.size         = Vector2(PW - 16.0, uniq_h - 6.0)
			ubg.position     = Vector2(8.0, sy)
			ubg.mouse_filter = Control.MOUSE_FILTER_PASS
			inner.add_child(ubg)

			var ust := ColorRect.new()
			ust.color        = Color(rc.r, rc.g, rc.b, 0.70)
			ust.size         = Vector2(3.0, uniq_h - 6.0)
			ust.position     = Vector2(8.0, sy)
			ust.mouse_filter = Control.MOUSE_FILTER_PASS
			inner.add_child(ust)

			var sstar := Label.new()
			sstar.add_theme_font_override("font", UI_FONT)
			sstar.add_theme_font_size_override("font_size", 10)
			_apply_menu_caption_fx(sstar)
			sstar.text     = "★  " + unique_data.get("label", "")
			sstar.modulate = Color(rc.r, rc.g, rc.b)
			sstar.size     = Vector2(PW - 32.0, 18.0)
			sstar.position = Vector2(16.0, sy + 6.0)
			inner.add_child(sstar)

			var udsc := Label.new()
			udsc.add_theme_font_override("font", UI_FONT)
			udsc.add_theme_font_size_override("font_size", 9)
			_apply_menu_caption_fx(udsc)
			udsc.text          = unique_data.get("desc", "")
			udsc.modulate      = Color(1.0, 1.0, 1.0, 0.75)
			udsc.size          = Vector2(PW - 32.0, 30.0)
			udsc.position      = Vector2(16.0, sy + 24.0)
			udsc.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			inner.add_child(udsc)

			var u_items := _skill_item_textures(unique_data)
			if not u_items.is_empty():
				var uix : float = 16.0
				var uiy : float = sy + uniq_h - ITEM_SZ - 14.0
				for u_tex in u_items:
					if u_tex == null:
						continue
					var u_icon := TextureRect.new()
					u_icon.texture           = u_tex
					u_icon.expand_mode       = TextureRect.EXPAND_IGNORE_SIZE
					u_icon.stretch_mode      = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
					u_icon.size              = Vector2(ITEM_SZ, ITEM_SZ)
					u_icon.position          = Vector2(uix, uiy)
					u_icon.mouse_filter      = Control.MOUSE_FILTER_IGNORE
					inner.add_child(u_icon)
					uix += ITEM_SZ + ITEM_GAP
					if uix > PW - 24.0:
						break

	# Close button — wrapped in a Control so the press tween scales the whole
	# pill (bg + label) around its centre.
	var cly      : float = py + ph - CLOSE_H - CLOSE_PAD
	var close_w  : float = PW - 32.0
	var close_pos : Vector2 = Vector2(px + 16.0, cly)
	var close_visual := Control.new()
	close_visual.size         = Vector2(close_w, CLOSE_H)
	close_visual.position     = close_pos
	close_visual.pivot_offset = Vector2(close_w, CLOSE_H) * 0.5
	close_visual.mouse_filter = Control.MOUSE_FILTER_IGNORE
	popup_root.add_child(close_visual)

	var cbg := ColorRect.new()
	cbg.color        = Color(0.18, 0.06, 0.06, 0.92)
	cbg.size         = Vector2(close_w, CLOSE_H)
	cbg.position     = Vector2.ZERO
	cbg.mouse_filter = Control.MOUSE_FILTER_PASS
	close_visual.add_child(cbg)

	var clbl := Label.new()
	clbl.add_theme_font_override("font", UI_FONT)
	clbl.add_theme_font_size_override("font_size", 12)
	_apply_menu_caption_fx(clbl)
	clbl.text                 = "ЗАКРЫТЬ"
	clbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	clbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	clbl.modulate             = Color(1.0, 0.45, 0.45)
	clbl.size                 = Vector2(close_w, CLOSE_H)
	clbl.position             = Vector2.ZERO
	close_visual.add_child(clbl)

	var cbtn := Button.new()
	cbtn.flat       = true
	cbtn.focus_mode = Control.FOCUS_NONE
	cbtn.size       = Vector2(close_w, CLOSE_H)
	cbtn.position   = close_pos
	cbtn.pressed.connect(func():
		_play_btn_sfx()
		popup_root.queue_free()
	)
	cbtn.button_down.connect(_menu_btn_press_anim.bind(close_visual, true))
	cbtn.button_up.connect(_menu_btn_press_anim.bind(close_visual, false))
	cbtn.mouse_exited.connect(_menu_btn_press_anim.bind(close_visual, false))
	popup_root.add_child(cbtn)

func _show_skin_info_popup(skin_data: Dictionary, parent_overlay: Control) -> void:
	var vp      := get_viewport().get_visible_rect().size
	var skin_id := skin_data["id"] as String
	var name_ru := skin_data.get("name_ru", skin_id) as String
	var rarity  := skin_data.get("rarity", 0) as int
	var tex_dir := skin_data.get("tex_dir", "") as String
	var rc       = SkinRegistry.RARITY_COLORS[rarity]
	var skills  := SkinSkills.get_skills(skin_id)
	var unique  := SkinSkills.get_unique(skin_id)

	var cur_xp    : int
	var cur_level : int
	if skin_id == SaveData.active_skin:
		cur_xp    = SaveData.skin_xp
		cur_level = SaveData.skin_level
	else:
		var e = SaveData.skin_progress.get(skin_id, {"xp": 0, "level": 1})
		cur_xp    = e.get("xp",    0)
		cur_level = e.get("level", 1)

	var popup_root := Control.new()
	popup_root.size         = vp
	popup_root.mouse_filter = Control.MOUSE_FILTER_PASS
	parent_overlay.add_child(popup_root)

	var dim := ColorRect.new()
	dim.color        = Color(0.0, 0.0, 0.0, 0.65)
	dim.size         = vp
	dim.mouse_filter = Control.MOUSE_FILTER_STOP
	popup_root.add_child(dim)

	const PW         := 300.0
	const FAT_SZ     := 52.0
	const SKILL_ROW_H := 56.0
	const BADGE_SZ   := 22.0
	const IMG_SZ_SK  := 18.0
	# Уровень открытия каждого состояния жира считается по лестнице скина, а не
	# хардкодом [1,1,2,5]: три первых доступны сразу, четвёртое даёт 2-й уровень.
	var fat_unlock : Array = []
	for fi in 4:
		fat_unlock.append(_fat_unlock_level(fi, skin_id))
	var fat_names    := _FAT_NAMES

	var n_skills := skills.size()
	var has_uniq := not unique.is_empty()

	var ph : float = 46.0                               # header
	ph += 16.0 + FAT_SZ + 26.0                          # fat states section
	ph += 18.0 + 8.0 + 4.0 + 18.0                      # xp bar section
	if n_skills > 0 or has_uniq:
		ph += 6.0 + 1.0 + 8.0 + 16.0                    # divider + section label
		# Scroll area: show up to 2.5 rows worth, skills beyond that require scrolling
		var skill_area := float(n_skills) * (SKILL_ROW_H + 2.0) + (62.0 if has_uniq else 0.0)
		ph += minf(skill_area, 2.5 * (SKILL_ROW_H + 2.0) + 62.0)
	ph += 10.0 + 44.0                                   # padding + close button
	ph = clampf(ph, 200.0, vp.y - 24.0)

	var px := (vp.x - PW) * 0.5
	var py := (vp.y - ph) * 0.5

	var panel := ColorRect.new()
	panel.color        = Color(0.06, 0.04, 0.12, 0.97)
	panel.size         = Vector2(PW, ph)
	panel.position     = Vector2(px, py)
	panel.mouse_filter = Control.MOUSE_FILTER_PASS
	popup_root.add_child(panel)

	var top_stripe := ColorRect.new()
	top_stripe.color        = Color(rc.r, rc.g, rc.b, 0.90)
	top_stripe.size         = Vector2(PW, 3.0)
	top_stripe.position     = Vector2(px, py)
	top_stripe.mouse_filter = Control.MOUSE_FILTER_PASS
	popup_root.add_child(top_stripe)

	var hdr := Label.new()
	hdr.add_theme_font_override("font", UI_FONT)
	hdr.add_theme_font_size_override("font_size", 16)
	_apply_menu_caption_fx(hdr)
	hdr.text                 = name_ru
	hdr.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	hdr.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	hdr.modulate             = Color(rc.r, rc.g, rc.b)
	hdr.size                 = Vector2(PW, 34.0)
	hdr.position             = Vector2(px, py + 8.0)
	popup_root.add_child(hdr)

	var cy := py + 46.0

	# ── FAT STATES ──────────────────────────────────────────────────────────
	var fat_sec_lbl := Label.new()
	fat_sec_lbl.add_theme_font_override("font", UI_FONT)
	fat_sec_lbl.add_theme_font_size_override("font_size", 9)
	_apply_menu_caption_fx(fat_sec_lbl)
	fat_sec_lbl.text     = "ЖИРОВЫЕ СОСТОЯНИЯ"
	fat_sec_lbl.modulate = Color(1.0, 1.0, 1.0, 0.38)
	fat_sec_lbl.size     = Vector2(PW - 24.0, 14.0)
	fat_sec_lbl.position = Vector2(px + 12.0, cy)
	popup_root.add_child(fat_sec_lbl)
	cy += 16.0

	var state_total_w := FAT_SZ * 4.0 + 8.0 * 3.0
	var state_start_x := px + (PW - state_total_w) * 0.5
	for fi in 4:
		var sx          := state_start_x + fi * (FAT_SZ + 8.0)
		var is_unlocked = cur_level >= fat_unlock[fi]

		var st_icon := _skin_head_icon(skin_id, fi, FAT_SZ)
		st_icon.position = Vector2(sx, cy)
		if not is_unlocked:
			st_icon.modulate = Color(0.22, 0.22, 0.22, 0.55)
		popup_root.add_child(st_icon)

		var st_lbl := Label.new()
		st_lbl.add_theme_font_override("font", UI_FONT)
		st_lbl.add_theme_font_size_override("font_size", 7)
		_apply_menu_caption_fx(st_lbl)
		st_lbl.text                 = fat_names[fi]
		st_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		st_lbl.size                 = Vector2(FAT_SZ, 12.0)
		st_lbl.position             = Vector2(sx, cy + FAT_SZ + 2.0)
		st_lbl.modulate             = Color(rc.r, rc.g, rc.b, 0.90) if is_unlocked else Color(0.50, 0.50, 0.50, 0.55)
		popup_root.add_child(st_lbl)

		if not is_unlocked:
			var lock_lbl := Label.new()
			lock_lbl.add_theme_font_override("font", UI_FONT)
			lock_lbl.add_theme_font_size_override("font_size", 8)
			_apply_menu_caption_fx(lock_lbl)
			lock_lbl.text                 = "УР.%d" % fat_unlock[fi]
			lock_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			lock_lbl.modulate             = Color(0.70, 0.70, 0.70, 0.90)
			lock_lbl.size                 = Vector2(FAT_SZ, 14.0)
			lock_lbl.position             = Vector2(sx, cy + (FAT_SZ - 14.0) * 0.5)
			popup_root.add_child(lock_lbl)

	cy += FAT_SZ + 26.0

	# ── XP PROGRESS ─────────────────────────────────────────────────────────
	var is_mastery := cur_level >= 10
	var bar_pad    := 14.0
	var bar_x      := px + bar_pad
	var bar_w      := PW - bar_pad * 2.0
	var bar_h      := 8.0

	var lvl_str2 := "МАСТЕРСТВО" if is_mastery else "УР. %d" % cur_level
	var lvl_lbl2 := Label.new()
	lvl_lbl2.add_theme_font_override("font", UI_FONT)
	lvl_lbl2.add_theme_font_size_override("font_size", 10)
	_apply_menu_caption_fx(lvl_lbl2)
	lvl_lbl2.text                 = lvl_str2
	lvl_lbl2.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	lvl_lbl2.modulate             = Color(0.50, 0.80, 1.0)
	lvl_lbl2.size                 = Vector2(bar_w, 16.0)
	lvl_lbl2.position             = Vector2(bar_x, cy)
	popup_root.add_child(lvl_lbl2)
	cy += 18.0

	var progress_val : float
	if is_mastery:
		var over := cur_xp - SaveData.LEVEL_XP[9]
		progress_val = float(over % SaveData.MASTERY_XP_PER_TOKEN) / float(SaveData.MASTERY_XP_PER_TOKEN)
	else:
		var from_xp = SaveData.LEVEL_XP[cur_level - 1]
		var to_xp   = SaveData.LEVEL_XP[cur_level]
		progress_val = float(cur_xp - from_xp) / float(to_xp - from_xp)
	progress_val = clampf(progress_val, 0.0, 1.0)

	var bar_bg_r := ColorRect.new()
	bar_bg_r.color        = Color(0.11, 0.11, 0.16, 1.0)
	bar_bg_r.size         = Vector2(bar_w, bar_h)
	bar_bg_r.position     = Vector2(bar_x, cy)
	bar_bg_r.mouse_filter = Control.MOUSE_FILTER_PASS
	popup_root.add_child(bar_bg_r)

	var fill_w2    := maxf(4.0, bar_w * progress_val)
	var bar_fill_r := ColorRect.new()
	bar_fill_r.color        = Color(0.22, 0.58, 1.0)
	bar_fill_r.size         = Vector2(fill_w2, bar_h)
	bar_fill_r.position     = Vector2(bar_x, cy)
	bar_fill_r.mouse_filter = Control.MOUSE_FILTER_PASS
	popup_root.add_child(bar_fill_r)

	var shim_r := ColorRect.new()
	shim_r.color        = Color(1.0, 1.0, 1.0, 0.18)
	shim_r.size         = Vector2(fill_w2, 3.0)
	shim_r.position     = Vector2(bar_x, cy)
	shim_r.mouse_filter = Control.MOUSE_FILTER_PASS
	popup_root.add_child(shim_r)
	cy += bar_h + 4.0

	var xp_sub_str : String
	if is_mastery:
		var over2    := cur_xp - SaveData.LEVEL_XP[9]
		var in_cycle := over2 % SaveData.MASTERY_XP_PER_TOKEN
		xp_sub_str = "МАСТЕРСТВО: %d / %d XP" % [in_cycle, SaveData.MASTERY_XP_PER_TOKEN]
	else:
		var from_xp2 = SaveData.LEVEL_XP[cur_level - 1]
		var to_xp2   = SaveData.LEVEL_XP[cur_level]
		xp_sub_str = "%d / %d XP до ур. %d" % [cur_xp - from_xp2, to_xp2 - from_xp2, cur_level + 1]

	var xp_sub_lbl := Label.new()
	xp_sub_lbl.add_theme_font_override("font", UI_FONT)
	xp_sub_lbl.add_theme_font_size_override("font_size", 9)
	_apply_menu_caption_fx(xp_sub_lbl)
	xp_sub_lbl.text     = xp_sub_str
	xp_sub_lbl.modulate = Color(0.55, 0.70, 0.90, 0.80)
	xp_sub_lbl.size     = Vector2(bar_w, 14.0)
	xp_sub_lbl.position = Vector2(bar_x, cy)
	popup_root.add_child(xp_sub_lbl)
	cy += 18.0

	# ── SKILLS (scrollable) ─────────────────────────────────────────────────
	if n_skills > 0 or has_uniq:
		cy += 6.0
		var sep_r := ColorRect.new()
		sep_r.color        = Color(1.0, 1.0, 1.0, 0.10)
		sep_r.size         = Vector2(PW - 28.0, 1.0)
		sep_r.position     = Vector2(px + 14.0, cy)
		sep_r.mouse_filter = Control.MOUSE_FILTER_PASS
		popup_root.add_child(sep_r)
		cy += 8.0

		var sec_lbl2 := Label.new()
		sec_lbl2.add_theme_font_override("font", UI_FONT)
		sec_lbl2.add_theme_font_size_override("font_size", 9)
		_apply_menu_caption_fx(sec_lbl2)
		sec_lbl2.text     = "НАВЫКИ" if n_skills > 0 else "НЕТ НАВЫКОВ"
		sec_lbl2.modulate = Color(1.0, 1.0, 1.0, 0.38)
		sec_lbl2.size     = Vector2(PW - 24.0, 14.0)
		sec_lbl2.position = Vector2(px + 12.0, cy)
		popup_root.add_child(sec_lbl2)
		cy += 16.0

		# Compute total content height for inner control
		var skill_content_h := float(n_skills) * (SKILL_ROW_H + 2.0)
		if has_uniq:
			skill_content_h += 4.0 + 58.0
		skill_content_h += 4.0  # bottom padding

		# Visible height = space between current cy and the close button
		var scroll_visible_h := (py + ph) - 44.0 - 4.0 - cy
		scroll_visible_h = maxf(40.0, scroll_visible_h)

		var scroll_con := ScrollContainer.new()
		scroll_con.position               = Vector2(px, cy)
		scroll_con.size                   = Vector2(PW, scroll_visible_h)
		scroll_con.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
		scroll_con.vertical_scroll_mode   = ScrollContainer.SCROLL_MODE_SHOW_NEVER
		scroll_con.mouse_filter           = Control.MOUSE_FILTER_PASS
		scroll_con.set("scroll_deadzone", 10)
		popup_root.add_child(scroll_con)

		var scroll_inner := Control.new()
		scroll_inner.custom_minimum_size = Vector2(PW, skill_content_h)
		scroll_inner.mouse_filter        = Control.MOUSE_FILTER_PASS
		scroll_con.add_child(scroll_inner)

		var type_chars3  := {SkinSkills.DODGE:"У", SkinSkills.ADAPT:"А",
							 SkinSkills.COUNTER:"К", SkinSkills.TRANSFORM:"Т"}
		var type_colors3 := {SkinSkills.DODGE:Color(0.20,0.60,1.00), SkinSkills.ADAPT:Color(1.00,0.78,0.15),
							 SkinSkills.COUNTER:Color(1.00,0.42,0.10), SkinSkills.TRANSFORM:Color(0.25,0.90,0.45)}

		var sy := 0.0  # y cursor relative to scroll_inner

		for sk in skills:
			var stype := sk["type"] as String
			var sclr  := type_colors3.get(stype, Color(0.6,0.6,0.6)) as Color
			var sch   := type_chars3.get(stype, "?") as String

			var rbg3 := ColorRect.new()
			rbg3.color        = Color(sclr.r, sclr.g, sclr.b, 0.07)
			rbg3.size         = Vector2(PW - 16.0, SKILL_ROW_H - 2.0)
			rbg3.position     = Vector2(8.0, sy + 1.0)
			rbg3.mouse_filter = Control.MOUSE_FILTER_PASS
			scroll_inner.add_child(rbg3)

			var bbg3 := ColorRect.new()
			bbg3.color        = Color(sclr.r, sclr.g, sclr.b, 0.22)
			bbg3.size         = Vector2(BADGE_SZ, BADGE_SZ)
			bbg3.position     = Vector2(12.0, sy + (SKILL_ROW_H - BADGE_SZ) * 0.5)
			bbg3.mouse_filter = Control.MOUSE_FILTER_PASS
			scroll_inner.add_child(bbg3)

			var blbl3 := Label.new()
			blbl3.add_theme_font_override("font", UI_FONT)
			blbl3.add_theme_font_size_override("font_size", 10)
			_apply_menu_caption_fx(blbl3)
			blbl3.text                 = sch
			blbl3.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			blbl3.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
			blbl3.modulate             = sclr
			blbl3.size                 = Vector2(BADGE_SZ, BADGE_SZ)
			blbl3.position             = Vector2(12.0, sy + (SKILL_ROW_H - BADGE_SZ) * 0.5)
			scroll_inner.add_child(blbl3)

			var textures3 := _skill_item_textures(sk)
			var max_imgs3 := mini(textures3.size(), 4)
			var imgs_x3   := 12.0 + BADGE_SZ + 6.0
			for ii in max_imgs3:
				var ir := _make_icon(textures3[ii], IMG_SZ_SK)
				ir.position = Vector2(imgs_x3 + ii * (IMG_SZ_SK + 3.0), sy + 4.0)
				scroll_inner.add_child(ir)

			var desc_w := PW - 16.0 - BADGE_SZ - 18.0
			var desc_h := SKILL_ROW_H - 4.0 - IMG_SZ_SK - 8.0
			var desc_lbl3 := Label.new()
			desc_lbl3.add_theme_font_override("font", UI_FONT)
			desc_lbl3.add_theme_font_size_override("font_size", 8)
			_apply_menu_caption_fx(desc_lbl3)
			desc_lbl3.text          = _skill_mechanic_desc(sk)
			desc_lbl3.modulate      = Color(1.0, 1.0, 1.0, 0.75)
			desc_lbl3.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			desc_lbl3.size          = Vector2(desc_w, desc_h)
			desc_lbl3.position      = Vector2(12.0 + BADGE_SZ + 6.0, sy + 4.0 + IMG_SZ_SK + 4.0)
			scroll_inner.add_child(desc_lbl3)
			desc_lbl3.size = Vector2(desc_w, desc_h)

			sy += SKILL_ROW_H + 2.0

		if has_uniq:
			sy += 4.0
			var ubg3 := ColorRect.new()
			ubg3.color        = Color(rc.r * 0.12, rc.g * 0.12, rc.b * 0.12, 0.95)
			ubg3.size         = Vector2(PW - 16.0, 50.0)
			ubg3.position     = Vector2(8.0, sy)
			ubg3.mouse_filter = Control.MOUSE_FILTER_PASS
			scroll_inner.add_child(ubg3)

			var ust3 := ColorRect.new()
			ust3.color        = Color(rc.r, rc.g, rc.b, 0.70)
			ust3.size         = Vector2(3.0, 50.0)
			ust3.position     = Vector2(8.0, sy)
			ust3.mouse_filter = Control.MOUSE_FILTER_PASS
			scroll_inner.add_child(ust3)

			var sstar3 := Label.new()
			sstar3.add_theme_font_override("font", UI_FONT)
			sstar3.add_theme_font_size_override("font_size", 11)
			sstar3.text               = "★"
			sstar3.modulate           = Color(rc.r, rc.g, rc.b)
			sstar3.size               = Vector2(20.0, 50.0)
			sstar3.position           = Vector2(14.0, sy)
			sstar3.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
			scroll_inner.add_child(sstar3)

			var unm3 := Label.new()
			unm3.add_theme_font_override("font", UI_FONT)
			unm3.add_theme_font_size_override("font_size", 9)
			unm3.text     = unique.get("label", "")
			unm3.modulate = Color(rc.r, rc.g, rc.b, 0.95)
			unm3.size     = Vector2(PW - 46.0, 14.0)
			unm3.position = Vector2(34.0, sy + 4.0)
			scroll_inner.add_child(unm3)

			var udsc3 := Label.new()
			udsc3.add_theme_font_override("font", UI_FONT)
			udsc3.add_theme_font_size_override("font_size", 8)
			udsc3.text          = unique.get("desc", "")
			udsc3.modulate      = Color(1.0, 1.0, 1.0, 0.68)
			udsc3.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			udsc3.size          = Vector2(PW - 46.0, 30.0)
			udsc3.position      = Vector2(34.0, sy + 18.0)
			scroll_inner.add_child(udsc3)
			udsc3.size = Vector2(PW - 46.0, 30.0)

	# ── CLOSE BUTTON ────────────────────────────────────────────────────────
	var info_cly := py + ph - 44.0
	var info_cbg := ColorRect.new()
	info_cbg.color        = Color(0.18, 0.06, 0.06, 0.92)
	info_cbg.size         = Vector2(PW - 32.0, 30.0)
	info_cbg.position     = Vector2(px + 16.0, info_cly)
	info_cbg.mouse_filter = Control.MOUSE_FILTER_PASS
	popup_root.add_child(info_cbg)

	var info_clbl := Label.new()
	info_clbl.add_theme_font_override("font", UI_FONT)
	info_clbl.add_theme_font_size_override("font_size", 12)
	info_clbl.text                 = "ЗАКРЫТЬ"
	info_clbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	info_clbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	info_clbl.modulate             = Color(1.0, 0.45, 0.45)
	info_clbl.size                 = Vector2(PW - 32.0, 30.0)
	info_clbl.position             = Vector2(px + 16.0, info_cly)
	popup_root.add_child(info_clbl)

	var info_cbtn := Button.new()
	info_cbtn.flat       = true
	info_cbtn.focus_mode = Control.FOCUS_NONE
	info_cbtn.size       = Vector2(PW - 32.0, 30.0)
	info_cbtn.position   = Vector2(px + 16.0, info_cly)
	info_cbtn.pressed.connect(func():
		_play_btn_sfx()
		popup_root.queue_free()
	)
	popup_root.add_child(info_cbtn)


func _build_shop_card(hbox: HBoxContainer, skin_data: Dictionary,
		cw: float, ch: float, vp_pad: float, overlay: Control, dlr_lbl: Label,
		scroll: ScrollContainer, from_slots: bool = false) -> void:
	var skin_id  : String = skin_data["id"]
	var name_ru  : String = skin_data.get("name_ru", skin_id)
	var rarity   : int    = skin_data.get("rarity", 0)
	var price    : int    = skin_data.get("price", 0)
	var tex_dir  : String = skin_data.get("tex_dir", "")
	var rc       : Color  = SkinRegistry.RARITY_COLORS[rarity]

	var is_owned  := SaveData.owns_skin(skin_id)
	var is_active := SaveData.active_skin == skin_id
	var can_buy   := not is_owned and SaveData.dollars >= price

	# Wrapper fills slot height so v_pad works
	var wrapper := Control.new()
	wrapper.custom_minimum_size = Vector2(cw, ch + vp_pad * 2.0)
	wrapper.mouse_filter        = Control.MOUSE_FILTER_PASS
	hbox.add_child(wrapper)

	# Card background
	var card := ColorRect.new()
	card.color        = Color(0.07, 0.06, 0.10, 0.97)
	card.size         = Vector2(cw, ch)
	card.position     = Vector2(0.0, vp_pad)
	card.mouse_filter = Control.MOUSE_FILTER_PASS
	wrapper.add_child(card)

	# Active glow
	if is_active:
		var glow := ColorRect.new()
		glow.color        = Color(rc.r, rc.g, rc.b, 0.15)
		glow.size         = Vector2(cw, ch)
		glow.position     = Vector2(0.0, vp_pad)
		glow.mouse_filter = Control.MOUSE_FILTER_PASS
		wrapper.add_child(glow)

	# Rarity stripe
	var stripe := ColorRect.new()
	stripe.color        = Color(rc.r, rc.g, rc.b, 0.92)
	stripe.size         = Vector2(cw, 3.0)
	stripe.position     = Vector2(0.0, vp_pad)
	stripe.mouse_filter = Control.MOUSE_FILTER_PASS
	wrapper.add_child(stripe)

	# Avatar
	var avatar_tex : Texture2D
	if tex_dir.is_empty():
		avatar_tex = FAT_TEXTURES[0]
	elif ResourceLoader.exists(tex_dir + "state1.png"):
		avatar_tex = load(tex_dir + "state1.png") as Texture2D
	else:
		avatar_tex = FAT_TEXTURES[0]

	const AV := 78.0
	var av := _make_icon(avatar_tex, AV)
	av.position = Vector2((cw - AV) * 0.5, vp_pad + 10.0)
	wrapper.add_child(av)

	# Name (Russo One)
	var name_lbl := Label.new()
	name_lbl.add_theme_font_override("font", UI_FONT)
	name_lbl.add_theme_font_size_override("font_size", 13)
	_apply_menu_caption_fx(name_lbl)
	name_lbl.text                 = name_ru
	name_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_lbl.modulate             = Color(1.0, 1.0, 1.0, 0.95)
	name_lbl.size                 = Vector2(cw, 20.0)
	name_lbl.position             = Vector2(0.0, vp_pad + 10.0 + AV + 4.0)
	wrapper.add_child(name_lbl)

	# Rarity
	var rar_lbl := Label.new()
	rar_lbl.add_theme_font_override("font", UI_FONT)
	rar_lbl.add_theme_font_size_override("font_size", 11)
	_apply_menu_caption_fx(rar_lbl)
	rar_lbl.text                 = SkinRegistry.RARITY_NAMES[rarity]
	rar_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	rar_lbl.modulate             = Color(rc.r, rc.g, rc.b, 0.85)
	rar_lbl.size                 = Vector2(cw, 16.0)
	rar_lbl.position             = Vector2(0.0, vp_pad + 10.0 + AV + 26.0)
	wrapper.add_child(rar_lbl)

	# Divider
	var div := ColorRect.new()
	div.color        = Color(1.0, 1.0, 1.0, 0.07)
	div.size         = Vector2(cw - 20.0, 1.0)
	div.position     = Vector2(10.0, vp_pad + 10.0 + AV + 46.0)
	div.mouse_filter = Control.MOUSE_FILTER_PASS
	wrapper.add_child(div)

	# ── "?" tap icon — top-right corner of the card, opens detail popup ────
	# Visuals are wrapped in a Control so the press-shrink tween scales the
	# whole button (bg + top stripe + label) around its centre.
	const Q_SZ : float = 22.0
	var q_visual := Control.new()
	q_visual.size         = Vector2(Q_SZ, Q_SZ)
	q_visual.position     = Vector2(cw - Q_SZ - 8.0, vp_pad + 8.0)
	q_visual.pivot_offset = Vector2(Q_SZ, Q_SZ) * 0.5
	q_visual.mouse_filter = Control.MOUSE_FILTER_IGNORE
	wrapper.add_child(q_visual)

	var q_bg := ColorRect.new()
	q_bg.color        = Color(0.55, 0.45, 0.90, 0.22)
	q_bg.size         = Vector2(Q_SZ, Q_SZ)
	q_bg.position     = Vector2.ZERO
	q_bg.mouse_filter = Control.MOUSE_FILTER_PASS
	q_visual.add_child(q_bg)

	var q_stripe := ColorRect.new()
	q_stripe.color        = Color(0.55, 0.45, 0.90, 0.80)
	q_stripe.size         = Vector2(Q_SZ, 2.0)
	q_stripe.position     = Vector2.ZERO
	q_stripe.mouse_filter = Control.MOUSE_FILTER_PASS
	q_visual.add_child(q_stripe)

	var q_lbl := Label.new()
	q_lbl.add_theme_font_override("font", UI_FONT)
	q_lbl.add_theme_font_size_override("font_size", 14)
	_apply_menu_caption_fx(q_lbl)
	q_lbl.text                 = "?"
	q_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	q_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	q_lbl.modulate             = Color(0.85, 0.75, 1.0)
	q_lbl.size                 = Vector2(Q_SZ, Q_SZ)
	q_lbl.position             = Vector2.ZERO
	q_lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	q_visual.add_child(q_lbl)

	var q_btn := Button.new()
	q_btn.flat       = true
	q_btn.focus_mode = Control.FOCUS_NONE
	q_btn.size       = Vector2(Q_SZ, Q_SZ)
	q_btn.position   = q_visual.position
	q_btn.pressed.connect(func():
		_play_btn_sfx()
		_show_skill_detail_popup(skin_data, overlay)
	)
	q_btn.button_down.connect(_menu_btn_press_anim.bind(q_visual, true))
	q_btn.button_up.connect(_menu_btn_press_anim.bind(q_visual, false))
	q_btn.mouse_exited.connect(_menu_btn_press_anim.bind(q_visual, false))
	wrapper.add_child(q_btn)

	# ── XP bar row (owned skins only) — level tags above the bar's left/right
	# edges, the bar itself underneath, and a chest sprite on the far right.
	# Sprite swaps between locked / ready, with a pulse at mastery (level ≥ 10).
	var content_y := vp_pad + 10.0 + AV + 52.0
	if is_owned:
		const XP_LBL_H : float = 12.0
		const XP_BAR_H : float = 8.0
		const XP_BAR_GAP : float = 3.0
		const XP_ROW_H : float = XP_LBL_H + XP_BAR_GAP + XP_BAR_H + 4.0
		const CHEST_SZ : float = 24.0
		var bar_left  : float = 10.0
		var bar_right : float = cw - 8.0 - CHEST_SZ - 6.0
		var bar_w : float = bar_right - bar_left
		var bar_y : float = content_y + XP_LBL_H + XP_BAR_GAP

		var card_lvl : int = SaveData.get_skin_level_for(skin_id)
		var ready    : bool = card_lvl >= 10
		var next_lvl : int  = mini(card_lvl + 1, 10)

		# Left tag — current level above the bar's left edge.
		var cur_tag := Label.new()
		cur_tag.add_theme_font_override("font", UI_FONT)
		cur_tag.add_theme_font_size_override("font_size", 8)
		_apply_menu_caption_fx(cur_tag)
		cur_tag.text                 = "★" if ready else "ур.%d" % card_lvl
		cur_tag.modulate             = Color(0.55, 0.85, 1.0)
		cur_tag.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		cur_tag.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
		cur_tag.size                 = Vector2(40.0, XP_LBL_H)
		cur_tag.position             = Vector2(bar_left, content_y)
		wrapper.add_child(cur_tag)

		# Right tag — next-level target above the bar's right edge (★ at mastery).
		var next_tag := Label.new()
		next_tag.add_theme_font_override("font", UI_FONT)
		next_tag.add_theme_font_size_override("font_size", 8)
		_apply_menu_caption_fx(next_tag)
		next_tag.text                 = "★" if ready else "ур.%d" % next_lvl
		next_tag.modulate             = Color(0.85, 0.95, 1.0)
		next_tag.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		next_tag.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
		next_tag.size                 = Vector2(40.0, XP_LBL_H)
		next_tag.position             = Vector2(bar_right - 40.0, content_y)
		wrapper.add_child(next_tag)

		var bar_bg := ColorRect.new()
		bar_bg.color    = Color(0.10, 0.10, 0.10, 0.85)
		bar_bg.size     = Vector2(bar_w, XP_BAR_H)
		bar_bg.position = Vector2(bar_left, bar_y)
		wrapper.add_child(bar_bg)

		var bar_fill := ColorRect.new()
		bar_fill.color    = Color(0.45, 0.80, 1.0)
		bar_fill.size     = Vector2(bar_w * SaveData.xp_level_progress_for(skin_id), XP_BAR_H - 2.0)
		bar_fill.position = Vector2(bar_left, bar_y + 1.0)
		wrapper.add_child(bar_fill)

		var chest_pos := Vector2(cw - CHEST_SZ - 4.0, content_y + (XP_ROW_H - CHEST_SZ) * 0.5)
		var chest_root := _draw_shop_card_chest(wrapper, chest_pos, CHEST_SZ, ready)
		if ready:
			var tw_pulse := chest_root.create_tween().set_loops()
			tw_pulse.tween_property(chest_root, "scale", Vector2(1.18, 1.18), 0.55)\
				.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
			tw_pulse.tween_property(chest_root, "scale", Vector2.ONE, 0.55)\
				.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

		var chest_hit := Button.new()
		chest_hit.flat       = true
		chest_hit.focus_mode = Control.FOCUS_NONE
		chest_hit.size       = Vector2(CHEST_SZ + 12.0, CHEST_SZ + 12.0)
		chest_hit.position   = chest_pos - Vector2(6.0, 6.0)
		chest_hit.pressed.connect(func():
			_play_btn_sfx()
			_show_skin_levels_popup(overlay, skin_id)
		)
		chest_hit.button_down.connect(_menu_btn_press_anim.bind(chest_root, true))
		chest_hit.button_up.connect(_menu_btn_press_anim.bind(chest_root, false))
		chest_hit.mouse_exited.connect(_menu_btn_press_anim.bind(chest_root, false))
		wrapper.add_child(chest_hit)

		content_y += XP_ROW_H + 6.0

	# ── Skills list — scrollable area, one section per skill (+ unique) ─────
	var skills_list := SkinSkills.get_skills(skin_id)
	var unique_data := SkinSkills.get_unique(skin_id)
	const SK_LABEL_H : float = 14.0
	const SK_ROW_H   : float = 18.0
	const SK_GAP     : float = 3.0
	const SK_DESC_H  : float = 26.0   # extra room for the unique-ability description text
	const SK_ICON_SZ : float = 16.0
	const SK_ICON_GAP: float = 2.0
	# Stretch the scroll viewport to use every spare pixel between the XP row
	# and the bottom action button — otherwise the unique-ability line gets
	# pushed below the visible window and a black gap appears under it.
	const SK_BTN_H : float = 34.0
	var sk_btn_top : float = vp_pad + ch - SK_BTN_H - 10.0
	var SK_AREA_H  : float = sk_btn_top - 4.0 - content_y
	if not is_owned:
		SK_AREA_H -= 34.0   # leave room for the price label between skills + button
	SK_AREA_H = maxf(80.0, SK_AREA_H)
	var skill_scroll := ScrollContainer.new()
	# Attach the auto-scroll script so the list ping-pongs between top and
	# bottom as ambient motion. Manual drag pauses the loop (see script).
	skill_scroll.set_script(preload("res://scripts/card_skill_autoscroll.gd"))
	skill_scroll.size                   = Vector2(cw - 4.0, SK_AREA_H)
	skill_scroll.position               = Vector2(2.0, content_y)
	skill_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	# Hide the vertical scrollbar — looks bad inside the narrow card.
	skill_scroll.vertical_scroll_mode   = ScrollContainer.SCROLL_MODE_SHOW_NEVER
	skill_scroll.mouse_filter           = Control.MOUSE_FILTER_PASS
	# Same deadzone trick — tap on a skill row should still open the popup,
	# but a real drag scrolls the list.
	skill_scroll.set("scroll_deadzone", 10)
	wrapper.add_child(skill_scroll)

	var skill_content := Control.new()
	skill_content.custom_minimum_size = Vector2(cw - 4.0, 0.0)
	skill_content.mouse_filter        = Control.MOUSE_FILTER_PASS
	skill_scroll.add_child(skill_content)

	var inner_y := 0.0
	for sk in skills_list:
		_render_skill_row(skill_content, inner_y, cw,
				_skill_type_name(sk["type"]),
				_skill_type_color(sk["type"]),
				_skill_item_textures(sk), "")
		inner_y += SK_LABEL_H + SK_ROW_H + SK_GAP

	if not unique_data.is_empty():
		var uniq_desc : String = str(unique_data.get("desc", ""))
		_render_skill_row(skill_content, inner_y, cw,
				"Уникальная способность", rc,
				_skill_item_textures(unique_data), uniq_desc)
		# Extra rows: text label + optional desc text below the icons row.
		inner_y += SK_LABEL_H + SK_ROW_H + SK_GAP
		if uniq_desc != "":
			inner_y += SK_DESC_H

	skill_content.custom_minimum_size = Vector2(cw - 4.0, inner_y + 4.0)

	# (Removed) Tap-anywhere-on-skills overlay — Button absorbed touch events
	# and broke drag-to-scroll on mobile. The "?" chip in the card's top-right
	# corner still opens the full detail popup, so the entry point is intact.

	content_y += SK_AREA_H
	var mid_y : float = content_y + 4.0

	# Price / ownership info (middle zone) — Russo One throughout.
	# "ПОЛУЧЕН" label removed: ownership is now signalled by the section
	# header ("МОИ СКИНЫ" vs "МАГАЗИН") and the bottom action button
	# (АКТИВЕН / НАДЕТЬ / КУПИТЬ).
	if not is_owned:
		var price_lbl := Label.new()
		price_lbl.add_theme_font_override("font", UI_FONT)
		price_lbl.add_theme_font_size_override("font_size", 18)
		_apply_menu_caption_fx(price_lbl)
		price_lbl.text                 = "%d $" % price
		price_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		price_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
		price_lbl.modulate             = Color(1.0, 0.88, 0.35) if can_buy else Color(0.40, 0.40, 0.45)
		price_lbl.size                 = Vector2(cw, 28.0)
		price_lbl.position             = Vector2(0.0, mid_y)
		wrapper.add_child(price_lbl)

	# Bottom action area
	var btn_h := 34.0
	var btn_y := vp_pad + ch - btn_h - 10.0

	if is_active:
		var badge := ColorRect.new()
		badge.color        = Color(rc.r * 0.20, rc.g * 0.20, rc.b * 0.20, 0.95)
		badge.size         = Vector2(cw - 16.0, btn_h)
		badge.position     = Vector2(8.0, btn_y)
		badge.mouse_filter = Control.MOUSE_FILTER_PASS
		wrapper.add_child(badge)

		var badge_stripe := ColorRect.new()
		badge_stripe.color        = Color(rc.r, rc.g, rc.b, 0.70)
		badge_stripe.size         = Vector2(cw - 16.0, 2.0)
		badge_stripe.position     = Vector2(8.0, btn_y)
		badge_stripe.mouse_filter = Control.MOUSE_FILTER_PASS
		wrapper.add_child(badge_stripe)

		var badge_lbl := Label.new()
		badge_lbl.add_theme_font_override("font", UI_FONT)
		badge_lbl.add_theme_font_size_override("font_size", 13)
		_apply_menu_caption_fx(badge_lbl)
		badge_lbl.text                 = "АКТИВЕН"
		badge_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		badge_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
		badge_lbl.modulate             = Color(rc.r, rc.g, rc.b, 1.0)
		badge_lbl.size                 = Vector2(cw - 16.0, btn_h)
		badge_lbl.position             = Vector2(8.0, btn_y)
		wrapper.add_child(badge_lbl)

	elif is_owned:
		var eq_btn := Button.new()
		eq_btn.add_theme_font_override("font", UI_FONT)
		eq_btn.add_theme_font_size_override("font_size", 13)
		eq_btn.focus_mode = Control.FOCUS_NONE
		eq_btn.text     = "НАДЕТЬ"
		eq_btn.size     = Vector2(cw - 16.0, btn_h)
		eq_btn.position = Vector2(8.0, btn_y)
		eq_btn.pressed.connect(func():
			_play_btn_sfx()
			SaveData.set_active_skin(skin_id)
			_refresh_fat_icons()
			var normaldo := get_parent().get_node_or_null("Normaldo")
			if normaldo and normaldo.has_method("reload_skin"):
				normaldo.reload_skin()
			# When shop opened from slots, no camera pan to reverse.
			if from_slots:
				overlay.queue_free()
				return
			# Camera-pan back UP — slide shop down off-screen while the menu
			# overlay AND scene siblings drop back into view. Mirrors the back
			# button's close path so the scene isn't left mid-pan.
			var vp_close := get_viewport().get_visible_rect().size
			var tw_close := create_tween()
			tw_close.tween_property(overlay, "position", Vector2(0.0, vp_close.y), 0.45)\
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
			tw_close.tween_callback(func():
				if is_instance_valid(overlay):
					overlay.queue_free()
				# Refresh the menu so the new avatar shows immediately. The
				# previous _menu_overlay is back at y=0 by now via the pan,
				# so freeing + rebuilding feels seamless.
				var old_overlay := _menu_overlay
				if old_overlay and is_instance_valid(old_overlay):
					old_overlay.queue_free()
				_menu_overlay = null
				_menu_tapped = false
				_show_menu()
			)
			_on_skins_close_anim_start(0.45, Tween.TRANS_QUAD, Tween.EASE_IN)
		)
		wrapper.add_child(eq_btn)

	elif can_buy:
		var buy_bg := ColorRect.new()
		buy_bg.color        = Color(0.05, 0.16, 0.06, 0.92)
		buy_bg.size         = Vector2(cw - 16.0, btn_h)
		buy_bg.position     = Vector2(8.0, btn_y)
		buy_bg.mouse_filter = Control.MOUSE_FILTER_PASS
		wrapper.add_child(buy_bg)

		var buy_stripe := ColorRect.new()
		buy_stripe.color        = Color(0.35, 0.85, 0.40, 0.70)
		buy_stripe.size         = Vector2(cw - 16.0, 2.0)
		buy_stripe.position     = Vector2(8.0, btn_y)
		buy_stripe.mouse_filter = Control.MOUSE_FILTER_PASS
		wrapper.add_child(buy_stripe)

		var buy_lbl := Label.new()
		buy_lbl.add_theme_font_override("font", UI_FONT)
		buy_lbl.add_theme_font_size_override("font_size", 13)
		_apply_menu_caption_fx(buy_lbl)
		buy_lbl.text                 = "КУПИТЬ"
		buy_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		buy_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
		buy_lbl.modulate             = Color(0.50, 1.00, 0.55)
		buy_lbl.size                 = Vector2(cw - 16.0, btn_h)
		buy_lbl.position             = Vector2(8.0, btn_y)
		wrapper.add_child(buy_lbl)

		var buy_btn := Button.new()
		buy_btn.flat     = true
		buy_btn.focus_mode = Control.FOCUS_NONE
		buy_btn.size     = Vector2(cw - 16.0, btn_h)
		buy_btn.position = Vector2(8.0, btn_y)
		buy_btn.pressed.connect(func():
			_play_btn_sfx()
			if SaveData.buy_skin(skin_id):
				QuestManager.notify_skin_bought()
				var saved_scroll := scroll.scroll_horizontal
				overlay.queue_free()
				# Shop is already on-screen and the scene siblings are already
				# panned up — skip the open animation to avoid double-panning,
				# which would launch the scene off-screen and leave the menu
				# floating over an empty backdrop on close.
				_show_shop(saved_scroll, from_slots, true)
		)
		wrapper.add_child(buy_btn)

	else:
		var lock_bg := ColorRect.new()
		lock_bg.color        = Color(0.12, 0.08, 0.08, 0.75)
		lock_bg.size         = Vector2(cw - 16.0, btn_h)
		lock_bg.position     = Vector2(8.0, btn_y)
		lock_bg.mouse_filter = Control.MOUSE_FILTER_PASS
		wrapper.add_child(lock_bg)

		var lock_lbl := Label.new()
