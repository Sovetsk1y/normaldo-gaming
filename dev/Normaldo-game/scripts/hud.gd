# Scene nodes that ride along when the "camera pans" between the main menu
# and the quests screen. Picked up by name from the Game parent.
const _SCENE_PAN_NODES : Array[String] = ["Background", "Couch", "Spawner"]

# Original positions of every node touched by the pan, captured the first time
# we pan-open. Lets `_snap_scene_to_home()` restore them if `_start_game()`
# fires mid-pan — otherwise scene nodes get frozen halfway up/down and the
# player drops into a run with half the screen black.
var _scene_home_positions : Dictionary = {}
var _scene_pan_tween      : Tween      = null

# "Camera pans DOWN": the menu UI slides up off-screen, the scene (room) also
# slides up so the player feels like the camera moved down to reveal the
# quests-screen room sitting below. Quests handles its own half of the slide
# (rising from below) — this method only handles the menu + scene siblings.
func _on_quests_open_anim_start(duration: float, trans: int, ease_kind: int) -> void:
	if not is_instance_valid(_menu_overlay):
		return
	_capture_scene_homes()
	var vp := get_viewport().get_visible_rect().size
	_menu_overlay.position = Vector2.ZERO
	if _scene_pan_tween and _scene_pan_tween.is_valid():
		_scene_pan_tween.kill()
	var tw := create_tween().set_parallel(true)
	_scene_pan_tween = tw
	tw.tween_property(_menu_overlay, "position", Vector2(0.0, -vp.y), duration)\
		.set_trans(trans).set_ease(ease_kind)
	_pan_scene_nodes(tw, -vp.y, duration, trans, ease_kind, true)

# Reverse pan: menu UI drops back down into view, scene slides back down too.
func _on_quests_close_anim_start(duration: float, trans: int, ease_kind: int) -> void:
	if not is_instance_valid(_menu_overlay):
		return
	var vp := get_viewport().get_visible_rect().size
	_menu_overlay.position = Vector2(0.0, -vp.y)
	if _scene_pan_tween and _scene_pan_tween.is_valid():
		_scene_pan_tween.kill()
	var tw := create_tween().set_parallel(true)
	_scene_pan_tween = tw
	tw.tween_property(_menu_overlay, "position", Vector2.ZERO, duration)\
		.set_trans(trans).set_ease(ease_kind)
	_pan_scene_nodes(tw, vp.y, duration, trans, ease_kind, false)

# Snapshot of scene-node home positions, captured the first time we pan-open
# (scene is guaranteed to be at home then). The snapshot is reused by
# `_snap_scene_to_home()` to undo any half-finished pan when the player taps
# "play" mid-animation.
func _capture_scene_homes() -> void:
	if not _scene_home_positions.is_empty():
		return
	var parent := get_parent()
	if parent == null:
		return
	for nm in _SCENE_PAN_NODES:
		var n := parent.get_node_or_null(nm) as Node2D
		if n != null:
			_scene_home_positions[nm] = n.position
	var tv := parent.get_node_or_null("Tv")
	if tv != null:
		var locked = tv.get("_locked_position")
		if locked != null:
			_scene_home_positions["Tv__locked"] = locked
		_scene_home_positions["Tv"] = (tv as Node2D).position
	var normaldo := parent.get_node_or_null("Normaldo")
	if normaldo != null:
		_scene_home_positions["Normaldo"] = (normaldo as Node2D).position

# Hard-resets every pan-tracked node back to the snapshot taken in
# `_capture_scene_homes()`. Run from `_start_game()` so a tap during the
# camera-pan can't leave the run with half the room missing.
func _snap_scene_to_home() -> void:
	if _scene_pan_tween and _scene_pan_tween.is_valid():
		_scene_pan_tween.kill()
	_scene_pan_tween = null
	if _scene_home_positions.is_empty():
		return
	var parent := get_parent()
	if parent == null:
		return
	for nm in _SCENE_PAN_NODES:
		var n := parent.get_node_or_null(nm) as Node2D
		if n != null and _scene_home_positions.has(nm):
			n.position = _scene_home_positions[nm]
	var tv := parent.get_node_or_null("Tv")
	if tv != null:
		if _scene_home_positions.has("Tv__locked"):
			tv.set("_locked_position", _scene_home_positions["Tv__locked"])
		if _scene_home_positions.has("Tv"):
			(tv as Node2D).position = _scene_home_positions["Tv"]
	var normaldo := parent.get_node_or_null("Normaldo")
	if normaldo != null:
		if _scene_home_positions.has("Normaldo"):
			(normaldo as Node2D).position = _scene_home_positions["Normaldo"]
		# Open-pan suspends normaldo physics; if the pan was killed mid-flight
		# the close-pan resume callback never fires, so re-enable it manually.
		normaldo.set_physics_process(true)

# Slots screen uses the same "camera pans down/up" choreography as quests.
func _on_slots_open_anim_start(duration: float, trans: int, ease_kind: int) -> void:
