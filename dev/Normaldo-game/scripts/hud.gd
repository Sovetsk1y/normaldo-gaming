func _max_unlocked_fat() -> int:
	return SkinProgression.max_fat_state(SaveData.active_skin, SaveData.skin_level)

# Returns the active skin's fat-state texture for index i (0..3), falling
# back to the classic sheet if the skin doesn't have one at that index.
func _skin_fat_tex(i: int) -> Texture2D:
	var idx : int = clampi(i, 0, FAT_TEXTURES.size() - 1)
	var skin_data := SkinRegistry.get_skin(SaveData.active_skin)
	var tex_dir   : String = skin_data.get("tex_dir", "")
	if tex_dir.is_empty():
		return FAT_TEXTURES[idx]
	var path := tex_dir + "state%d.png" % (idx + 1)
	if ResourceLoader.exists(path):
		return load(path)
	return FAT_TEXTURES[idx]

# Смена скина двигает ПОТОЛОК жира (лестница у каждого своя), а само состояние
# не трогает: анимировать тут нечего, состояние просто такое.
func _refresh_fat_icons() -> void:
	if not is_instance_valid(_fat_gauge):
		return
	_fat_gauge.set_state(_prev_fat_state, _max_unlocked_fat(), false)

func _on_stats_changed(fat_state: int, pizza_count: int, total_pizzas: int) -> void:
	_pizza_label.text = str(total_pizzas)

	var max_fat := _max_unlocked_fat()

	var ratio := 1.0
	var left_txt := "МАКСИМУМ"
	if fat_state < FAT_THRESHOLDS.size() and fat_state < max_fat:
		var tier_start  = 0 if fat_state == 0 else FAT_THRESHOLDS[fat_state - 1]
		var local_count = pizza_count - tier_start
		var tier_size   = FAT_THRESHOLDS[fat_state] - tier_start
		ratio = clampf(float(local_count) / float(tier_size), 0.0, 1.0)
		_fat_bar_fill.color = Color(1.0, 0.55, 0.1, 1.0)
		left_txt = "%d / %d" % [clampi(local_count, 0, tier_size), tier_size]
	else:
		_fat_bar_fill.color = Color(1.0, 0.85, 0.2, 1.0)
	_fat_bar_fill.size.x = ratio * _fat_bar_width
	# Состояние словом и остаток числом — иначе полоса отвечает «примерно вот
	# столько», а игрок спрашивает «сколько ещё пицц».
	if is_instance_valid(_fat_name_lbl):
		_fat_name_lbl.text = _FAT_NAMES[clampi(fat_state, 0, _FAT_NAMES.size() - 1)]
	if is_instance_valid(_fat_left_lbl):
		_fat_left_lbl.text = left_txt

	# Лампы 💀 F A T: загорание и сбивание анимирует сам индикатор — он один
	# знает, какая лампа изменилась и в какую сторону.
	if is_instance_valid(_fat_gauge):
		_fat_gauge.set_state(fat_state, max_fat, true)

	if fat_state < _prev_fat_state and _prev_fat_state <= max_fat:
		QuestManager.notify_damage_taken()

	QuestManager.notify_stats_changed(fat_state, total_pizzas, _prev_fat_state)
	_prev_fat_state = fat_state

