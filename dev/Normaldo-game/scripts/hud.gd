# ── Tap prompt ───────────────────────────────────────────────────────────────

func _build_menu_tap_prompt(vp: Vector2) -> void:
	# Centred horizontally on the logo and 24 canvas-px below its bottom edge —
	# mirrors the placement math in _build_menu_logo so tweaks to MENU_LOGO_*
	# keep both elements in sync.
	var src_w : float = float(MENU_LOGO_TEX.get_width())
	var src_h : float = float(MENU_LOGO_TEX.get_height())
	var aspect : float = src_h / src_w
	var scale_x : float = vp.x / MENU_CANVAS_W
	var scale_y : float = vp.y / MENU_CANVAS_H
	var logo_h_vp : float = MENU_LOGO_W_CANVAS * aspect * scale_x
	# Same +30 vp-px nudge the user applied to the logo; keep in sync.
	var logo_top_vp : float = MENU_LOGO_Y_CANVAS * scale_y + 30.0
	var prompt_y : float = logo_top_vp + logo_h_vp + MENU_TAP_GAP * scale_y

	const PROMPT_W_CANVAS : float = 320.0   # caption width in canvas px
	var prompt_w_vp : float = PROMPT_W_CANVAS * scale_x
	var lbl := Label.new()
	lbl.add_theme_font_size_override("font_size", 16)
	_apply_menu_caption_fx(lbl)
	lbl.text                 = "Нажмите, чтобы начать игру"
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	lbl.size                 = Vector2(prompt_w_vp, 22.0)
	lbl.position             = Vector2((vp.x - prompt_w_vp) * 0.5, prompt_y)
	lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	_menu_overlay.add_child(lbl)

	# Looping fade — pulses between full opacity and 0.35 so the line reads as
	# "tap me" without being a flashy distraction. Sequence is:
	#   1) hold fully visible for FADE_HOLD seconds,
	#   2) fade down to 0.35 over FADE_TIME,
	#   3) fade back up to 1.0 over FADE_TIME.
	# Tween dies with the label.
	const FADE_HOLD : float = 1.2   # ← seconds the prompt stays fully visible
	const FADE_TIME : float = 0.7   # ← seconds for each fade direction
	var tw := create_tween().set_loops()
	tw.tween_interval(FADE_HOLD)
	tw.tween_property(lbl, "modulate:a", 0.35, FADE_TIME)\
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tw.tween_property(lbl, "modulate:a", 1.0, FADE_TIME)\
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

# ── Mode selector chip (Эпизод 1 ↔ Бесконечный) ─────────────────────────────
# Positioned in canvas px under the BAR sign on the bg_intro wall. Caption
# label sits inside the visible icon area, vertically centred. Tapping the
# chip toggles between modes — except if Endless isn't unlocked yet, in which
# case we surface a locked-popup instead.
func _build_menu_mode_btn(vp: Vector2) -> void:
	var scale_x : float = vp.x / MENU_CANVAS_W
	var scale_y : float = vp.y / MENU_CANVAS_H
	# Both PNGs share the SAME bbox so the chip lands on the same screen pixels
	# regardless of which sprite is active. Sampled values:
	# chapter1 bbox = (11,11)+(41,41); endless bbox = (11,8)+(41,44).
	# Use the more permissive bbox so we never crop the endless sprite.
	const ICON_W : float = 41.0   # canvas px
	const ICON_H : float = 44.0
	const GLOW_PAD : float = MENU_GLOW_PAD
	const SRC_X : float = 11.0    # x within source PNG
	const SRC_Y : float = 8.0     # min y across both sprites
	# ПЛОТНОСТЬ файла: сколько его пикселей приходится на единицу замера выше.
	# Замер снят с авторского кадра 64×64, а печатается чип в 256 (см.
	# `dev/tools/bake_mode_btn.py`) — все ОКНА В ИСХОДНИКЕ поэтому умножаются на
	# K, а всё экранное считается по-прежнему в координатах полотна и не
	# меняется. Число берётся из самой текстуры: перепечатают чип в другой
	# плотности — окна поедут за ней сами.
	var src_k : float = maxf(1.0, MODE_BTN_CHAPTER1.get_width() / 64.0)

	var icon_w_vp : float = ICON_W * scale_x
	var icon_h_vp : float = ICON_H * scale_y

	# Visual container scales on press (same press-feedback as main buttons).
	var visual_root := Control.new()
	visual_root.size         = Vector2(icon_w_vp, icon_h_vp)
	visual_root.position     = Vector2(MENU_MODE_BTN_X * scale_x, MENU_MODE_BTN_Y * scale_y)
	visual_root.pivot_offset = visual_root.size * 0.5
	visual_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_menu_overlay.add_child(visual_root)

	# Glow region in source: bbox + GLOW_PAD, clamped to PNG bounds.
	var glow_x0 : float = max(0.0, SRC_X - GLOW_PAD)
	var glow_y0 : float = max(0.0, SRC_Y - GLOW_PAD)
	var glow_x1 : float = min(64.0, SRC_X + ICON_W + GLOW_PAD)
	var glow_y1 : float = min(64.0, SRC_Y + ICON_H + GLOW_PAD)
	var glow_w_src : float = glow_x1 - glow_x0
	var glow_h_src : float = glow_y1 - glow_y0
	var glow_off_x : float = glow_x0 - SRC_X
	var glow_off_y : float = glow_y0 - SRC_Y

	_mode_btn_glow_atlas = AtlasTexture.new()
	_mode_btn_glow_atlas.region = Rect2(glow_x0 * src_k, glow_y0 * src_k,
		glow_w_src * src_k, glow_h_src * src_k)
	_mode_btn_glow_rect = TextureRect.new()
	_mode_btn_glow_rect.texture             = _mode_btn_glow_atlas
	_mode_btn_glow_rect.stretch_mode        = TextureRect.STRETCH_SCALE
	_mode_btn_glow_rect.expand_mode         = TextureRect.EXPAND_IGNORE_SIZE
	_mode_btn_glow_rect.custom_minimum_size = Vector2.ZERO
	_mode_btn_glow_rect.size                = Vector2(glow_w_src * scale_x, glow_h_src * scale_y)
	_mode_btn_glow_rect.position            = Vector2(glow_off_x * scale_x, glow_off_y * scale_y)
	_mode_btn_glow_rect.texture_filter      = CanvasItem.TEXTURE_FILTER_LINEAR
	_mode_btn_glow_rect.mouse_filter        = Control.MOUSE_FILTER_IGNORE
	visual_root.add_child(_mode_btn_glow_rect)

	_mode_btn_icon_atlas = AtlasTexture.new()
	_mode_btn_icon_atlas.region = Rect2(SRC_X * src_k, SRC_Y * src_k,
		ICON_W * src_k, ICON_H * src_k)
	_mode_btn_icon_rect = TextureRect.new()
	_mode_btn_icon_rect.texture             = _mode_btn_icon_atlas
	_mode_btn_icon_rect.stretch_mode        = TextureRect.STRETCH_SCALE
	_mode_btn_icon_rect.expand_mode         = TextureRect.EXPAND_IGNORE_SIZE
	_mode_btn_icon_rect.custom_minimum_size = Vector2.ZERO
	_mode_btn_icon_rect.size                = Vector2(icon_w_vp, icon_h_vp)
	_mode_btn_icon_rect.position            = Vector2.ZERO
	# Тот же линейный фильтр, что у иконок меню и что у СОБСТВЕННОГО свечения
	# этой же кнопки строкой выше: чип рисуется на дробном масштабе, и nearest
	# резал его на квадраты, пока ореол вокруг оставался гладким.
	_mode_btn_icon_rect.texture_filter      = CanvasItem.TEXTURE_FILTER_LINEAR
	_mode_btn_icon_rect.mouse_filter        = Control.MOUSE_FILTER_IGNORE
	visual_root.add_child(_mode_btn_icon_rect)

	# Caption sitting on the lower plate of the chip.
	const CAPTION_Y_IN_BTN : float = 31.5   # canvas px from bbox top
	const CAPTION_H : float        = 14.0
	_mode_btn_caption = Label.new()
	_mode_btn_caption.add_theme_font_size_override("font_size", 14)
	_mode_btn_caption.add_theme_constant_override("line_spacing", -3)
	_apply_menu_caption_fx(_mode_btn_caption)
	_mode_btn_caption.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_mode_btn_caption.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	_mode_btn_caption.size                 = Vector2(icon_w_vp, CAPTION_H * scale_y)
	_mode_btn_caption.position             = Vector2(0.0, CAPTION_Y_IN_BTN * scale_y)
	_mode_btn_caption.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	visual_root.add_child(_mode_btn_caption)

	# Reflect the current persistent mode state.
	_apply_mode_btn_visuals()

	# Hit area. Press animation reuses _menu_btn_press_anim for consistency.
	var hit := Button.new()
	hit.flat       = true
	hit.focus_mode = Control.FOCUS_NONE
	hit.size       = Vector2(icon_w_vp, icon_h_vp)
	hit.position   = Vector2(MENU_MODE_BTN_X * scale_x, MENU_MODE_BTN_Y * scale_y)
	hit.pressed.connect(_play_btn_sfx)
	hit.pressed.connect(_on_mode_btn_pressed)
	hit.set_meta("visual_root", visual_root)
	hit.button_down.connect(_menu_btn_press_anim.bind(visual_root, true))
	hit.button_up.connect(_menu_btn_press_anim.bind(visual_root, false))
	hit.mouse_exited.connect(_menu_btn_press_anim.bind(visual_root, false))
	_menu_overlay.add_child(hit)

func _on_mode_btn_pressed() -> void:
	# Toggle chapter1 ↔ endless. If endless isn't unlocked yet, surface the
	# locked popup instead of toggling.
	if not _mode_btn_endless and not QuestManager.is_endless_unlocked():
		_show_endless_locked_popup()
		return
	_mode_btn_endless = not _mode_btn_endless
	_apply_mode_btn_visuals()

# Swap the AtlasTexture's source PNG + the caption text based on the current
# mode. Sprite stays at the same on-screen rect because both PNGs are 64×64
# and we sample the same region.
func _apply_mode_btn_visuals() -> void:
	if not is_instance_valid(_mode_btn_icon_rect):
		return
	# Font sizes per mode — "БЕСКОНЕЧНЫЙ" is longer than "ЭПИЗОД 1" so shrink
	# it by 2 to keep it on the plate. Single source of truth for the typo.
	const MODE_FONT_CHAPTER1 : int = 14
	const MODE_FONT_ENDLESS  : int = 12
	if _mode_btn_endless:
		_mode_btn_icon_atlas.atlas = MODE_BTN_ENDLESS
		_mode_btn_glow_atlas.atlas = MODE_BTN_ENDLESS_GLOW
		_mode_btn_caption.text     = "БЕСКОНЕЧНЫЙ"
		_mode_btn_caption.add_theme_font_size_override("font_size", MODE_FONT_ENDLESS)
	else:
		_mode_btn_icon_atlas.atlas = MODE_BTN_CHAPTER1
		_mode_btn_glow_atlas.atlas = MODE_BTN_CHAPTER1_GLOW
		_mode_btn_caption.text     = "ЭПИЗОД 1"
		_mode_btn_caption.add_theme_font_size_override("font_size", MODE_FONT_CHAPTER1)

func _show_endless_locked_popup() -> void:
	var vp := get_viewport().get_visible_rect().size
	var popup := Control.new()
	popup.size         = vp
	popup.position     = Vector2.ZERO
	popup.mouse_filter = Control.MOUSE_FILTER_STOP
	add_child(popup)

	var dim := ColorRect.new()
	dim.color        = Color(0, 0, 0, 0.70)
	dim.size         = vp
	dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
	popup.add_child(dim)

	const PANEL_W : float = 320.0
	const PANEL_H : float = 90.0
	var panel := ColorRect.new()
	panel.color = Color(0.08, 0.07, 0.12, 0.98)
	panel.size  = Vector2(PANEL_W, PANEL_H)
	panel.position = Vector2((vp.x - PANEL_W) * 0.5, (vp.y - PANEL_H) * 0.5)
	panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	popup.add_child(panel)

	var stripe := ColorRect.new()
	stripe.color    = Color(0.55, 0.30, 1.0, 0.85)
	stripe.size     = Vector2(PANEL_W, 2.0)
	stripe.position = panel.position
	stripe.mouse_filter = Control.MOUSE_FILTER_IGNORE
	popup.add_child(stripe)

	var lbl := Label.new()
	lbl.add_theme_font_size_override("font_size", 14)
	_apply_menu_caption_fx(lbl)
	lbl.text                 = "Откроется после\nпрохождения Эпизода 1"
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	lbl.size                 = Vector2(PANEL_W, PANEL_H)
	lbl.position             = panel.position
	lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	popup.add_child(lbl)

	# Whole-screen Button on top — any tap dismisses the popup.
	var dismiss := Button.new()
	dismiss.flat         = true
	dismiss.focus_mode   = Control.FOCUS_NONE
	dismiss.size         = vp
	dismiss.position     = Vector2.ZERO
	dismiss.mouse_filter = Control.MOUSE_FILTER_STOP
	dismiss.pressed.connect(func(): popup.queue_free())
	popup.add_child(dismiss)

func _on_play_tapped() -> void:
	if _menu_tapped:
		return
	_menu_tapped = true
	if _chest_tooltip and is_instance_valid(_chest_tooltip):
		_chest_tooltip.queue_free()
		_chest_tooltip = null
	# Mode is chosen via the mode-selector chip; we just honour its state.
	HUD._start_endless = _mode_btn_endless and QuestManager.is_endless_unlocked()
	_start_game()

