		_apply_menu_caption_fx(unm)
		unm.text     = unique_data.get("label", "")
		unm.modulate = Color(rc.r, rc.g, rc.b, 0.95)
		unm.size     = Vector2(PW - 46.0, 14.0)
		unm.position = Vector2(px + 34.0, cy + 5.0)
