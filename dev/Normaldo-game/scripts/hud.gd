func _attempt_rename(new_name: String, error_lbl: Label, modal_root: Node) -> void:
	if new_name.length() < 3 or new_name.length() > 12:
		error_lbl.text = "Имя должно быть от 3 до 12 символов"
		return
	if not _is_valid_name(new_name):
		error_lbl.text = "Разрешены только буквы, цифры, _ и -"
		return
	error_lbl.text = "Сохраняю…"
	error_lbl.modulate = Color(0.85, 0.85, 0.85)
	var resp = await LeaderboardClient.set_display_name(new_name)
	if resp.ok:
		_refresh_player_cell()
		modal_root.queue_free()
	else:
		error_lbl.modulate = Color(1.0, 0.55, 0.45)
		var msg := str(resp.get("error", ""))
		if msg.findn("already-exists") >= 0 or msg.findn("name taken") >= 0:
			error_lbl.text = "Это имя занято — попробуй другое"
		elif msg.findn("invalid-argument") >= 0:
			error_lbl.text = "Имя не подходит — буквы/цифры/-/_"
		else:
			error_lbl.text = "Не получилось сохранить, попробуй ещё раз"

func _is_valid_name(s: String) -> bool:
	for c in s:
		var ok := (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") \
			or (c >= "0" and c <= "9") or c == "_" or c == "-"
		# Allow Cyrillic
		var cu = c.unicode_at(0)
		var cyrillic := (cu >= 0x0400 and cu <= 0x04FF) or cu == 0x0451 or cu == 0x0401
		if not (ok or cyrillic):
			return false
	return true

# Top-anchored modal geometry. A centred modal whose `desired_h` exceeds the
# viewport clips its header off the top edge (the bug on short phones). Instead
# we centre vertically only when the panel fits, and otherwise pin the top
# `_MODAL_TOP_PAD` below the screen edge and clamp the visible height so the
# bottom stays on-screen — the caller scrolls the body inside that height.
# Returns Vector2(top_y, visible_height).
const _MODAL_TOP_PAD    : float = 16.0
const _MODAL_BOTTOM_PAD : float = 16.0

func _modal_panel_y_h(vp_h: float, desired_h: float) -> Vector2:
	var top    := maxf(_MODAL_TOP_PAD, (vp_h - desired_h) * 0.5)
	var max_h  := vp_h - top - _MODAL_BOTTOM_PAD
	var h      := minf(desired_h, max_h)
	return Vector2(top, h)

# Настройки — отдельный экран-разворот (scripts/settings_screen.gd), а не
# стопка модалок. Раньше подэкран ЗАМЕНЯЛ родителя: закрыл уведомления —
# оказался в главном меню. См. /Концепция/Экран настроек.md
const _SETTINGS_SCREEN_SCRIPT := preload("res://scripts/settings_screen.gd")
var _settings_screen : Node = null

func _show_settings_modal() -> void:
	if is_instance_valid(_settings_screen):
		return
	var scr : Node = _SETTINGS_SCREEN_SCRIPT.new()
	scr.call("setup", self)
	# Своим слоем ПОВЕРХ паузы: с неё сюда и приходят.
	_settings_layer = _modal_layer(SETTINGS_LAYER)
	_settings_layer.add_child(scr)
	_settings_screen = scr
	# Экран настроек закрывает себя сам (queue_free в _on_close) — слой обязан
	# уйти следом, иначе после каждого открытия остаётся пустой CanvasLayer.
	var lay := _settings_layer
	scr.tree_exited.connect(func() -> void:
		if is_instance_valid(lay):
			lay.queue_free(), CONNECT_ONE_SHOT)

# ── Уведомления ──────────────────────────────────────────────────────────────
# Раздел уведомлений переехал в экран настроек (scripts/settings_screen.gd) —
# отдельной модалки больше нет. Здесь остались только dev-строки, которые этот
# раздел показывает под собой, и общие переключатели, которыми он пользуется.

# Dev-only "симулировать клик" row. Fires `Notifications.simulate_open()` on
# the soonest pending notif and closes the modal so the deep-link target
# screen has the stage to itself.
func _build_notif_test_row(parent: Node, x: float, y: float, w: float,
		modal_root: Node) -> void:
	const H : float = 32.0
	var visual := Control.new()
	visual.size         = Vector2(w, H)
	visual.position     = Vector2(x, y)
	visual.pivot_offset = visual.size * 0.5
	visual.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(visual)

	var bg := ColorRect.new()
	bg.color    = Color(0.18, 0.18, 0.34, 0.95)
	bg.size     = Vector2(w, H)
	bg.position = Vector2.ZERO
	visual.add_child(bg)
	var lbl := Label.new()
	lbl.add_theme_font_override("font", UI_FONT)
	lbl.add_theme_font_size_override("font_size", 11)
	_apply_menu_caption_fx(lbl)
	lbl.text                 = "DEV · СИМУЛИРОВАТЬ КЛИК ПО БЛИЖАЙШЕМУ ПУШУ"
	lbl.modulate             = Color(0.65, 0.95, 1.0)
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	lbl.size                 = Vector2(w, H)
	lbl.position             = Vector2.ZERO
	lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	visual.add_child(lbl)
	var btn := Button.new()
	btn.flat       = true
	btn.focus_mode = Control.FOCUS_NONE
	btn.size       = Vector2(w, H)
	btn.position   = Vector2(x, y)
	btn.button_down.connect(_menu_btn_press_anim.bind(visual, true))
	btn.button_up.connect(_menu_btn_press_anim.bind(visual, false))
	btn.mouse_exited.connect(_menu_btn_press_anim.bind(visual, false))
	btn.pressed.connect(func():
		_play_btn_sfx()
		var pending : Array = Notifications.list_pending()
		if pending.is_empty():
			Logger.warn("Notifications", "no pending notifs to simulate")
			return
		var top_id := str(pending[0].get("id", ""))
		if top_id == "":
			return
		if is_instance_valid(modal_root):
			modal_root.queue_free()
		# Defer so the modal teardown completes before the target screen opens.
		call_deferred("_simulate_notification_open", top_id))
	parent.add_child(btn)

func _simulate_notification_open(id: String) -> void:
	Notifications.simulate_open(id)

# Dev-only "запланировать реальный пуш" row. Schedules a genuine local
# notification 8 s into the future through the native plugin, then closes the
# whole settings overlay so you can background the app and watch the OS banner
# arrive. Unlike the simulate row above, this exercises the real
# UserNotifications path end-to-end (permission → schedule → OS delivery).
func _build_notif_fire_row(parent: Node, x: float, y: float, w: float,
		modal_root: Node) -> void:
	const H : float = 32.0
	var visual := Control.new()
	visual.size         = Vector2(w, H)
	visual.position     = Vector2(x, y)
	visual.pivot_offset = visual.size * 0.5
	visual.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(visual)

	var bg := ColorRect.new()
	bg.color    = Color(0.16, 0.34, 0.20, 0.95)
	bg.size     = Vector2(w, H)
	bg.position = Vector2.ZERO
	visual.add_child(bg)
	var lbl := Label.new()
	lbl.add_theme_font_override("font", UI_FONT)
	lbl.add_theme_font_size_override("font_size", 11)
	_apply_menu_caption_fx(lbl)
	lbl.text                 = "DEV · ПУШ ЧЕРЕЗ 8 СЕК (СВЕРНИ ИГРУ)"
	lbl.modulate             = Color(0.70, 1.0, 0.75)
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	lbl.size                 = Vector2(w, H)
	lbl.position             = Vector2.ZERO
	lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	visual.add_child(lbl)
	var btn := Button.new()
	btn.flat       = true
	btn.focus_mode = Control.FOCUS_NONE
	btn.size       = Vector2(w, H)
	btn.position   = Vector2(x, y)
	btn.button_down.connect(_menu_btn_press_anim.bind(visual, true))
	btn.button_up.connect(_menu_btn_press_anim.bind(visual, false))
	btn.mouse_exited.connect(_menu_btn_press_anim.bind(visual, false))
	btn.pressed.connect(func():
		_play_btn_sfx()
		# Make sure we're allowed to post (no-op if already granted / on
		# desktop). The pending request still fires once permission lands.
		Notifications.request_permission()
		var fire_at := int(Time.get_unix_time_from_system()) + 8
		Notifications.schedule(
			"dev_test_%d" % fire_at,
			fire_at,
			"Normaldo",
			"Тестовый пуш 🐢 — всё работает!",
			{"category": "dev", "deep_link": "menu"})
		Logger.info("Notifications", "dev push scheduled, fire_at=%d" % fire_at)
		if is_instance_valid(modal_root):
			modal_root.queue_free())
	parent.add_child(btn)

# Dev-only "remote test" row. Asks the server (sendTestPush) to deliver a real
# remote push back to this device, exercising the full FCM/APNs round-trip
# (token registered → server send → OS delivery → tap deep-link). Reports the
# outcome in-place so you can tell token-missing from delivered. Keeps the modal
# open; background the app to see the banner / test the tap.
func _build_notif_remote_row(parent: Node, x: float, y: float, w: float) -> void:
	const H : float = 32.0
	var visual := Control.new()
	visual.size         = Vector2(w, H)
	visual.position     = Vector2(x, y)
	visual.pivot_offset = visual.size * 0.5
	visual.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(visual)

	var bg := ColorRect.new()
	bg.color    = Color(0.16, 0.22, 0.40, 0.95)
	bg.size     = Vector2(w, H)
	bg.position = Vector2.ZERO
	visual.add_child(bg)
	var lbl := Label.new()
	lbl.add_theme_font_override("font", UI_FONT)
	lbl.add_theme_font_size_override("font_size", 11)
	_apply_menu_caption_fx(lbl)
	lbl.text                 = "DEV · REMOTE TEST (СЕРВЕР → ПУШ)"
	lbl.modulate             = Color(0.70, 0.88, 1.0)
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	lbl.size                 = Vector2(w, H)
	lbl.position             = Vector2.ZERO
	lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	visual.add_child(lbl)
	var btn := Button.new()
	btn.flat       = true
	btn.focus_mode = Control.FOCUS_NONE
	btn.size       = Vector2(w, H)
	btn.position   = Vector2(x, y)
	btn.button_down.connect(_menu_btn_press_anim.bind(visual, true))
	btn.button_up.connect(_menu_btn_press_anim.bind(visual, false))
	btn.mouse_exited.connect(_menu_btn_press_anim.bind(visual, false))
	btn.pressed.connect(func():
		_play_btn_sfx()
		if is_instance_valid(lbl):
			lbl.text = "DEV · ОТПРАВКА…"
		var resp : Dictionary = await LeaderboardClient.send_test_push()
		var call_ok := bool(resp.get("ok", false))
		var data : Dictionary = resp.get("data", {}) if resp.get("data", null) is Dictionary else {}
		var sent := call_ok and bool(data.get("ok", false))
		# Inner error (APNs/FCM reason) when the call succeeded but send failed;
		# outer error when the call itself failed.
		var reason := str(data.get("error", "")) if call_ok else str(resp.get("error", ""))
		Logger.info("Notifications", "remote test: call_ok=%s sent=%s reason=%s" % [
			str(call_ok), str(sent), reason])
		if not is_instance_valid(lbl) or not is_instance_valid(bg):
			return
		if sent:
			lbl.text  = "DEV · ОТПРАВЛЕНО ✓ (СВЕРНИ ИГРУ)"
			bg.color  = Color(0.16, 0.34, 0.20, 0.95)
		else:
			lbl.text  = "DEV · ОШИБКА: %s" % reason.substr(0, 40)
			bg.color  = Color(0.40, 0.16, 0.16, 0.95))
	parent.add_child(btn)

