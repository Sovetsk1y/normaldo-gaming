	error_lbl.autowrap_mode        = TextServer.AUTOWRAP_WORD
	error_lbl.size                 = Vector2(panel_w - 32.0, 36.0)
	error_lbl.position             = Vector2(panel_x + 16.0, panel_y + 188.0)
