func _show_unclaimed_pending_rewards(rewards: Array) -> void:
	for i in rewards.size():
		var r = rewards[i]
		if r is Dictionary and not bool(r.get("claimed", false)):
			var metric := str(r.get("metric", "best"))
			var label := "Рекорд забега" if metric == "best" else "Гора пицц"
			_show_prize_claim_modal({
				"metric":       metric,
				"metric_label": label,
				"place":        int(r.get("place", 0)),
				"dollars":      int(r.get("dollars", 0)),
				"tokens":       int(r.get("tokens", 0)),
				"index":        i,
			})
			return  # show one at a time

func _show_prize_claim_modal(reward: Dictionary) -> void:
	var vp := get_viewport().get_visible_rect().size
	var root := Node2D.new()
	root.process_mode = Node.PROCESS_MODE_ALWAYS
	root.z_index = 100
	add_child(root)

	# Dim
	var dim := ColorRect.new()
	dim.color    = Color(0.0, 0.0, 0.0, 0.78)
	dim.size     = vp
	root.add_child(dim)

	# Block taps outside modal
	var dim_btn := Button.new()
	dim_btn.flat       = true
	dim_btn.focus_mode = Control.FOCUS_NONE
	dim_btn.size       = vp
	root.add_child(dim_btn)

	# Confetti — spawn after panel appears
	_spawn_confetti(root, vp, 60)

	# Panel
	var panel_w := 340.0
	var panel_h := 200.0
	var panel_x := (vp.x - panel_w) * 0.5
	var panel_y := (vp.y - panel_h) * 0.5

	var panel := ColorRect.new()
	panel.color    = Color(0.07, 0.06, 0.04, 0.98)
	panel.size     = Vector2(panel_w, panel_h)
	panel.position = Vector2(panel_x, panel_y)
	root.add_child(panel)

	var stripe := ColorRect.new()
	stripe.color    = Color(1.0, 0.85, 0.35)
	stripe.size     = Vector2(panel_w, 3.0)
	stripe.position = Vector2(panel_x, panel_y)
	root.add_child(stripe)

	var stripe_bot := ColorRect.new()
	stripe_bot.color    = Color(1.0, 0.85, 0.35)
	stripe_bot.size     = Vector2(panel_w, 3.0)
	stripe_bot.position = Vector2(panel_x, panel_y + panel_h - 3.0)
	root.add_child(stripe_bot)

	var hdr := Label.new()
	hdr.add_theme_font_override("font", UI_FONT)
	hdr.add_theme_font_size_override("font_size", 12)
	_apply_menu_caption_fx(hdr)
	hdr.text                 = "ПРОШЛАЯ НЕДЕЛЯ"
	hdr.modulate             = Color(0.65, 0.65, 0.55)
	hdr.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	hdr.size                 = Vector2(panel_w, 18.0)
	hdr.position             = Vector2(panel_x, panel_y + 12.0)
	root.add_child(hdr)

	var metric_label := str(reward.get("metric_label", ""))
	var place := int(reward.get("place", 0))
	var place_lbl := Label.new()
	place_lbl.add_theme_font_override("font", UI_FONT)
	place_lbl.add_theme_font_size_override("font_size", 18)
	_apply_menu_caption_fx(place_lbl)
	place_lbl.text                 = "%s — #%d МЕСТО" % [metric_label, place]
	place_lbl.modulate             = Color(1.0, 0.88, 0.40)
	place_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	place_lbl.size                 = Vector2(panel_w, 24.0)
	place_lbl.position             = Vector2(panel_x, panel_y + 38.0)
	root.add_child(place_lbl)

	# Reward: text + token icon (no "жетон" word, icon conveys the unit).
	var d := int(reward.get("dollars", 0))
	var t := int(reward.get("tokens", 0))
	var rwd_text := ""
	if d > 0 and t > 0:
		rwd_text = "+%d $  +%d" % [d, t]
	elif d > 0:
		rwd_text = "+%d $" % d
	elif t > 0:
		rwd_text = "+%d" % t

	const _RWD_FONT_SZ : int   = 16
	const _TKN_ICON_SZ : float = 22.0
	const _TKN_GAP     : float = 4.0
	var has_token : bool = t > 0
	var text_w : float = 0.0
	if rwd_text != "":
		text_w = UI_FONT.get_string_size(rwd_text, HORIZONTAL_ALIGNMENT_LEFT, -1, _RWD_FONT_SZ).x
	var total_w : float = text_w + (_TKN_ICON_SZ + _TKN_GAP if has_token else 0.0)
	var rwd_x  : float = panel_x + (panel_w - total_w) * 0.5
	var rwd_y  : float = panel_y + 80.0

	var rwd_lbl := Label.new()
	rwd_lbl.add_theme_font_override("font", UI_FONT)
	rwd_lbl.add_theme_font_size_override("font_size", _RWD_FONT_SZ)
	_apply_menu_caption_fx(rwd_lbl)
	rwd_lbl.text                 = rwd_text
	rwd_lbl.modulate             = Color(0.55, 1.0, 0.55)
	rwd_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	rwd_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	rwd_lbl.size                 = Vector2(text_w + 2.0, 24.0)
	rwd_lbl.position             = Vector2(rwd_x, rwd_y)
	root.add_child(rwd_lbl)

	if has_token:
		var token_icon := _make_icon(TOKEN_TEXTURE, _TKN_ICON_SZ)
		token_icon.position = Vector2(rwd_x + text_w + _TKN_GAP,
				rwd_y + (24.0 - _TKN_ICON_SZ) * 0.5)
		root.add_child(token_icon)

	# CLAIM button (with press-shrink effect)
	var btn_w := 180.0
	var btn_h := 40.0
	var btn_x := panel_x + (panel_w - btn_w) * 0.5
	var btn_y := panel_y + panel_h - btn_h - 18.0
	var btn_visual := Control.new()
	btn_visual.size         = Vector2(btn_w, btn_h)
	btn_visual.position     = Vector2(btn_x, btn_y)
	btn_visual.pivot_offset = btn_visual.size * 0.5
	btn_visual.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.add_child(btn_visual)

	var btn_bg := ColorRect.new()
	btn_bg.color    = Color(0.18, 0.45, 0.16, 0.95)
	btn_bg.size     = Vector2(btn_w, btn_h)
	btn_bg.position = Vector2.ZERO
	btn_visual.add_child(btn_bg)

	var btn_lbl := Label.new()
	btn_lbl.add_theme_font_override("font", UI_FONT)
	btn_lbl.add_theme_font_size_override("font_size", 16)
	_apply_menu_caption_fx(btn_lbl)
	btn_lbl.text                 = "ЗАБРАТЬ"
	btn_lbl.modulate             = Color(0.85, 1.0, 0.65)
	btn_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	btn_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	btn_lbl.size                 = Vector2(btn_w, btn_h)
	btn_lbl.position             = Vector2.ZERO
	btn_lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	btn_visual.add_child(btn_lbl)

	var reward_index : int = int(reward.get("index", -1))
	var claim_btn := Button.new()
	claim_btn.flat       = true
	claim_btn.focus_mode = Control.FOCUS_NONE
	claim_btn.size       = Vector2(btn_w, btn_h)
	claim_btn.position   = Vector2(btn_x, btn_y)
	claim_btn.button_down.connect(_menu_btn_press_anim.bind(btn_visual, true))
	claim_btn.button_up.connect(_menu_btn_press_anim.bind(btn_visual, false))
	claim_btn.mouse_exited.connect(_menu_btn_press_anim.bind(btn_visual, false))
	claim_btn.pressed.connect(func():
		_play_btn_sfx()
		if d > 0:
			SaveData.add_dollars(d, "pending_reward")
		if t > 0:
			SaveData.add_tokens(t, "pending_reward")
		# Mark claimed locally + on server so chain doesn't loop & next session
		# doesn't re-show the same reward.
		if reward_index >= 0 and reward_index < SaveData.pending_rewards.size():
			var entry = SaveData.pending_rewards[reward_index]
			if entry is Dictionary:
				entry["claimed"] = true
				SaveData.pending_rewards[reward_index] = entry
				SaveData._save()
		if reward_index >= 0 and LeaderboardClient.is_ready():
			LeaderboardClient.claim_reward(reward_index)
		root.queue_free()
		call_deferred("_show_unclaimed_pending_rewards", SaveData.pending_rewards)
	)
	root.add_child(claim_btn)

	# Entry animation
	root.modulate.a = 0.0
	var tw := root.create_tween()
	tw.tween_property(root, "modulate:a", 1.0, 0.30)

func _spawn_confetti(parent: Node, vp: Vector2, count: int) -> void:
	# Конфетти сыплется по итогам асинхронной анимации: если экран к этому
	# моменту уехал, класть частицы некуда — create_tween() на них вернёт null.
	if not is_instance_valid(parent) or not parent.is_inside_tree():
		return
	var palette : Array = [
		Color(1.0, 0.85, 0.35),
		Color(0.55, 0.85, 1.0),
		Color(0.55, 1.0, 0.55),
		Color(1.0, 0.45, 0.55),
		Color(0.95, 0.55, 1.0),
	]
	for i in count:
		var sz   := randf_range(4.0, 8.0)
		var rect := ColorRect.new()
		rect.color    = palette[randi() % palette.size()]
		rect.size     = Vector2(sz, sz)
		rect.position = Vector2(randf_range(0.0, vp.x), -randf_range(10.0, 100.0))
		rect.rotation = randf_range(-0.5, 0.5)
		parent.add_child(rect)
		var fall_y   := vp.y + 20.0
		var duration := randf_range(1.6, 3.0)
		var drift    := randf_range(-60.0, 60.0)
		var tw := rect.create_tween().set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		tw.tween_property(rect, "position",
			Vector2(rect.position.x + drift, fall_y), duration) \
			.set_trans(Tween.TRANS_LINEAR)
		tw.parallel().tween_property(rect, "rotation",
			rect.rotation + randf_range(2.0, 6.0), duration)
		tw.parallel().tween_property(rect, "modulate:a", 0.0, 0.40).set_delay(duration - 0.40)
		tw.tween_callback(rect.queue_free)

func _refresh_quest_badges() -> void:
	if is_instance_valid(_quest_badge):
		_quest_badge.visible = QuestManager.has_daily_badge()
	if is_instance_valid(_achieve_badge):
		_achieve_badge.visible = QuestManager.has_story_badge()
	if is_instance_valid(_skins_badge):
		_skins_badge.visible = SaveData.has_ready_mastery_chest()
	# Menu balance labels live only while the main menu is up — null-check
	# instead of rebuilding so we don't fight other animations on the screen.
	if is_instance_valid(_menu_dlr_lbl):
		_menu_dlr_lbl.text = str(SaveData.dollars)
	if is_instance_valid(_menu_tkn_lbl):
		_menu_tkn_lbl.text = str(SaveData.tokens)

func _show_shop_from_slots() -> void:
	_show_shop(0, true)

func _on_death_quests_tapped() -> void:
	# Hide death screen elements temporarily
	var overlay_to_hide = _go_overlay
	if is_instance_valid(overlay_to_hide):
		overlay_to_hide.visible = false

	var screen := QuestsScreen.new()
	screen.setup(self)
	add_child(screen)

	# When quest screen closes, restore death screen
	screen.tree_exited.connect(func():
		if is_instance_valid(overlay_to_hide):
			overlay_to_hide.visible = true
		_refresh_quest_badges()
	)

func _on_phase_entered(phase_idx: int) -> void:
	Analytics.event("phase_entered", {
		"mode":         ("campaign" if QuestManager._run_is_campaign else "endless"),
		"phase_index":  int(phase_idx),
		"time_in_run":  int(_elapsed_time),
	})
	if QuestManager._run_is_campaign:
		QuestManager.notify_campaign_phase(phase_idx)
		return
	if not QuestManager._run_is_endless:
		return
	var spawner := get_parent().get_node_or_null("Spawner")
	if not spawner or not is_instance_valid(spawner):
		return
	var phases : Array = spawner.ENDLESS_PHASES
	if phase_idx < 0 or phase_idx >= phases.size():
		return
	var phase_name : String = phases[phase_idx]["name"]
	var is_madness = phase_idx >= spawner.CALM_WAVE_PHASES_FROM
	_show_phase_toast(phase_name, is_madness)

func _show_phase_toast(phase_name: String, is_madness: bool) -> void:
	var vp := get_viewport().get_visible_rect().size
	if is_instance_valid(_toast_node):
		_toast_node.queue_free()
	_toast_node = Node2D.new()
	_toast_node.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_toast_node)

	var toast_w := 240.0
	var toast_h := 52.0
	var toast_x := (vp.x - toast_w) * 0.5
	var toast_y := vp.y * 0.22

	var stripe_col := Color(1.0, 0.30, 0.30) if is_madness else Color(0.45, 0.85, 0.25)
	var bg_col     := Color(0.18, 0.04, 0.04, 0.92) if is_madness else Color(0.06, 0.10, 0.04, 0.92)
	var name_col   := Color(1.0, 0.55, 0.40) if is_madness else Color(0.95, 0.95, 0.55)

	var bg := ColorRect.new()
	bg.color    = bg_col
	bg.size     = Vector2(toast_w, toast_h)
	bg.position = Vector2(toast_x, toast_y - 40.0)
	_toast_node.add_child(bg)

	var stripe_top := ColorRect.new()
	stripe_top.color    = stripe_col
	stripe_top.size     = Vector2(toast_w, 2.0)
	stripe_top.position = bg.position
	_toast_node.add_child(stripe_top)

	var stripe_bot := ColorRect.new()
	stripe_bot.color    = stripe_col
	stripe_bot.size     = Vector2(toast_w, 2.0)
	stripe_bot.position = bg.position + Vector2(0.0, toast_h - 2.0)
	_toast_node.add_child(stripe_bot)

	var label := Label.new()
	label.add_theme_font_override("font", UI_FONT)
	label.add_theme_font_size_override("font_size", 22)
	label.text                 = phase_name.to_upper()
	label.modulate             = name_col
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	label.size                 = Vector2(toast_w, toast_h)
	label.position             = bg.position
	_toast_node.add_child(label)

	var target_y := toast_y
	var tw := _toast_node.create_tween().set_parallel(true)
	tw.tween_property(bg,         "position:y", target_y,                 0.30).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_property(stripe_top, "position:y", target_y,                 0.30).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_property(stripe_bot, "position:y", target_y + toast_h - 2.0, 0.30).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_property(label,      "position:y", target_y,                 0.30).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)

	tw.chain().tween_interval(1.8)
	tw.chain().tween_property(_toast_node, "modulate:a", 0.0, 0.35)
	tw.chain().tween_callback(_toast_node.queue_free)

# Quest-reminder strip shown right after a run starts. Walks daily quest
# slots, skips anything already done or on cooldown, and plays a chained
# slide-up-hold-slide-down animation for each remaining quest.
func _show_run_intro_quests() -> void:
	if is_instance_valid(_intro_quest_seq):
		_intro_quest_seq.queue_free()
		_intro_quest_seq = null
	var pending : Array = []
	for slot in QuestManager.daily_quests.size():
		if QuestManager.is_slot_on_cooldown(slot):
			continue
		var q : Dictionary = QuestManager.daily_quests[slot]
		if bool(q.get("completed", false)) or bool(q.get("claimed", false)):
			continue
		var def := QuestManager._daily_def(slot)
		var title : String = str(def.get("title", ""))
		var desc  : String = str(def.get("desc", ""))
		if title.is_empty() and desc.is_empty():
			continue
		pending.append({ "title": title, "desc": desc })
	if pending.is_empty():
		return
	_intro_quest_seq = Node2D.new()
	add_child(_intro_quest_seq)
	_play_intro_quest_sequence(pending, 0)

func _play_intro_quest_sequence(items: Array, idx: int) -> void:
	if not is_instance_valid(_intro_quest_seq):
		return
	if idx >= items.size():
		_intro_quest_seq.queue_free()
		_intro_quest_seq = null
		return
	var it : Dictionary = items[idx]
	_spawn_intro_quest_toast(str(it.get("title", "")), str(it.get("desc", "")), func():
		_play_intro_quest_sequence(items, idx + 1)
	)

# Single bottom-centre toast: slides up from below the viewport, holds 2 s,
# slides back down off-screen, frees itself. `done_cb` fires once the exit
# tween finishes so the caller can chain the next quest banner.
func _spawn_intro_quest_toast(title: String, desc: String, done_cb: Callable) -> void:
	if not is_instance_valid(_intro_quest_seq):
		return
	var vp : Vector2 = get_viewport().get_visible_rect().size
	const TOAST_W : float = 300.0
	const TOAST_H : float = 56.0
	const HOLD    : float = 2.0
	const SLIDE   : float = 0.30
	var target_y  : float = vp.y - TOAST_H - 28.0
	var start_y   : float = vp.y + 20.0
	var x         : float = (vp.x - TOAST_W) * 0.5

	var root := Control.new()
	root.size         = Vector2(TOAST_W, TOAST_H)
	root.position     = Vector2(x, start_y)
	root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_intro_quest_seq.add_child(root)

	var bg := ColorRect.new()
	bg.color    = Color(0.06, 0.08, 0.14, 0.94)
	bg.size     = Vector2(TOAST_W, TOAST_H)
	bg.position = Vector2.ZERO
	root.add_child(bg)

	var stripe := ColorRect.new()
	stripe.color    = Color(0.55, 0.85, 1.0, 0.85)
	stripe.size     = Vector2(TOAST_W, 2.0)
	stripe.position = Vector2.ZERO
	root.add_child(stripe)

	var hdr := Label.new()
	hdr.add_theme_font_override("font", UI_FONT)
	hdr.add_theme_font_size_override("font_size", 11)
	_apply_menu_caption_fx(hdr)
	hdr.text                 = ("ЗАДАНИЕ: %s" % title.to_upper()) if title != "" else "ЗАДАНИЕ"
	hdr.modulate             = Color(0.65, 0.90, 1.0)
	hdr.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	hdr.size                 = Vector2(TOAST_W - 16.0, 18.0)
	hdr.position             = Vector2(8.0, 6.0)
	root.add_child(hdr)

	var ds := Label.new()
	ds.add_theme_font_override("font", UI_FONT)
	ds.add_theme_font_size_override("font_size", 12)
	_apply_menu_caption_fx(ds)
	ds.text                 = desc
	ds.modulate             = Color(0.95, 0.95, 0.85)
	ds.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	ds.size                 = Vector2(TOAST_W - 16.0, 24.0)
	ds.position             = Vector2(8.0, 26.0)
	root.add_child(ds)

	var tw := create_tween()
	tw.tween_property(root, "position:y", target_y, SLIDE)\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.tween_interval(HOLD)
	tw.tween_property(root, "position:y", start_y, SLIDE)\
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tw.tween_callback(func():
		if is_instance_valid(root):
			root.queue_free()
		done_cb.call()
	)

func _show_quest_complete_toast(slot: int, title: String, desc: String) -> void:
	# Drop any previous toast so two completions in quick succession don't
	# stack on top of each other.
	if is_instance_valid(_toast_node):
		_toast_node.queue_free()
	var vp : Vector2 = get_viewport().get_visible_rect().size

	const TOAST_W : float = 320.0
	const TOAST_H : float = 64.0
	const HOLD    : float = 2.0
	const SLIDE   : float = 0.30
	var target_y  : float = vp.y - TOAST_H - 28.0
	var start_y   : float = vp.y + 20.0
	var x         : float = (vp.x - TOAST_W) * 0.5

	var root := Control.new()
	root.size         = Vector2(TOAST_W, TOAST_H)
	root.position     = Vector2(x, start_y)
	root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.process_mode = Node.PROCESS_MODE_ALWAYS   # works while paused too
	root.z_index      = 70
	add_child(root)
	_toast_node = root

	var bg := ColorRect.new()
	bg.color    = Color(0.06, 0.12, 0.06, 0.95)
	bg.size     = Vector2(TOAST_W, TOAST_H)
	bg.position = Vector2.ZERO
	root.add_child(bg)

	var stripe := ColorRect.new()
	stripe.color    = Color(0.45, 0.95, 0.35, 0.90)
	stripe.size     = Vector2(TOAST_W, 2.0)
	stripe.position = Vector2.ZERO
	root.add_child(stripe)

	var header_text : String = "ЗАДАНИЕ ВЫПОЛНЕНО"
	if title.length() > 0:
		header_text = "ВЫПОЛНЕНО: " + title.to_upper()

	var lbl_header := Label.new()
	lbl_header.add_theme_font_override("font", UI_FONT)
	lbl_header.add_theme_font_size_override("font_size", 11)
	_apply_menu_caption_fx(lbl_header)
	lbl_header.text                 = header_text
	lbl_header.modulate             = Color(0.65, 1.0, 0.50)
	lbl_header.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	lbl_header.clip_text            = true
	lbl_header.size                 = Vector2(TOAST_W - 16.0, 18.0)
	lbl_header.position             = Vector2(8.0, 6.0)
	root.add_child(lbl_header)

	var lbl_desc := Label.new()
	lbl_desc.add_theme_font_override("font", UI_FONT)
	lbl_desc.add_theme_font_size_override("font_size", 12)
	_apply_menu_caption_fx(lbl_desc)
	lbl_desc.text                 = desc
	lbl_desc.modulate             = Color(0.95, 0.95, 0.85)
	lbl_desc.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	lbl_desc.clip_text            = true
	lbl_desc.size                 = Vector2(TOAST_W - 16.0, 24.0)
	lbl_desc.position             = Vector2(8.0, 28.0)
	root.add_child(lbl_desc)

	var tw := create_tween()
	tw.tween_property(root, "position:y", target_y, SLIDE)\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.tween_interval(HOLD)
	tw.tween_property(root, "position:y", start_y, SLIDE)\
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tw.tween_callback(func():
		if is_instance_valid(root):
			root.queue_free()
		if _toast_node == root:
			_toast_node = null
	)

# ─── Диалоги: имя и восстановление аккаунта ─────────────────────────────────
# ВЫБОРА АВАТАРА БОЛЬШЕ НЕТ. Аватар показывает АКТИВНЫЙ СКИН — то есть уже
# сделанный выбор, и второй выбор поверх первого превращал картинку в ложь: в
# таблице лидеров стоит одна голова, а бегает другая. Экран выбора вместе с его
# сеткой голов по жирам убран целиком.


func _show_rename_modal() -> void:
	var vp := get_viewport().get_visible_rect().size
	var root := _dialog_root()

	var dim := ColorRect.new()
	dim.color    = Color(0.0, 0.0, 0.0, 0.78)
	dim.size     = vp
	root.add_child(dim)
	var dim_btn := Button.new()
	dim_btn.flat       = true
	dim_btn.focus_mode = Control.FOCUS_NONE
	dim_btn.size       = vp
	dim_btn.pressed.connect(root.queue_free)
	root.add_child(dim_btn)

