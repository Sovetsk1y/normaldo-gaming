func _ready() -> void:
	await get_tree().process_frame
	_btn_sfx = AudioStreamPlayer.new()
	var _btn_stream := load("res://assets/audio/button.mp3") as AudioStreamMP3
	if _btn_stream:
		_btn_stream.loop  = false
		_btn_sfx.stream   = _btn_stream
	_btn_sfx.volume_db   = -2.0
	_btn_sfx.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_btn_sfx)
	_build_ui()
	_build_fps_label()
	var normaldo := get_parent().get_node_or_null("Normaldo")
	if normaldo:
		normaldo.stats_changed.connect(_on_stats_changed)
		normaldo.died.connect(_on_normaldo_died)
		normaldo.dollars_changed.connect(_on_dollars_changed)
		normaldo.wizard_state_changed.connect(_on_wizard_state_changed)
		normaldo.unique_ability_changed.connect(_on_unique_ability_changed)
	var spawner := get_parent().get_node_or_null("Spawner")
	if spawner:
		spawner.boss_time.connect(_on_boss_time)
		spawner.level_cleared.connect(_on_level_cleared)
		spawner.phase_entered.connect(_on_phase_entered)
	QuestManager.quests_updated.connect(_refresh_quest_badges)
	QuestManager.daily_quest_completed.connect(_show_quest_complete_toast)
	# Skin XP changes (level-ups, prestige resets) flip the СКИНЫ badge.
	SaveData.data_changed.connect(_refresh_quest_badges)
	LeaderboardClient.pending_rewards_loaded.connect(_on_pending_rewards_loaded)
	# Notification taps land here; the router queues the deep-link until we're
	# back on the main menu so we don't yank the player out of an active run.
	Notifications.notification_opened.connect(_on_notification_opened)
	# Cold-start: if the native plugin parked a launch payload before the
	# scene was ready, drain it now so the tap fires through the same router
	# that handles warm taps. No-op when the buffer is empty.
	call_deferred("_consume_notification_launch_payload")
	_on_stats_changed(0, 0, 0)
	if HUD._restart_into_run:
		# Tap "ЗАНОВО" on the death screen sets the flag — skip the menu and
		# kick straight into a new run using the same mode the player just
		# finished. Flags are consumed here so subsequent reloads behave
		# normally (e.g. dev hotkeys reaching this code path).
		HUD._restart_into_run = false
		HUD._start_endless    = HUD._restart_endless
		HUD._restart_endless  = false
		call_deferred("_start_game")
	else:
		_show_menu()
		# If we already received pending rewards before the menu was up (race),
		# surface them now.
		call_deferred("_check_pending_rewards_on_menu")

func _build_fps_label() -> void:
	# Отладочный счётчик — только в дев-сборках (DevFlags.ENABLED). В релиз/TF
	# не показывается.
	if not DevFlags.ENABLED:
		return
	_fps_label = Label.new()
	_fps_label.add_theme_font_override("font", UI_FONT)
	_fps_label.add_theme_font_size_override("font_size", 12)
	_fps_label.add_theme_color_override("font_color", Color(0.4, 1.0, 0.4))
	_fps_label.add_theme_color_override("font_outline_color", Color(0, 0, 0))
	_fps_label.add_theme_constant_override("outline_size", 4)
	_fps_label.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
	# offset_top отрицательный — приподнимаем над нижним краем; запас под home-bar.
	_fps_label.offset_left  = 6.0
	_fps_label.offset_top   = -26.0
	_fps_label.z_index      = 100
	_fps_label.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_fps_label)

func _play_btn_sfx() -> void:
	if _btn_sfx and is_instance_valid(_btn_sfx):
		_btn_sfx.stop()
		_btn_sfx.play()

func _make_icon(tex: Texture2D, sz: float) -> TextureRect:
	var r := TextureRect.new()
	r.texture      = tex
	r.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	r.expand_mode  = TextureRect.EXPAND_IGNORE_SIZE
	r.size         = Vector2(sz, sz)
	return r

# ── Аватарка скина ────────────────────────────────────────────────────────────
# Вписывать спрайт скина в квадрат «по кадру» нельзя: у Джокера голова это 27 %
# кадра, остальное — разведённые руки, и в списке скинов его голова выходила
# втрое мельче соседских. Поэтому в коробку сажается ГОЛОВА: она занимает
# UI_HEAD_FILL коробки у любого скина, а руки и посохи уходят за края и
# обрезаются (clip_contents у держателя).
#
# Держатель — Control с обрезкой, внутри TextureRect со спрайтом. Ссылка на
# спрайт лежит в мете «head_rect»: там, где аватарка меняется на лету (кормёжка
# скина, ячейка игрока), меняют именно его.
const UI_HEAD_FILL : float = 0.72

# ПОРТРЕТ — отдельный режим той же аватарки, для крупной картинки в карточке
# скина. Там сверх нормировки головы рисунок ещё и не выпускается за коробку.
#
# Разница не в размере, а в назначении. Иконке 52 px руки и посох можно обрезать:
# от неё требуется, чтобы читалась голова. Портрет в пол-карточки обрезать
# нельзя — срезанное краем тело читается не как кадрирование, а как поломка.
#
# А главное, «голова» в замерах — это САМОЕ КРУПНОЕ СВЯЗНОЕ ПЯТНО спрайта, и
# честной головой оно оказывается не у всех: у Гарри руки и рубашка нарисованы
# отдельными пятнами, и мерится ровно голова, а у Волшебника шляпа с телом
# слиты в одно пятно, и мерится вся фигура. Нормировка по такому «размеру
# головы» ставила рядом Гарри, у которого лицо занимало 0.70 коробки, и
# Волшебника, у которого 0.37, — вдвое. Ограничение по рисунку это выравнивает:
# у обоих коробку занимает фигура целиком, а лица выходят сопоставимыми.
#
# Тот же приём, что у MAX_BODY в забеге, и по той же причине.
const UI_BODY_FILL : float = 0.94

func _skin_head_icon(skin_id: String, fat: int, box: float,
		portrait: bool = false) -> Control:
	var holder := Control.new()
	holder.size               = Vector2(box, box)
	holder.custom_minimum_size = holder.size
	holder.clip_contents      = true
	holder.mouse_filter       = Control.MOUSE_FILTER_IGNORE
	var r := TextureRect.new()
	r.expand_mode  = TextureRect.EXPAND_IGNORE_SIZE
	r.stretch_mode = TextureRect.STRETCH_SCALE
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	holder.add_child(r)
	holder.set_meta("head_rect", r)
	_fit_head_rect(r, _avatar_texture(skin_id, fat), skin_id, fat, box, portrait)
	return holder

# Спрайт внутри держателя — для тех, кто меняет аватарку на лету.
func _head_icon_rect(holder: Control) -> TextureRect:
	if holder == null or not holder.has_meta("head_rect"):
		return null
	return holder.get_meta("head_rect") as TextureRect

# Кладёт текстуру в rect так, чтобы центр головы совпал с центром коробки, а
# ширина головы составила UI_HEAD_FILL от коробки.
func _fit_head_rect(r: TextureRect, tex: Texture2D, skin_id: String, fat: int,
		box: float, portrait: bool = false) -> void:
	if not is_instance_valid(r):
		return
	r.texture = tex
	# Скин и коробку помним на самом спрайте: смена состояния жира при кормёжке
	# должна пересаживать голову по замерам НОВОГО состояния.
	r.set_meta("head_skin", skin_id)
	r.set_meta("head_box",  box)
	r.set_meta("head_fat",  fat)
	r.set_meta("head_portrait", portrait)
	if tex == null:
		return
	var sz : Vector2 = tex.get_size()
	if sz.x <= 0.0:
		return
	var head_px : float = maxf(1.0, sz.x * SkinMetrics.head_frac_for(skin_id))
	var k : float = (box * UI_HEAD_FILL) / head_px
	var used := ItemSizing.content_rect(tex)
	var has_used : bool = used.size.x > 0 and used.size.y > 0
	if portrait and has_used:
		# Второе ограничение портрета: рисунок целиком в коробке. См. UI_BODY_FILL.
		k = minf(k, (box * UI_BODY_FILL)
			/ maxf(float(used.size.x), float(used.size.y)))
	r.size = sz * k
	# Центр головы в долях кадра — центр кадра плюс замеренное смещение.
	var c : Vector2 = Vector2(0.5, 0.5) + SkinMetrics.offset_for(skin_id, fat)
	r.position     = Vector2(box, box) * 0.5 - Vector2(c.x * r.size.x, c.y * r.size.y)
	if portrait and has_used:
		# Голова по-прежнему метит в центр — но если из-за неё за край уходит
		# тело, рисунок подвигается обратно. Центрировать сам рисунок нельзя: у
		# классики в кадре одна голова, и центрирование по рисунку опустило бы
		# её ниже, чем у соседей по ленте.
		var tl : Vector2 = r.position + Vector2(used.position) * k
		var wh : Vector2 = Vector2(used.size) * k
		r.position += Vector2(_pull_in(tl.x, wh.x, box), _pull_in(tl.y, wh.y, box))
	# Вращение при морфе жира должно идти вокруг ГОЛОВЫ, а не вокруг центра
	# кадра, иначе у скинов с руками голова уезжает по дуге за край коробки.
	r.pivot_offset = Vector2(c.x * r.size.x, c.y * r.size.y)

# Насколько подвинуть отрезок [lo, lo+size], чтобы он влез в [0, limit]. Не
# влезающий по размеру центрируется — обрезать его симметрично честнее, чем
# прижать к одному краю.
func _pull_in(lo: float, size: float, limit: float) -> float:
	if size >= limit:
		return (limit - size) * 0.5 - lo
	if lo < 0.0:
		return -lo
	if lo + size > limit:
		return limit - (lo + size)
	return 0.0

# Пересадить уже созданный спрайт на другое состояние жира того же скина.
func _refit_head_rect(r: TextureRect, tex: Texture2D, fat: int) -> void:
	if not is_instance_valid(r) or not r.has_meta("head_skin"):
		if is_instance_valid(r):
			r.texture = tex
		return
	_fit_head_rect(r, tex, String(r.get_meta("head_skin")), fat,
		float(r.get_meta("head_box")), bool(r.get_meta("head_portrait", false)))

# ── ЖИРОБОСС end fly-in targets ───────────────────────────────────────────────
# Screen-space centre of the top-left pizza / dollar counters, so fat_boss.gd can
# fly the mini-game's tallied loot into the real run score at the end.
func fat_boss_pizza_target() -> Vector2:
	if is_instance_valid(_pizza_icon):
		return _pizza_icon.global_position + _pizza_icon.size * 0.5
	return Vector2(120.0, 14.0)

func fat_boss_dollar_target() -> Vector2:
	if is_instance_valid(_dollar_icon):
		return _dollar_icon.global_position + _dollar_icon.size * 0.5
	return Vector2(180.0, 14.0)

func _make_badge_circle() -> Node2D:
	var wrapper := Node2D.new()
	var circle := ColorRect.new()
	circle.color        = Color(1.0, 0.2, 0.2)
	circle.size         = Vector2(BADGE_R * 2.0, BADGE_R * 2.0)
	circle.mouse_filter = Control.MOUSE_FILTER_PASS
	circle.position    = Vector2(-BADGE_R, -BADGE_R)
	wrapper.add_child(circle)
	# Pulsing animation
	wrapper.tree_entered.connect(_start_badge_pulse.bind(wrapper))
	return wrapper

func _make_badge_static() -> Node2D:
	# Badge without animation (for death screen)
	var wrapper := Node2D.new()
	var circle := ColorRect.new()
	circle.color        = Color(1.0, 0.2, 0.2)
	circle.size         = Vector2(BADGE_R * 2.0, BADGE_R * 2.0)
	circle.mouse_filter = Control.MOUSE_FILTER_IGNORE
	circle.position    = Vector2(-BADGE_R, -BADGE_R)
	wrapper.add_child(circle)
	return wrapper

func _start_badge_pulse(wrapper: Node2D) -> void:
	if not is_instance_valid(wrapper):
		return
	var tw := wrapper.create_tween().set_loops()
	tw.tween_property(wrapper, "scale", Vector2(1.2, 1.2), 0.5).from(Vector2.ONE).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tw.tween_property(wrapper, "scale", Vector2.ONE, 0.5).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

func _draw_menu_trophy(pos: Vector2, sz: float, parent: Node) -> void:
	var cup_w  := sz
	var cup_h  := sz * 0.45
	var stem_w := sz * 0.22
	var stem_h := sz * 0.25
	var base_w := sz * 0.85
	var base_h := sz * 0.18
	var gold   := Color(0.92, 0.78, 0.28)
	var shade  := Color(0.65, 0.52, 0.15)

	var cup := ColorRect.new()
	cup.color    = gold
	cup.size     = Vector2(cup_w, cup_h)
	cup.position = pos
	parent.add_child(cup)

	var rim := ColorRect.new()
	rim.color    = shade
	rim.size     = Vector2(cup_w, 2.0)
	rim.position = pos
	parent.add_child(rim)

	var lh := ColorRect.new()
	lh.color    = shade
	lh.size     = Vector2(3.0, cup_h * 0.55)
	lh.position = pos + Vector2(-3.0, cup_h * 0.15)
	parent.add_child(lh)
	var rh := ColorRect.new()
	rh.color    = shade
	rh.size     = Vector2(3.0, cup_h * 0.55)
	rh.position = pos + Vector2(cup_w, cup_h * 0.15)
	parent.add_child(rh)

	var stem_x := pos.x + (cup_w - stem_w) * 0.5
	var stem_y := pos.y + cup_h
	var stem := ColorRect.new()
	stem.color    = shade
	stem.size     = Vector2(stem_w, stem_h)
	stem.position = Vector2(stem_x, stem_y)
	parent.add_child(stem)

	var base_x := pos.x + (cup_w - base_w) * 0.5
	var base_y := stem_y + stem_h
	var base := ColorRect.new()
	base.color    = gold
	base.size     = Vector2(base_w, base_h)
	base.position = Vector2(base_x, base_y)
	parent.add_child(base)

const _CLASSIC_AVATAR_TEX : Array = [
	preload("res://assets/normaldo/normaldo1.png"),
	preload("res://assets/normaldo/normaldo2.png"),
	preload("res://assets/normaldo/normaldo3.png"),
	preload("res://assets/normaldo/normaldo4.png"),
]

func _max_fat_state_for_skin(skin_id: String) -> int:
	var entry = SaveData.skin_progress.get(skin_id, null)
	var lvl  := 1
	if entry != null:
		lvl = int(entry.get("level", 1))
	return SkinProgression.max_fat_state(skin_id, lvl)

func _avatar_texture(skin_id: String, fat_state: int) -> Texture2D:
	var idx := clampi(fat_state, 0, 3)
	var data = SkinRegistry.get_skin(skin_id)
	var tex_dir : String = data.get("tex_dir", "")
	if tex_dir.is_empty():
		return _CLASSIC_AVATAR_TEX[idx]
	var path := "%sstate%d.png" % [tex_dir, idx + 1]
	var tex = load(path)
	if tex == null:
		tex = _CLASSIC_AVATAR_TEX[idx]
	return tex

# Returns the avatar the player has chosen for the player cell.
# Falls back to active skin at its max unlocked fat state.
func _current_avatar() -> Dictionary:
	var skin_id := SaveData.chosen_avatar_skin
	var fat     := SaveData.chosen_avatar_fat
	if skin_id == "" or not SaveData.owns_skin(skin_id):
		skin_id = SaveData.active_skin
	if fat < 0 or fat > _max_fat_state_for_skin(skin_id):
		fat = _max_fat_state_for_skin(skin_id)
	return {"skin_id": skin_id, "fat": fat}

func _draw_gear_icon(parent: Node, pos: Vector2, sz: float, col: Color) -> void:
	# Pixel gear: outer ring made of 8 small teeth around a square hub with hole.
	var c := Vector2(pos.x + sz * 0.5, pos.y + sz * 0.5)
	var hub_sz := sz * 0.58
	var hub := ColorRect.new()
	hub.color    = col
	hub.size     = Vector2(hub_sz, hub_sz)
	hub.position = Vector2(c.x - hub_sz * 0.5, c.y - hub_sz * 0.5)
	parent.add_child(hub)
	var hole_sz := sz * 0.24
	var hole := ColorRect.new()
	hole.color    = Color(0.05, 0.04, 0.02, 1.0)
	hole.size     = Vector2(hole_sz, hole_sz)
	hole.position = Vector2(c.x - hole_sz * 0.5, c.y - hole_sz * 0.5)
	parent.add_child(hole)
	# 8 teeth
	var tooth_sz := sz * 0.20
	var radius   := sz * 0.42
	for i in 8:
		var angle := i * PI / 4.0
		var px := c.x + cos(angle) * radius - tooth_sz * 0.5
		var py := c.y + sin(angle) * radius - tooth_sz * 0.5
		var tooth := ColorRect.new()
		tooth.color    = col
		tooth.size     = Vector2(tooth_sz, tooth_sz)
		tooth.position = Vector2(px, py)
		parent.add_child(tooth)

func _draw_pencil_icon(parent: Node, pos: Vector2, sz: float, col: Color) -> void:
	# Diagonal pencil — body + tip
	var blk := sz / 6.0
	# Body diagonal: cells from (1,1) to (4,4) along the diagonal
	for i in 4:
		var rect := ColorRect.new()
		rect.color    = col
		rect.size     = Vector2(blk * 1.5, blk * 1.5)
		rect.position = pos + Vector2((i + 1) * blk, (4 - i) * blk)
		parent.add_child(rect)
	# Tip — small dark point at top-right
	var tip := ColorRect.new()
	tip.color    = Color(col.r * 0.4, col.g * 0.4, col.b * 0.4)
	tip.size     = Vector2(blk, blk)
	tip.position = pos + Vector2(5 * blk, 0)
	parent.add_child(tip)

func _draw_menu_podium(pos: Vector2, sz: float, parent: Node) -> void:
	# Three pillars: silver(2nd), gold(1st, tallest), bronze(3rd)
	var pillar_w := sz * 0.26
	var gap      := sz * 0.04
	var base_y   := pos.y + sz
	var heights  := [sz * 0.55, sz * 0.80, sz * 0.40]
	var colors   := [
		Color(0.83, 0.85, 0.90),
		Color(0.95, 0.82, 0.30),
		Color(0.78, 0.51, 0.32),
	]
	for i in 3:
		var px := pos.x + i * (pillar_w + gap)
		var ph : float = heights[i]
		var rect := ColorRect.new()
		rect.color    = colors[i]
		rect.size     = Vector2(pillar_w, ph)
		rect.position = Vector2(px, base_y - ph)
		parent.add_child(rect)

func _build_ui() -> void:
	var vp    := get_viewport().get_visible_rect().size
	# Fat panel constants — sized to slot directly under the pause chip on the
	# LEFT side without colliding with the wizard/oneshot panels that live
	# below it on certain skins.
	# Fat panel: two big icons sit ABOVE the progress bar (current at the
	# bar's left edge, next at its right edge), bar runs the full panel
	# width below them. Looks more compact + bar is bigger.
	const FAT_ICON_SZ  : float = 28.0
	const FAT_ICON_PAD : float = 2.0   # horizontal inset of icon from bar edge
	# Полоса выросла с 9 до 16 px: на ней теперь написано СОСТОЯНИЕ СЛОВОМ и
	# остаток до следующего числом. Две иконки без подписи не отвечали ни на
	# один вопрос игрока. См. /Концепция/Интерфейс забега.md
	const FAT_BAR_H    : float = 16.0
	const FAT_ICON_BAR_GAP : float = 2.0
	const FAT_PANEL_PAD: float = 6.0
	const FAT_BLOCK_GAP: float = 4.0   # gap between resources block and fat panel
	# Pause chip lives at the very top-left corner; the resources strip sits
	# alongside it to the right (top edge), and the fat panel + skill gauges
	# stack vertically beneath pause.
	const PAUSE_H      : float = 28.0

	var fat_panel_w : float = FAT_PANEL_PAD * 2 + FAT_ICON_SZ * 2 + 52.0   # icons + место под подпись
	var fat_panel_h : float = FAT_PANEL_PAD * 2 + FAT_ICON_SZ + FAT_ICON_BAR_GAP + FAT_BAR_H

	_left_w = maxf(PAD + 24.0 + 4.0 + 48.0 + PAD, fat_panel_w)

	# Resources strip — runs HORIZONTALLY along the top edge to the right of
	# the pause chip so iOS doesn't bury the counters under the notch / Dynamic
	# Island. Fat panel + unique-ability gauges have moved up under pause to
	# claim the vertical space that used to hold the resources block.
	const RES_STRIP_GAP   : float = 8.0
	const RES_INNER_PAD_X : float = 8.0
	const RES_ITEM_GAP    : float = 10.0
	const RES_ICON_LBL_GAP: float = 4.0
	const RES_PIZZA_ICON  : float = 22.0
	const RES_DLR_ICON    : float = 16.0
	const RES_PIZZA_LBL_W : float = 42.0
	const RES_DOLLAR_LBL_W: float = 52.0
	const RES_TIME_LBL_W  : float = 50.0
	var res_strip_w : float = RES_INNER_PAD_X * 2 \
		+ RES_PIZZA_ICON + RES_ICON_LBL_GAP + RES_PIZZA_LBL_W \
		+ RES_ITEM_GAP \
		+ RES_DLR_ICON + RES_ICON_LBL_GAP + RES_DOLLAR_LBL_W \
		+ RES_ITEM_GAP + RES_TIME_LBL_W

	# Slide-in offset has to span pause + gap + resources so the whole top row
	# starts fully off-screen and arrives together.
	_left_slide_w = _left_w + RES_STRIP_GAP + res_strip_w
	_left_container          = Node2D.new()
	_left_container.position = Vector2(-_left_slide_w - 10.0, 0.0)
	add_child(_left_container)

	# Pause chip — single 28-px-tall row at the top-left corner. Tap pauses
	# the game and opens the pause menu. Lives inside left_container so it
	# rides the slide-in animation with the rest of the HUD.
	_build_pause_btn(Vector2(0.0, 0.0), Vector2(_left_w, PAUSE_H))

	# Resources strip background
	var res_strip_x : float = _left_w + RES_STRIP_GAP
	var res_bg := ColorRect.new()
	res_bg.color    = CLR_BG
	res_bg.size     = Vector2(res_strip_w, PAUSE_H)
	res_bg.position = Vector2(res_strip_x, 0.0)
	_left_container.add_child(res_bg)

	var res_center_y : float = PAUSE_H * 0.5
	var cur_x : float = res_strip_x + RES_INNER_PAD_X

	var picon := _make_icon(PIZZA_TEXTURE, RES_PIZZA_ICON)
	picon.position = Vector2(cur_x, res_center_y - RES_PIZZA_ICON * 0.5)
	_left_container.add_child(picon)
	_pizza_icon = picon
	cur_x += RES_PIZZA_ICON + RES_ICON_LBL_GAP

	_pizza_label = Label.new()
	_pizza_label.add_theme_font_override("font", UI_FONT)
	_pizza_label.add_theme_font_size_override("font_size", 14)
	_pizza_label.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	_pizza_label.size                 = Vector2(RES_PIZZA_LBL_W, PAUSE_H)
	_pizza_label.position             = Vector2(cur_x, 0.0)
	_left_container.add_child(_pizza_label)
	cur_x += RES_PIZZA_LBL_W + RES_ITEM_GAP

	var dicon := _make_icon(DOLLAR_TEXTURE, RES_DLR_ICON)
	dicon.position = Vector2(cur_x, res_center_y - RES_DLR_ICON * 0.5)
	_left_container.add_child(dicon)
	_dollar_icon = dicon
	cur_x += RES_DLR_ICON + RES_ICON_LBL_GAP

	_dollar_label = Label.new()
	_dollar_label.add_theme_font_override("font", UI_FONT)
	_dollar_label.add_theme_font_size_override("font_size", 12)
	_dollar_label.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	_dollar_label.modulate             = Color(1.0, 0.88, 0.35)
	_dollar_label.size                 = Vector2(RES_DOLLAR_LBL_W, PAUSE_H)
	_dollar_label.position             = Vector2(cur_x, 0.0)
	_dollar_label.text                 = "0"
	_left_container.add_child(_dollar_label)
	cur_x += RES_DOLLAR_LBL_W + RES_ITEM_GAP

	_time_label = Label.new()
	_time_label.add_theme_font_override("font", UI_FONT)
	_time_label.add_theme_font_size_override("font_size", 12)
	_time_label.vertical_alignment    = VERTICAL_ALIGNMENT_CENTER
	_time_label.horizontal_alignment  = HORIZONTAL_ALIGNMENT_LEFT
	_time_label.size                  = Vector2(RES_TIME_LBL_W, PAUSE_H)
	_time_label.position              = Vector2(cur_x, 0.0)
	_time_label.text                  = "0:00"
	_left_container.add_child(_time_label)

	# Skill cooldown badges sit under the resources strip, to the right of the
	# fat panel — store the anchor for _build_skill_badges.
	_skill_badge_anchor = Vector2(res_strip_x, PAUSE_H + FAT_BLOCK_GAP + 2.0)

	# ── Fat panel — icons stacked ABOVE the bar. Current state's icon hugs
	# the bar's left edge, next state's icon hugs the right edge. Now lives
	# directly beneath pause (resources moved to the top strip).
	var fat_y : float = PAUSE_H + FAT_BLOCK_GAP
	var fat_panel_x : float = (_left_w - fat_panel_w) * 0.5

	var fat_bg := ColorRect.new()
	fat_bg.color    = CLR_BG
	fat_bg.size     = Vector2(fat_panel_w, fat_panel_h)
	fat_bg.position = Vector2(fat_panel_x, fat_y)
	_left_container.add_child(fat_bg)

	# Bar runs almost the full width of the panel (just panel-pad on each side).
	var bar_w : float = fat_panel_w - FAT_PANEL_PAD * 2
	var bar_x : float = fat_panel_x + FAT_PANEL_PAD
	var bar_y : float = fat_y + FAT_PANEL_PAD + FAT_ICON_SZ + FAT_ICON_BAR_GAP
	_fat_bar_width = bar_w - 2.0

	# Над полосой — ЧЕРЕП и F A T вместо двух копий скина. Скин и так на экране,
	# крупный и в центре; индикатор должен отвечать не «как я выгляжу», а
	# «сколько у меня осталось запаса». См. fat_gauge.gd.
	var icon_y : float = fat_y + FAT_PANEL_PAD
	_fat_gauge = FatGauge.new()
	_fat_gauge.setup(FAT_ICON_SZ)
	var gw : float = _fat_gauge.gauge_size().x
	_fat_gauge.position = Vector2(bar_x + (bar_w - gw) * 0.5, icon_y)
	_left_container.add_child(_fat_gauge)
	_fat_gauge.set_state(0, _max_unlocked_fat(), false)

	var bar_bg : ColorRect = ColorRect.new()
	bar_bg.color    = Color(0.08, 0.08, 0.08, 0.70)
	bar_bg.size     = Vector2(bar_w, FAT_BAR_H)
	bar_bg.position = Vector2(bar_x, bar_y)
	_left_container.add_child(bar_bg)
	_fat_bar_fill          = ColorRect.new()
	_fat_bar_fill.color    = Color(1.0, 0.55, 0.1, 1.0)
	_fat_bar_fill.size     = Vector2(0.0, FAT_BAR_H - 2.0)
	_fat_bar_fill.position = Vector2(bar_x + 1.0, bar_y + 1.0)
	_left_container.add_child(_fat_bar_fill)

	# Подпись ПОВЕРХ полосы: слово состояния слева, остаток до следующего
	# справа. Числа на полосе — общий приём всех экранов игры.
	_fat_name_lbl = Label.new()
	_fat_name_lbl.add_theme_font_override("font", UI_FONT)
	_fat_name_lbl.add_theme_font_size_override("font_size", 10)
	_fat_name_lbl.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.85))
	_fat_name_lbl.add_theme_constant_override("outline_size", 3)
	_fat_name_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	_fat_name_lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	_left_container.add_child(_fat_name_lbl)
	_fat_name_lbl.position = Vector2(bar_x + 5.0, bar_y)
	_fat_name_lbl.size     = Vector2(bar_w - 10.0, FAT_BAR_H)

	_fat_left_lbl = Label.new()
	_fat_left_lbl.add_theme_font_override("font", UI_FONT)
	_fat_left_lbl.add_theme_font_size_override("font_size", 10)
	_fat_left_lbl.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.85))
	_fat_left_lbl.add_theme_constant_override("outline_size", 3)
	_fat_left_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	_fat_left_lbl.vertical_alignment   = VERTICAL_ALIGNMENT_CENTER
	_fat_left_lbl.mouse_filter         = Control.MOUSE_FILTER_IGNORE
	_left_container.add_child(_fat_left_lbl)
	_fat_left_lbl.position = Vector2(bar_x + 5.0, bar_y)
	_fat_left_lbl.size     = Vector2(bar_w - 10.0, FAT_BAR_H)

	# Bottom y of the entire left stack — exposed to the panel helpers so the
	# wizard/oneshot blocks place themselves cleanly below the fat panel.
	_left_stack_bottom_y = fat_y + fat_panel_h


func _build_wizard_gauge(row_h: float) -> void:
	const WIZARD_W   := 130.0
	const LABEL_H    := 11.0
	const BAR_H      := 8.0
	const INNER_GAP  := 2.0
	const INNER_PAD  := 8.0
	const SEP        := 9.0   # gap between resources panel and wizard panel
	const SUFFIX_W   := 16.0
	const SUFFIX_GAP := 3.0

	# Anchor below the fat panel (which sits under the resources block now).
	var y_top : float = _left_stack_bottom_y + SEP if _left_stack_bottom_y > 0.0 else SECTION_H + row_h + 18.0 + SEP

	_wizard_gauge_node          = Node2D.new()
	_wizard_gauge_node.position = Vector2(0.0, y_top)
	_wizard_gauge_node.visible  = false
	_left_container.add_child(_wizard_gauge_node)

	var gauge_bg       := ColorRect.new()
	gauge_bg.color      = CLR_BG
	gauge_bg.size       = Vector2(WIZARD_W, INNER_PAD + LABEL_H + INNER_GAP + BAR_H + INNER_PAD)
	_wizard_gauge_node.add_child(gauge_bg)

	_wizard_bonus_lbl = Label.new()
	_wizard_bonus_lbl.add_theme_font_override("font", UI_FONT)
	_wizard_bonus_lbl.add_theme_font_size_override("font_size", 8)
	_wizard_bonus_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_wizard_bonus_lbl.size     = Vector2(WIZARD_W, LABEL_H)
	_wizard_bonus_lbl.position = Vector2(0.0, INNER_PAD)
	_wizard_bonus_lbl.text     = "КОЛДОВСТВО"
	_wizard_bonus_lbl.modulate = Color(0.70, 0.45, 1.00)
	_wizard_gauge_node.add_child(_wizard_bonus_lbl)

	var bx    := PAD
	var bw    := WIZARD_W - PAD - SUFFIX_W - SUFFIX_GAP - PAD
	var bar_y := INNER_PAD + LABEL_H + INNER_GAP
	_wizard_bar_w = bw

	var bar_bg     := ColorRect.new()
	bar_bg.color    = Color(0.18, 0.10, 0.32, 0.90)
	bar_bg.size     = Vector2(bw, BAR_H)
	bar_bg.position = Vector2(bx, bar_y)
	_wizard_gauge_node.add_child(bar_bg)

	_wizard_bar_fill          = ColorRect.new()
	_wizard_bar_fill.color    = Color(0.65, 0.30, 1.00)
	_wizard_bar_fill.size     = Vector2(0.0, BAR_H)
	_wizard_bar_fill.position = Vector2(bx, bar_y)
	_wizard_gauge_node.add_child(_wizard_bar_fill)

	_wizard_max_lbl = Label.new()
	_wizard_max_lbl.add_theme_font_override("font", UI_FONT)
	_wizard_max_lbl.add_theme_font_size_override("font_size", 8)
	_wizard_max_lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	_wizard_max_lbl.size     = Vector2(SUFFIX_W, BAR_H)
	_wizard_max_lbl.position = Vector2(bx + bw + SUFFIX_GAP, bar_y - 7)
	_wizard_max_lbl.text     = "50"
	_wizard_max_lbl.modulate = Color(0.70, 0.45, 1.00, 0.80)
	_wizard_gauge_node.add_child(_wizard_max_lbl)

func _on_wizard_state_changed(pizzas_done: int, bonus_active: bool, bonus_type: int, bonus_remaining: float) -> void:
	if not is_instance_valid(_wizard_bar_fill):
		return
	_wizard_gauge_node.visible = true

	if bonus_active:
		var fill_ratio := clampf(bonus_remaining / 5.0, 0.0, 1.0)
		_wizard_bar_fill.size.x = _wizard_bar_w * fill_ratio
		var col: Color
		var name_str: String
		match bonus_type:
			0: col = Color(0.30, 0.85, 1.00); name_str = "МАГНИТ"
			1: col = Color(0.75, 0.50, 1.00); name_str = "×2 XP"
			2: col = Color(1.00, 0.75, 0.20); name_str = "УСКОРЕНИЕ"
			_: col = Color(0.70, 0.40, 1.00); name_str = "БОНУС"
		_wizard_bar_fill.color        = col
		_wizard_bonus_lbl.text        = "%s %.1fs" % [name_str, bonus_remaining]
		_wizard_bonus_lbl.modulate    = col
		if is_instance_valid(_wizard_max_lbl):
			_wizard_max_lbl.visible = false
		if not _wizard_bonus_show:
			_wizard_bonus_show = true
			if _wizard_pulse_tw and _wizard_pulse_tw.is_valid():
				_wizard_pulse_tw.kill()
			_wizard_pulse_tw = create_tween().set_loops()
			_wizard_pulse_tw.tween_property(_wizard_bar_fill, "modulate:a", 0.45, 0.38).set_ease(Tween.EASE_IN_OUT)
			_wizard_pulse_tw.tween_property(_wizard_bar_fill, "modulate:a", 1.00, 0.38).set_ease(Tween.EASE_IN_OUT)
	else:
		if _wizard_bonus_show:
			_wizard_bonus_show = false
			if _wizard_pulse_tw and _wizard_pulse_tw.is_valid():
				_wizard_pulse_tw.kill()
				_wizard_pulse_tw = null
			_wizard_bar_fill.modulate = Color.WHITE
		_wizard_bar_fill.color  = Color(0.65, 0.30, 1.00)
		_wizard_bar_fill.size.x = _wizard_bar_w * (float(pizzas_done) / 50.0)
		_wizard_bonus_lbl.text     = "КОЛДОВСТВО"
		_wizard_bonus_lbl.modulate = Color(0.70, 0.45, 1.00)
		if is_instance_valid(_wizard_max_lbl):
			_wizard_max_lbl.visible = true

func _build_oneshot_panel(row_h: float) -> void:
	const PANEL_W := 130.0
	const STAR_SZ := 22.0
	const PANEL_H := 26.0
	const SEP     := 9.0

	# Anchor below the fat panel (which sits under the resources block now).
	var y_top : float = _left_stack_bottom_y + SEP if _left_stack_bottom_y > 0.0 else SECTION_H + row_h + 18.0 + SEP

	_oneshot_panel          = Node2D.new()
	_oneshot_panel.position = Vector2(0.0, y_top)
	_oneshot_panel.visible  = false
	_left_container.add_child(_oneshot_panel)

	_oneshot_star_sz  = STAR_SZ
	_oneshot_panel_h  = PANEL_H

	_oneshot_bg        = ColorRect.new()
	_oneshot_bg.color  = CLR_BG
	_oneshot_bg.size   = Vector2(PANEL_W, PANEL_H)
	_oneshot_panel.add_child(_oneshot_bg)

	var skin_data := SkinRegistry.get_skin(SaveData.active_skin)
	var rarity    := skin_data.get("rarity", 0) as int
	var rc        := SkinRegistry.RARITY_COLORS[rarity] as Color

	var star_bg       := ColorRect.new()
	star_bg.color      = Color(rc.r * 0.20, rc.g * 0.20, rc.b * 0.20, 0.95)
	star_bg.size       = Vector2(STAR_SZ, PANEL_H)
