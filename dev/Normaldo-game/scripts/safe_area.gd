extends Node

# ── ОСТРОВОК, ЧЁЛКА И ПОЛОСКА «ДОМОЙ» ────────────────────────────────────────
# На айфонах с Dynamic Island часть экрана занята железом. В АЛЬБОМНОЙ
# ориентации — а игра только альбомная — островок уезжает на БОКОВОЙ край, левый
# или правый, смотря как игрок держит телефон (`window/handheld/orientation=4`,
# то есть поворот разрешён в обе стороны). Снизу к этому добавляется полоска
# «домой».
#
# ── ПОЧЕМУ НЕ СЛОЙ ЦЕЛИКОМ ───────────────────────────────────────────────────
# Сначала отступ брался СЛОЕМ: весь интерфейс ужимался в безопасный
# прямоугольник — одной строкой на экран, без правки семидесяти мест разметки.
# Работало, но платила за это ВСЯ игра: каждый экран уезжал на 7 % мельче и
# съезжал вправо-вверх, включая те, где островку закрывать нечего. Кнопка паузы
# отъезжала от угла, хотя островок к ней и близко не подходит.
#
# Потому что система отдаёт не островок, а ОТСТУП ПО ВСЕМУ КРАЮ: «слева 59
# точек небезопасны». Но небезопасны они не целиком — железо занимает пятно
# ПОСЕРЕДИНЕ этого края, а сверху и снизу от него полоса свободна, и в игровом
# режиме, где строки состояния нет вовсе, там прекрасно живут и чип паузы, и жир.
#
# Поэтому теперь отступ не берёт никто. Вместо этого здесь считается САМО ПЯТНО
# (`island()`), а разметка спрашивает про него только там, где содержимое
# доходит до края и островок его действительно закрывает, — списки во всю высоту
# экрана, ленты карточек. Всё остальное стоит как стояло.
#
# ── ОТКУДА ВЗЯЛАСЬ ВЫСОТА ПЯТНА ──────────────────────────────────────────────
# Ширину пятна система сообщает сама — это и есть отступ. Высоту не сообщает
# никто: `get_display_cutouts()` на iOS пуст. Она посчитана по железу: островок
# 125 × 37 точек, в альбомной ориентации он встаёт стоймя посередине короткого
# края, а экран в этой ориентации 393 точки высотой. 125 / 393 ≈ 0.32; с запасом
# на скруглённые углы корпуса берётся чуть больше.
#
# ── ЧТО ОСТАЁТСЯ ВО ВЕСЬ ЭКРАН ───────────────────────────────────────────────
# Мир — фон, предметы, сам Нормальдо — и раньше не ужимался, и сейчас не
# ужимается: полосы обязаны доходить до краёв экрана, иначе по бокам появятся
# пустые поля, а предметы будут «влетать из ниоткуда».

signal changed

# Тот же размер, что в project.godot → display/window/size. Держать копию здесь
# приходится потому, что считать нужно ДО того, как появится вьюпорт.
const CANVAS : Vector2 = Vector2(960.0, 430.0)

var _safe   : Rect2 = Rect2(Vector2.ZERO, CANVAS)

# ── ДЕВ-ПОДМЕНА ──────────────────────────────────────────────────────────────
# Островок есть только на устройстве, а разметку правят на настольной машине.
# Без подмены проверка выглядит как «собери, залей в TestFlight, посмотри» —
# и так проверяют один раз, а потом перестают.
var _sim    : Vector4 = Vector4.ZERO
var _sim_on : bool    = false

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	get_tree().root.size_changed.connect(_recompute)
	_recompute()

# Безопасный прямоугольник в координатах холста.
func rect() -> Rect2:
	return _safe

# Отступы словами: слева, сверху, справа, снизу. Ими удобно и читать, и писать
# тесты — «сколько отъело» понятнее, чем «где теперь угол».
func insets() -> Vector4:
	return Vector4(
		_safe.position.x, _safe.position.y,
		CANVAS.x - _safe.end.x, CANVAS.y - _safe.end.y)

func is_simulated() -> bool:
	return _sim_on

# ── САМО ПЯТНО ЖЕЛЕЗА ───────────────────────────────────────────────────────
# Прямоугольник, который островок закрывает, в координатах холста. Пустой, если
# выреза нет.
#
# Ширина — отступ, как его сообщила система (он шире самого островка, и это
# запас, а не ошибка). Высота — доля холста: см. заглавный комментарий.
const ISLAND_H_FRAC : float = 0.38

func island() -> Rect2:
	var ins := insets()
	var w : float = maxf(ins.x, ins.z)
	if w <= 0.0:
		return Rect2()
	var h := CANVAS.y * ISLAND_H_FRAC
	var x : float = 0.0 if ins.x >= ins.z else CANVAS.x - w
	return Rect2(x, (CANVAS.y - h) * 0.5, w, h)

# Закрывает ли островок этот кусок разметки.
func covers(r: Rect2) -> bool:
	var isl := island()
	return isl.size.x > 0.0 and isl.intersects(r)

# ── ГДЕ НАЧИНАТЬ СОДЕРЖИМОЕ ВО ВСЮ ВЫСОТУ ───────────────────────────────────
# Список, лента карточек, панель от края до края — всё, что тянется по высоте
# экрана, островок пересекает заведомо. Такому содержимому нужен не «отступ
# вообще», а левый край правее пятна (или правый — левее).
#
# `want` — тот край, который разметка поставила бы сама. Если островка нет или
# он и так не мешает, возвращается ровно он: на телефоне без выреза и на
# настольной машине разметка не меняется ни на пиксель.
func content_left(want: float) -> float:
	var isl := island()
	if isl.size.x <= 0.0 or isl.position.x > 0.0:
		return want
	return maxf(want, isl.end.x)

# Полоса для содержимого целиком: было [x0, x1] — стало столько же, но мимо
# островка. Так удобнее всего править разметку, которая считает «поля слева и
# справа»: полей становится два разных, а ширина между ними — честная.
func band(x0: float, x1: float) -> Vector2:
	return Vector2(content_left(x0), content_right(x1))

# Панель, ужатая С ТОГО КРАЯ, ГДЕ ОСТРОВОК. Противоположный край остаётся на
# месте: двигать надо то, что закрыто, а не всю разметку следом за ним.
#
# Если островка нет — возвращается ровно то, что дали.
func clear_rect(r: Rect2) -> Rect2:
	var l  := content_left(r.position.x)
	var rr := content_right(r.end.x)
	return Rect2(Vector2(l, r.position.y), Vector2(maxf(0.0, rr - l), r.size.y))

func content_right(want: float) -> float:
	var isl := island()
	if isl.size.x <= 0.0 or isl.position.x <= 0.0:
		return want
	return minf(want, isl.position.x)

# Преобразование слоя: во что превращается точка холста в слое интерфейса.
# Сейчас это тождество — слои не двигаются, — и функция осталась ради тех, кто
# целится в интерфейс из другого слоя (`splash`): пусть у них будет один
# источник правды, а не догадка «наверное, теперь один в один».
func layer_transform() -> Transform2D:
	return Transform2D.IDENTITY

# ── Дев ──────────────────────────────────────────────────────────────────────
# Подменить отступы вручную: слева, сверху, справа, снизу — в пикселях холста.
# Нулевой вектор возвращает настоящие.
func simulate(inset: Vector4) -> void:
	_sim    = inset
	_sim_on = inset != Vector4.ZERO
	_recompute()

# ── Внутреннее ───────────────────────────────────────────────────────────────

func _recompute() -> void:
	var r := _measure()
	if r.position.is_equal_approx(_safe.position) \
			and r.size.is_equal_approx(_safe.size):
		return
	_safe = r
	changed.emit()

# Безопасная область приходит от системы В ПИКСЕЛЯХ ЭКРАНА, а разметка живёт в
# координатах холста; между ними стоит растяжение canvas_items с полями по
# краям. Переводит одно в другое сам вьюпорт — его же преобразованием, а не
# нашей арифметикой: считать растяжение второй раз значило бы разойтись с ним
# при первой же смене режима.
func _measure() -> Rect2:
	var full := Rect2(Vector2.ZERO, CANVAS)
	if _sim_on:
		return Rect2(Vector2(_sim.x, _sim.y),
			CANVAS - Vector2(_sim.x + _sim.z, _sim.y + _sim.w))
	# Ни окна, ни дерева — настольная сборка, headless, момент до запуска.
	# Везде это значит «резать нечего».
	var tree := get_tree()
	if tree == null or tree.root == null:
		return full
	var win := Vector2(DisplayServer.window_get_size())
	if win.x <= 0.0 or win.y <= 0.0:
		return full
	var safe := Rect2(DisplayServer.get_display_safe_area())
	if safe.size.x <= 0.0 or safe.size.y <= 0.0:
		return full
	var inv := (tree.root as Viewport).get_screen_transform().affine_inverse()
	var a : Vector2 = inv * safe.position
	var b : Vector2 = inv * (safe.position + safe.size)
	var r := Rect2(a, b - a).intersection(full)
	# Вырожденное пересечение — значит, мы неверно поняли, что нам дали. Лучше
	# отдать весь экран, чем схлопнуть интерфейс в точку.
	if r.size.x < CANVAS.x * 0.5 or r.size.y < CANVAS.y * 0.5:
		return full
	return r
