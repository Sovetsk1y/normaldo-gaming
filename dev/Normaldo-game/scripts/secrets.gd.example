extends RefCounted

# Copy to scripts/secrets.gd and fill in. Without it analytics.gd no-ops, so
# dev builds and fresh clones run fine without any GA4 setup.
#
# GA4 Admin → Data Streams → (your stream): the measurement id sits at the top
# of the stream page, the API secret under "Measurement Protocol API secrets".

const GA4_MEASUREMENT_ID := ""
const GA4_API_SECRET     := ""
